@page "/logs/moderation/banlogs"
@using AGC_Management.Utils
@attribute [Authorize(Policy = DashboardPolicies.SupportUp)]

<PageHeader Title="Banns" Lead="Über den Bot ausgesprochene Banns, neueste zuerst."
            BackHref="/logs" BackText="Logging"/>

@if (!loaded)
{
    <StateBlock Kind="StateBlock.StateKind.Loading"
                Title="Bann-Log wird geladen"
                Description="Einträge und Namen der Beteiligten werden abgefragt."/>
}
else if (logs.Count == 0)
{
    <StateBlock Title="Noch keine Banns protokolliert"
                Description="Hier erscheinen Einträge, sobald über den Bot ein Bann ausgesprochen wird."/>
}
else
{
    <Panel Flush="true">
        <div class="table-wrap">
            <table class="table">
                <thead>
                <tr>
                    <th>Nutzer</th>
                    <th>Moderator</th>
                    <th>Grund</th>
                    <th>Zeitpunkt</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var log in PageItems)
                {
                    <tr>
                        <td>
                            <div>@log.UserName</div>
                            <CopyId Value="@(log.UserId.ToString())"/>
                        </td>
                        <td>
                            <div>@log.ExecutorName</div>
                            <CopyId Value="@(log.ExecutorId.ToString())"/>
                        </td>
                        <td>@log.Reason</td>
                        <td class="tnum text-nowrap">@Converter.GetDateFromTimestamp(log.UnixTime)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </Panel>

    <Pager Current="currentPage" CurrentChanged="p => currentPage = p" TotalPages="TotalPages" TotalItems="logs.Count"/>
}

@code {
    private bool loaded;
    private const int PageSize = 25;
    private int currentPage = 1;
    private readonly List<BanLogItem> logs = new();

    private IEnumerable<BanLogItem> PageItems => logs.Skip((currentPage - 1) * PageSize).Take(PageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(logs.Count / (double)PageSize));

    protected override async Task OnInitializedAsync()
    {
        await LoadLogs();
        loaded = true;
    }

    private async Task LoadLogs()
    {
        var connection = CurrentApplication.ServiceProvider.GetRequiredService<NpgsqlDataSource>();
        await using (var command = connection.CreateCommand(
                         "SELECT userid, executorid, reason, timestamp FROM banlogs ORDER BY timestamp DESC"))
        await using (var reader = await command.ExecuteReaderAsync())
        {
            while (await reader.ReadAsync())
                logs.Add(new BanLogItem
                {
                    UserId = (ulong)reader.GetInt64(0),
                    ExecutorId = (ulong)reader.GetInt64(1),
                    Reason = reader.IsDBNull(2) ? "Kein Grund angegeben" : reader.GetString(2),
                    UnixTime = reader.GetInt64(3)
                });
        }

        // Resolved once per load. The old page did a blocking lookup per cell, on every render.
        var names = new Dictionary<(ulong, bool), string>();
        foreach (var log in logs)
        {
            log.UserName = await NameAsync(names, log.UserId, false);
            log.ExecutorName = await NameAsync(names, log.ExecutorId, true);
        }
    }

    private static async Task<string> NameAsync(Dictionary<(ulong, bool), string> names, ulong id, bool fetch)
    {
        if (names.TryGetValue((id, fetch), out var name)) return name;

        name = await ToolSet.ResolveUserNameAsync(id, fetch);
        names[(id, fetch)] = name;
        return name;
    }

    private sealed class BanLogItem
    {
        public ulong UserId { get; init; }
        public ulong ExecutorId { get; init; }
        public string Reason { get; init; } = "";
        public long UnixTime { get; init; }
        public string UserName { get; set; } = "";
        public string ExecutorName { get; set; } = "";
    }
}
