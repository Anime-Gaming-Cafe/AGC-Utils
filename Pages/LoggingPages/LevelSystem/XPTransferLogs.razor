@page "/logs/levelsystem/xptransferlogs"
@using AGC_Management.Utils
@attribute [Authorize(Roles = "BotOwner, Administrator, HeadModerator")]

<PageHeader Title="XP-Transfers" Lead="Manuelle Übertragungen von XP zwischen Nutzern, neueste zuerst."
            BackHref="/logs" BackText="Logging"/>

@if (!loaded)
{
    <StateBlock Kind="StateBlock.StateKind.Loading"
                Title="Transfer-Log wird geladen"
                Description="Übertragungen und die Namen der Beteiligten werden abgefragt."/>
}
else if (logs.Count == 0)
{
    <StateBlock Title="Noch keine XP-Transfers protokolliert"
                Description="Hier erscheinen Einträge, sobald ein Teammitglied XP von einem Nutzer auf einen anderen überträgt."/>
}
else
{
    <Panel Flush="true">
        <div class="table-wrap">
            <table class="table">
                <thead>
                <tr>
                    <th>Von</th>
                    <th>An</th>
                    <th>Ausgeführt von</th>
                    <th class="text-end">Menge</th>
                    <th>Zeitpunkt</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var log in PageItems)
                {
                    <tr>
                        <td>
                            <div>@log.FromName</div>
                            <CopyId Value="@(log.FromUserId.ToString())"/>
                        </td>
                        <td>
                            <div>@log.ToName</div>
                            <CopyId Value="@(log.ToUserId.ToString())"/>
                        </td>
                        <td>
                            <div>@log.ExecutorName</div>
                            <CopyId Value="@(log.ExecutorId.ToString())"/>
                        </td>
                        <td class="tnum text-end">@log.Amount XP</td>
                        <td class="tnum text-nowrap">@Converter.GetDateFromTimestamp(log.UnixTime)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </Panel>

    <Pager Current="currentPage" CurrentChanged="p => currentPage = p" TotalPages="TotalPages" TotalItems="logs.Count"/>
}

@code {
    private bool loaded;
    private const int PageSize = 25;
    private int currentPage = 1;
    private readonly List<XpTransferLogItem> logs = new();

    private IEnumerable<XpTransferLogItem> PageItems => logs.Skip((currentPage - 1) * PageSize).Take(PageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(logs.Count / (double)PageSize));

    protected override async Task OnInitializedAsync()
    {
        await LoadLogs();
        loaded = true;
    }

    private async Task LoadLogs()
    {
        var connection = CurrentApplication.ServiceProvider.GetRequiredService<NpgsqlDataSource>();
        await using (var command = connection.CreateCommand(
                         "SELECT sourceuserid, destinationuserid, executorid, amount, timestamp FROM xptransferlogs ORDER BY timestamp DESC"))
        await using (var reader = await command.ExecuteReaderAsync())
        {
            while (await reader.ReadAsync())
                logs.Add(new XpTransferLogItem
                {
                    FromUserId = (ulong)reader.GetInt64(0),
                    ToUserId = (ulong)reader.GetInt64(1),
                    ExecutorId = (ulong)reader.GetInt64(2),
                    Amount = reader.GetInt32(3),
                    UnixTime = reader.GetInt64(4)
                });
        }

        // Resolved once per load. The old page did a blocking lookup per cell and additionally forced a
        // re-render after every render, which kept the circuit busy for as long as the page was open.
        var names = new Dictionary<(ulong, bool), string>();
        foreach (var log in logs)
        {
            log.FromName = await NameAsync(names, log.FromUserId, false);
            log.ToName = await NameAsync(names, log.ToUserId, false);
            log.ExecutorName = await NameAsync(names, log.ExecutorId, true);
        }
    }

    private static async Task<string> NameAsync(Dictionary<(ulong, bool), string> names, ulong id, bool fetch)
    {
        if (names.TryGetValue((id, fetch), out var name)) return name;

        name = await ToolSet.ResolveUserNameAsync(id, fetch);
        names[(id, fetch)] = name;
        return name;
    }

    private sealed class XpTransferLogItem
    {
        public ulong FromUserId { get; init; }
        public ulong ToUserId { get; init; }
        public ulong ExecutorId { get; init; }
        public int Amount { get; init; }
        public long UnixTime { get; init; }
        public string FromName { get; set; } = "";
        public string ToName { get; set; } = "";
        public string ExecutorName { get; set; } = "";
    }
}
