@page "/bot"
@attribute [Authorize(Policy = DashboardPolicies.AnyStaff)]

<PageHeader Title="Botinformationen">
    <Actions>
        @if (ready)
        {
            <button type="button" class="btn btn-secondary" @onclick="Measure">
                <AppIcon Name="refresh"/> Neu messen
            </button>
        }
    </Actions>
</PageHeader>

@if (!ready)
{
    <StateBlock Kind="StateBlock.StateKind.Loading"
                Title="Status wird gemessen"
                Description="Websocket-Latenz, Datenbank und Laufzeitumgebung werden abgefragt."/>
}
else if (failed)
{
    <StateBlock Kind="StateBlock.StateKind.Error"
                Title="Status nicht vollständig abrufbar"
                Description="Mindestens eine Messung ist fehlgeschlagen, meistens die Datenbank. Details stehen im Log."
                ActionText="Erneut messen"
                OnAction="Measure"/>
}
else
{
    <div class="panel-grid">
        <Panel Title="Bot">
            <dl class="facts">
                <dt>Websocket</dt>
                <dd class="tnum">@ping</dd>
                <dt>Nutzer im Cache</dt>
                <dd class="tnum">@cachedUsers</dd>
                <dt>Bot-Nutzer</dt>
                <dd>@botUser</dd>
                <dt>Version</dt>
                <dd class="mono">@CurrentApplication.VersionString</dd>
                <dt>Arbeitsspeicher</dt>
                <dd class="tnum">@ramUsage</dd>
            </dl>
        </Panel>

        <Panel Title="Datenbank">
            <dl class="facts">
                <dt>Einfache Abfrage</dt>
                <dd class="tnum">@dbPing</dd>
                <dt>Aufwendige Abfrage</dt>
                <dd class="tnum">@dbPingExpensive</dd>
                <dt>Nutzer</dt>
                <dd class="mono">@dbUser</dd>
                <dt>Version</dt>
                <dd>@dbVersion</dd>
            </dl>
        </Panel>

        <Panel Title="Anwendung">
            <dl class="facts">
                <dt>Zielserver</dt>
                <dd>@targetServer</dd>
                <dt>Modus</dt>
                <dd>@mode</dd>
                <dt>Discord-Bibliothek</dt>
                <dd>@libVersion</dd>
                <dt>.NET</dt>
                <dd class="tnum">@Environment.Version</dd>
                <dt>Betriebssystem</dt>
                <dd>@osVersion</dd>
            </dl>
        </Panel>

        @* The server list used to hide in a hover popup driven by inline JavaScript. *@
        <Panel Title="@($"Server ({serverList.Count})")" Flush="true">
            <ul class="rows">
                @foreach (var server in serverList)
                {
                    <li><span>@server</span></li>
                }
            </ul>
        </Panel>
    </div>
}

@code {
    private bool ready;
    private bool failed;

    private string ping = "";
    private string dbPing = "";
    private string dbPingExpensive = "";
    private string dbVersion = "";
    private string dbUser = "";
    private string cachedUsers = "";
    private string mode = "";
    private string libVersion = "";
    private string osVersion = "";
    private string ramUsage = "";
    private string targetServer = "";
    private string botUser = "";

    private readonly List<string> serverList = new();

    protected override Task OnInitializedAsync() => Measure();

    private async Task Measure()
    {
        ready = false;
        failed = false;

        try
        {
            await UpdateValues();
        }
        catch (Exception e)
        {
            CurrentApplication.Logger.Error(e, "Botinformationen konnten nicht vollständig abgefragt werden");
            failed = true;
        }

        ready = true;
    }

    private static string GetMode()
    {
#if DEBUG
        return "Entwicklung";
#else
        return "Produktion";
#endif
    }

    private async Task UpdateValues()
    {
        var client = CurrentApplication.DiscordClient;
        var con = CurrentApplication.ServiceProvider.GetRequiredService<NpgsqlDataSource>();

        ping = client.Ping + " ms";
        dbPing = await MeasureQueryAsync(con, "SELECT 1") + " ms";
        dbPingExpensive = await MeasureQueryAsync(con, "SELECT COUNT(*) FROM flags") + " ms";

        await using (var cmd = con.CreateCommand("SELECT current_user;"))
        {
            dbUser = (await cmd.ExecuteScalarAsync())?.ToString() ?? "";
        }

        await using (var cmd = con.CreateCommand("SELECT version();"))
        {
            // "PostgreSQL 16.2 on x86_64-pc-linux-gnu, compiled by ..." - the tail is noise here.
            dbVersion = ((await cmd.ExecuteScalarAsync())?.ToString() ?? "").Split(" on ")[0];
        }

        cachedUsers = client.UserCache.Count.ToString();
        mode = GetMode();
        botUser = client.CurrentUser.UsernameWithDiscriminator;
        libVersion = client.BotLibrary + " " + client.VersionString.Split("+")[0];
        osVersion = Environment.OSVersion.ToString();
        ramUsage = GC.GetTotalMemory(false) / 1024 / 1024 + " MB";
        targetServer = $"{CurrentApplication.TargetGuild.Name} ({CurrentApplication.TargetGuild.Id})";

        serverList.Clear();
        serverList.AddRange(client.Guilds.Values.Select(g => g.Name).OrderBy(n => n));
    }

    private static async Task<long> MeasureQueryAsync(NpgsqlDataSource con, string sql)
    {
        var watch = System.Diagnostics.Stopwatch.StartNew();
        await using var cmd = con.CreateCommand(sql);
        await cmd.ExecuteScalarAsync();
        return watch.ElapsedMilliseconds;
    }
}
