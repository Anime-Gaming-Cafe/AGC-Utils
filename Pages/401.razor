@page "/401"
@inject NavigationManager NavigationManager

<PageTitle>Anmeldung erforderlich</PageTitle>

<StateBlock Title="Anmeldung erforderlich"
            Description="Diese Seite ist nur für angemeldete Mitglieder des Servers sichtbar."
            ActionText="Mit Discord anmelden"
            ActionHref="@oauthLoginUrl"
            ActionTargetsServer="true"/>

@code {

    private string oauthLoginUrl = "/login";

    protected override void OnInitialized()
    {
        var scheme = NavigationManager.Uri.StartsWith("https") ? "https" : "http";
        var returnUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);

        if (returnUrl.Contains("401?returnUrl="))
        {
            returnUrl = returnUrl.Split(new[] { "401?returnUrl=" }, StringSplitOptions.None).LastOrDefault();
        }

        returnUrl = string.IsNullOrWhiteSpace(returnUrl) ? "/" : returnUrl;
        var dashboardUrl = BotConfig.GetConfig()["WebUI"]["DashboardURL"];
        oauthLoginUrl = $"{scheme}://{dashboardUrl}/login?returnUrl=/{Uri.EscapeDataString(returnUrl)}";
    }

}
