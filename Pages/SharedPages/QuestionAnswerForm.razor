@using AGC_Management.Services
@* Reused by TeamApplyForm (real submission) and the admin preview, so the two can never drift
   apart. Renders top-level questions in order; a question's follow-ups render directly under it
   (QuestionAnswerField, indented), regardless of where their own sort_order falls in the set -
   they belong to the question above them, not to their position in the flat list. *@

<div class="question-list">
    @foreach (var answer in TopLevelAnswers)
    {
        @if (QuestionConditionalLogic.IsVisible(answer, Answers))
        {
            <QuestionAnswerField Answer="answer" OnChanged="StateHasChanged"/>

            @foreach (var followUp in FollowUpsOf(answer))
            {
                @if (QuestionConditionalLogic.IsVisible(followUp, Answers))
                {
                    <QuestionAnswerField Answer="followUp" Nested="true" OnChanged="StateHasChanged"/>
                }
            }
        }
    }
</div>

@code {
    [Parameter] [EditorRequired] public List<QuestionAnswerVm> Answers { get; set; } = new();

    private IEnumerable<QuestionAnswerVm> TopLevelAnswers =>
        Answers.Where(a => string.IsNullOrEmpty(a.Question.ConditionQuestionId));

    private IEnumerable<QuestionAnswerVm> FollowUpsOf(QuestionAnswerVm trigger) =>
        Answers.Where(a => a.Question.ConditionQuestionId == trigger.Question.QuestionId);

    // Called by the parent (via @ref) right before submit. Hidden (conditionally-invisible)
    // answers are never required - they're cleared instead of validated, since the applicant
    // never had a chance to see or fill them in.
    public bool ValidateAll()
    {
        var allValid = true;
        foreach (var answer in Answers)
        {
            if (!QuestionConditionalLogic.IsVisible(answer, Answers))
            {
                answer.Error = null;
                continue;
            }

            answer.Error = TeamApplicationService.ValidateAnswer(answer.Question, answer.Text, answer.Selected);
            if (answer.Error != null) allValid = false;
        }

        return allValid;
    }
}
