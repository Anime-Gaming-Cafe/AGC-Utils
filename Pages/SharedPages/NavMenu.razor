@using AGC_Management.Controller
@implements IDisposable
@inject UserService usrSvc
@inject NavigationManager Nav

@* One level, at most six entries: that is a top bar, not a sidebar. Deeper navigation lives on the hubs. *@
<header class="topbar">
    <div class="topbar__inner">
        <a class="topbar__brand" href="">@(CurrentApplication.TargetGuild?.NameWithRemovedRegionSuffix() ?? "Dashboard")</a>

        <nav id="topnav" class="topnav @(open ? "is-open" : null)" aria-label="Hauptnavigation">
            <ul class="topnav__list" @onclick="Close">
                <li><NavLink href="" Match="NavLinkMatch.All">Start</NavLink></li>
                <AuthorizeView Policy="@DashboardPolicies.AnyMember">
                    <li><NavLink href="leaderboard">Leaderboard</NavLink></li>
                </AuthorizeView>
                <AuthorizeView Policy="@DashboardPolicies.AnyStaff">
                    <li class="topnav__sep" aria-hidden="true"></li>
                    <li class="topnav__group">Team</li>
                    <li><NavLink href="teamarea">Teambereich</NavLink></li>
                    <li><NavLink href="bot">Botinformationen</NavLink></li>
                    <li><NavLink href="logs">Logging</NavLink></li>
                </AuthorizeView>
                <AuthorizeView Policy="@DashboardPolicies.AdminOnly">
                    <li><NavLink href="konfiguration">Administration</NavLink></li>
                </AuthorizeView>
            </ul>
        </nav>

        <div class="topbar__end">
            <AuthorizeView>
                <Authorized>
                    <div class="dropdown">
                        <button type="button" class="topbar__user" data-bs-toggle="dropdown" aria-expanded="false">
                            @if (user is not null)
                            {
                                <img src="@user.AvatarUrl" class="avatar" alt=""/>
                                <span class="topbar__user-name">@user.Username</span>
                            }
                            else
                            {
                                <span class="topbar__user-name">Konto</span>
                            }
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            @if (user is not null)
                            {
                                <li><h6 class="dropdown-header">@user.UsernameWithDiscriminator</h6></li>
                                <li><span class="dropdown-item-text meta mono">@user.Id</span></li>
                                <li><hr class="dropdown-divider"></li>
                            }
                            @* Personal destinations sit with the account, not in the main navigation. *@
                            <AuthorizeView Policy="@DashboardPolicies.AnyMember"
                                           Context="memberContext">
                                <li><a class="dropdown-item" href="/apply/status">Meine Bewerbungen</a></li>
                                <li><a class="dropdown-item" href="/tickets">Meine Tickets</a></li>
                                <li><a class="dropdown-item" href="/verwarnungen">Meine Verwarnungen</a></li>
                                <li><a class="dropdown-item" href="/benutzereinstellungen">Einstellungen</a></li>
                                <li><hr class="dropdown-divider"></li>
                            </AuthorizeView>
                            <li><a class="dropdown-item" href="/logout" target="_top">Abmelden</a></li>
                        </ul>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <a class="btn btn-secondary btn-sm" href="/login" target="_top">Anmelden</a>
                </NotAuthorized>
            </AuthorizeView>

            <button type="button" class="topbar__toggle" aria-controls="topnav" aria-label="Navigation"
                    aria-expanded="@(open ? "true" : "false")" @onclick="Toggle">
                <AppIcon Name="menu"/>
            </button>
        </div>
    </div>
</header>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private DiscordUser? user;
    private bool open;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;

        var userId = AuthState is null ? null : usrSvc.GetUserId((await AuthState).User);
        if (userId is null) return;

        try
        {
            user = await CurrentApplication.DiscordClient.GetUserAsync(userId.Value);
        }
        catch (Exception)
        {
            user = null;
        }
    }

    private void Toggle() => open = !open;

    private void Close() => open = false;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (!open) return;

        open = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
