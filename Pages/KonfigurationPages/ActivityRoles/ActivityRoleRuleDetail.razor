@page "/konfiguration/activityroles/{RuleId}"
@using AGC_Management.Entities.ActivityRoles
@using AGC_Management.Entities.Conditions
@using AGC_Management.Enums.ActivityRoles
@using AGC_Management.Enums.Conditions
@using AGC_Management.Services
@using DisCatSharp.Enums
@implements IDisposable
@inject ToastService ToastService
@inject UnsavedChangesTracker Tracker
@inject NavigationManager Nav
@attribute [Authorize(Policy = DashboardPolicies.AdminOnly)]

<PageHeader Title="@(rule?.Name ?? "Activity-Regel")"
            Lead="Metrik, Zeitfenster, Rollen und Ausnahmen dieser Regel."
            BackHref="/konfiguration/activityroles" BackText="Activity-Rollen"/>

@if (!loaded)
{
    <StateBlock Kind="StateBlock.StateKind.Loading" Title="Regel wird geladen" Description="Einstellungen, Rangstufen und Bedingungen werden abgefragt."/>
}
else if (rule == null)
{
    <StateBlock Kind="StateBlock.StateKind.Error"
                Title="Regel nicht gefunden"
                Description="Diese Regel existiert nicht mehr, oder sie wurde gelöscht."
                ActionText="Zu den Activity-Rollen" ActionHref="/konfiguration/activityroles"/>
}
else
{
    <Panel Title="Einstellungen">
        <div class="field-grid">
            <div class="field field--wide">
                <label class="field__label" for="ar-name">Name</label>
                <input id="ar-name" class="form-control" @bind="name" @bind:after="OnFieldChanged"/>
            </div>
            <div class="field">
                <div class="form-check form-switch m-0">
                    <input class="form-check-input" type="checkbox" role="switch" id="ar-enabled" @bind="enabled" @bind:after="OnFieldChanged"/>
                    <label class="form-check-label" for="ar-enabled">Regel aktiv</label>
                </div>
            </div>
            <div class="field">
                <label class="field__label" for="ar-metric">Metrik</label>
                <select id="ar-metric" class="form-select" @bind="metric" @bind:after="OnFieldChanged">
                    <option value="@ActivityRoleMetric.Messages">Chat-Nachrichten</option>
                    <option value="@ActivityRoleMetric.VoiceMinutes">Voice-Minuten</option>
                    <option value="@ActivityRoleMetric.Combined">Kombiniert (Chat + Voice)</option>
                </select>
            </div>
            <div class="field">
                <label class="field__label" for="ar-mode">Modus</label>
                <select id="ar-mode" class="form-select" @bind="mode" @bind:after="OnFieldChanged">
                    <option value="@ActivityRoleMode.TopN">Rangliste (Top-N)</option>
                    <option value="@ActivityRoleMode.Threshold">Schwellenwert</option>
                </select>
            </div>
            <div class="field">
                <label class="field__label" for="ar-window">Zeitfenster</label>
                <select id="ar-window" class="form-select" @bind="windowType" @bind:after="OnFieldChanged">
                    <option value="@ActivityRoleWindowType.Rolling">Rollierend (letzte X Tage)</option>
                    <option value="@ActivityRoleWindowType.CalendarDaily">Kalendertag</option>
                    <option value="@ActivityRoleWindowType.CalendarWeekly">Kalenderwoche (ab Montag)</option>
                    <option value="@ActivityRoleWindowType.CalendarMonthly">Kalendermonat</option>
                    <option value="@ActivityRoleWindowType.AllTime">Alltime</option>
                </select>
            </div>
            @if (windowType == ActivityRoleWindowType.Rolling)
            {
                <div class="field">
                    <label class="field__label" for="ar-window-days">Rollierende Tage</label>
                    <input id="ar-window-days" type="number" min="1" class="form-control" @bind="windowDays" @bind:after="OnFieldChanged"/>
                </div>
            }
            <div class="field">
                <label class="field__label" for="ar-min-activity">Mindestaktivität</label>
                <input id="ar-min-activity" type="number" min="0" class="form-control" @bind="minActivity" @bind:after="OnFieldChanged"/>
                <span class="field__hint">Nur bei mindestens so vielen Ereignissen im Fenster wird ein Rang vergeben.</span>
            </div>
            <div class="field">
                <div class="form-check form-switch m-0">
                    <input class="form-check-input" type="checkbox" role="switch" id="ar-exclude-left" @bind="excludeLeftMembers" @bind:after="OnFieldChanged"/>
                    <label class="form-check-label" for="ar-exclude-left">Ausgeschiedene Mitglieder überspringen</label>
                </div>
                <span class="field__hint">An (Standard): wer den Server verlässt, wird übersprungen und der nächste rückt nach. Aus: der Rang bleibt belegt, niemand rückt nach - die Rolle bekommt dadurch trotzdem niemand, da Vergabe eine Mitgliedschaft voraussetzt.</span>
            </div>

            @if (mode == ActivityRoleMode.Threshold)
            {
                <div class="field">
                    <label class="field__label" for="ar-threshold-role">Schwellenwert-Rolle</label>
                    <SearchableSelect Id="ar-threshold-role" Items="RoleItems" NoneLabel="Rolle wählen" Placeholder="Rolle suchen..."
                                      @bind-SelectedId="thresholdRoleId" @bind-SelectedId:after="OnFieldChanged"/>
                </div>
                <div class="field">
                    <label class="field__label" for="ar-threshold-comparator">Vergleich</label>
                    <select id="ar-threshold-comparator" class="form-select" @bind="thresholdComparator" @bind:after="OnFieldChanged">
                        <option value="@EligibilityComparator.Gte">Mindestens (&gt;=)</option>
                        <option value="@EligibilityComparator.Lte">Höchstens (&lt;=)</option>
                    </select>
                </div>
                <div class="field">
                    <label class="field__label" for="ar-threshold-value">Wert</label>
                    <input id="ar-threshold-value" type="number" min="0" class="form-control" @bind="thresholdValue" @bind:after="OnFieldChanged"/>
                </div>
                <div class="field">
                    <div class="form-check form-switch m-0">
                        <input class="form-check-input" type="checkbox" role="switch" id="ar-auto-revoke" @bind="autoRevoke" @bind:after="OnFieldChanged"/>
                        <label class="form-check-label" for="ar-auto-revoke">Rolle wieder entziehen, wenn Aktivität unter den Wert fällt</label>
                    </div>
                </div>
            }

            <div class="field">
                <label class="field__label" for="ar-announce-channel">Ankündigungs-Channel</label>
                <SearchableSelect Id="ar-announce-channel" Items="TextChannelItems" NoneLabel="Keine Ankündigung" Placeholder="Channel suchen..."
                                  @bind-SelectedId="announceChannelId" @bind-SelectedId:after="OnFieldChanged"/>
            </div>
            <div class="field">
                <label class="field__label" for="ar-announce-interval">Ankündigungsintervall (Tage)</label>
                <input id="ar-announce-interval" type="number" min="0" class="form-control" @bind="announceIntervalDays" @bind:after="OnFieldChanged"/>
                <span class="field__hint">0 = deaktiviert. Gilt für jedes Zeitfenster, auch rollierend oder Alltime - es ist unabhängig vom Auswertungsfenster selbst.</span>
            </div>
            <div class="field field--wide">
                <label class="field__label" for="ar-announce-message">Ankündigungs-Nachricht</label>
                <textarea id="ar-announce-message" class="form-control" rows="8" @bind="announceMessage" @bind:after="OnFieldChanged"></textarea>
                <span class="field__hint">
                    Volle Kontrolle über den Text - schreib selbst Titel, Erklärung, Fußzeile usw. Platzhalter dafür: {rank1}, {rank2}, {rank3}, ... eine fertig formatierte Zeile
                    pro Rang (Medaille bei 1-3, sonst `#Rang`, Nutzer-Erwähnung, Zählwert - Voice als Stunden - und Rollen-Erwähnung), leer wenn dieser Rang gerade niemand hält.
                    {winners} setzt stattdessen alle Ränge auf einmal untereinander ein, falls dir das reicht.
                </span>
            </div>
        </div>
        <div class="form-foot">
            <button type="button" class="btn btn-secondary" disabled="@sendingAnnouncement" @onclick="SendAnnouncementNow">Ankündigung jetzt senden</button>
            <span class="field__hint">Speichert ungespeicherte Änderungen zuerst, sendet dann sofort und setzt das Ankündigungsintervall zurück - es wird also nicht kurz danach nochmal automatisch gepostet.</span>
        </div>
    </Panel>

    <Panel Title="Erlaubte Channels/Kategorien" Lead="Leer = alle Channels zählen. Eine Kategorie deckt automatisch ihre Channels ab." Flush="@(scopeIds.Count > 0)">
        @if (scopeIds.Count == 0)
        {
            <StateBlock Inline="true" Title="Keine Einschränkung" Description="Alle Channels zählen mit."/>
        }
        else
        {
            <ul class="rows">
                @foreach (var id in scopeIds)
                {
                    <li>
                        <div class="rows__main"><p class="rows__title">@ChannelOrCategoryName(id)</p></div>
                        <div class="rows__side">
                            <button type="button" class="btn btn-danger btn-sm" @onclick="() => RemoveScope(id)">Entfernen</button>
                        </div>
                    </li>
                }
            </ul>
        }
    </Panel>

    <Panel Title="Channel/Kategorie erlauben">
        <div class="field-grid">
            <div class="field">
                <SearchableSelect Items="ScopeItems" NoneLabel="Channel/Kategorie wählen" Placeholder="Channel/Kategorie suchen..."
                                  @bind-SelectedId="newScopeId"/>
            </div>
        </div>
        <div class="form-foot">
            <button type="button" class="btn btn-primary" @onclick="AddScope">Hinzufügen</button>
        </div>
    </Panel>

    <Panel Title="Ausgeschlossene Channels/Kategorien" Lead="Diese Channels zählen nie mit, auch wenn sie in der Einschluss-Liste stehen." Flush="@(excludeScopeIds.Count > 0)">
        @if (excludeScopeIds.Count == 0)
        {
            <StateBlock Inline="true" Title="Kein Ausschluss" Description="Es ist nichts ausgeschlossen."/>
        }
        else
        {
            <ul class="rows">
                @foreach (var id in excludeScopeIds)
                {
                    <li>
                        <div class="rows__main"><p class="rows__title">@ChannelOrCategoryName(id)</p></div>
                        <div class="rows__side">
                            <button type="button" class="btn btn-danger btn-sm" @onclick="() => RemoveExcludeScope(id)">Entfernen</button>
                        </div>
                    </li>
                }
            </ul>
        }
    </Panel>

    <Panel Title="Channel/Kategorie ausschließen">
        <div class="field-grid">
            <div class="field">
                <SearchableSelect Items="ScopeItems" NoneLabel="Channel/Kategorie wählen" Placeholder="Channel/Kategorie suchen..."
                                  @bind-SelectedId="newExcludeScopeId"/>
            </div>
        </div>
        <div class="form-foot">
            <button type="button" class="btn btn-primary" @onclick="AddExcludeScope">Ausschließen</button>
        </div>
    </Panel>

    @if (mode == ActivityRoleMode.TopN)
    {
        <Panel Title="Rangstufen" Lead="Jede Stufe deckt einen Rangbereich ab. Dieselbe Rolle darf mehrfach vergeben werden." Flush="@(tiers.Count > 0)">
            @if (tiers.Count == 0)
            {
                <StateBlock Inline="true" Title="Noch keine Rangstufe" Description="Ohne Rangstufe vergibt diese Regel keine Rolle."/>
            }
            else
            {
                <ul class="rows">
                    @foreach (var tier in tiers.OrderBy(t => t.RankFrom))
                    {
                        <li>
                            <div class="rows__main">
                                <p class="rows__title">Rang @tier.RankFrom@(tier.RankTo != tier.RankFrom ? $" - {tier.RankTo}" : "")</p>
                                <p class="rows__text">@RoleName(tier.RoleId)</p>
                            </div>
                            <div class="rows__side">
                                <button type="button" class="btn btn-danger btn-sm" @onclick="() => RemoveTier(tier)">Entfernen</button>
                            </div>
                        </li>
                    }
                </ul>
            }
        </Panel>

        <Panel Title="Rangstufe hinzufügen">
            <div class="field-grid">
                <div class="field">
                    <label class="field__label">Von Rang</label>
                    <input type="number" min="1" class="form-control" @bind="newTierFrom"/>
                </div>
                <div class="field">
                    <label class="field__label">Bis Rang</label>
                    <input type="number" min="1" class="form-control" @bind="newTierTo"/>
                </div>
                <div class="field">
                    <label class="field__label">Rolle</label>
                    <SearchableSelect Items="RoleItems" NoneLabel="Rolle wählen" Placeholder="Rolle suchen..." @bind-SelectedId="newTierRoleId"/>
                </div>
            </div>
            <div class="form-foot">
                <button type="button" class="btn btn-primary" @onclick="AddTier">Rangstufe hinzufügen</button>
            </div>
        </Panel>
    }

    <Panel Title="Erlaubte Rollen" Lead="Nur Mitglieder mit mindestens einer dieser Rollen sind teilnahmeberechtigt. Leer = keine Einschränkung." Flush="@(whitelistRoles.Count > 0)">
        @if (whitelistRoles.Count == 0)
        {
            <StateBlock Inline="true" Title="Keine Einschränkung" Description="Alle Mitglieder dürfen teilnehmen."/>
        }
        else
        {
            <ul class="rows">
                @foreach (var condition in whitelistRoles)
                {
                    <li>
                        <div class="rows__main"><p class="rows__title">@RoleName((ulong)condition.Value)</p></div>
                        <div class="rows__side">
                            <button type="button" class="btn btn-danger btn-sm" @onclick="() => RemoveCondition(condition)">Entfernen</button>
                        </div>
                    </li>
                }
            </ul>
        }
    </Panel>

    <Panel Title="Rolle erlauben">
        <div class="field-grid">
            <div class="field">
                <SearchableSelect Items="RoleItems" NoneLabel="Rolle wählen" Placeholder="Rolle suchen..." @bind-SelectedId="newWhitelistRoleId"/>
            </div>
        </div>
        <div class="form-foot">
            <button type="button" class="btn btn-primary" @onclick="AddWhitelistRole">Zur Whitelist hinzufügen</button>
        </div>
    </Panel>

    <Panel Title="Ausgeschlossene Rollen" Lead="Mitglieder mit einer dieser Rollen sind nie teilnahmeberechtigt." Flush="@(blacklistRoles.Count > 0)">
        @if (blacklistRoles.Count == 0)
        {
            <StateBlock Inline="true" Title="Keine Ausschlüsse" Description="Keine Rolle ist ausgeschlossen."/>
        }
        else
        {
            <ul class="rows">
                @foreach (var condition in blacklistRoles)
                {
                    <li>
                        <div class="rows__main"><p class="rows__title">@RoleName((ulong)condition.Value)</p></div>
                        <div class="rows__side">
                            <button type="button" class="btn btn-danger btn-sm" @onclick="() => RemoveCondition(condition)">Entfernen</button>
                        </div>
                    </li>
                }
            </ul>
        }
    </Panel>

    <Panel Title="Rolle ausschließen">
        <div class="field-grid">
            <div class="field">
                <SearchableSelect Items="RoleItems" NoneLabel="Rolle wählen" Placeholder="Rolle suchen..." @bind-SelectedId="newBlacklistRoleId"/>
            </div>
        </div>
        <div class="form-foot">
            <button type="button" class="btn btn-primary" @onclick="AddBlacklistRole">Ausschließen</button>
        </div>
    </Panel>

    <Panel Title="Mitglieder-Ausnahmen" Lead="Einzelne Mitglieder unabhängig von ihren Rollen von dieser Regel ausschließen." Flush="@(memberExceptions.Count > 0)">
        @if (memberExceptions.Count == 0)
        {
            <StateBlock Inline="true" Title="Keine Ausnahmen" Description="Kein Mitglied ist einzeln ausgeschlossen."/>
        }
        else
        {
            <ul class="rows">
                @foreach (var condition in memberExceptions)
                {
                    <li>
                        <div class="rows__main"><p class="rows__title">@MemberLabel((ulong)condition.Value)</p></div>
                        <div class="rows__side">
                            <button type="button" class="btn btn-danger btn-sm" @onclick="() => RemoveCondition(condition)">Entfernen</button>
                        </div>
                    </li>
                }
            </ul>
        }
    </Panel>

    <Panel Title="Mitglied ausschließen">
        <div class="field-grid">
            <div class="field">
                <label class="field__label">Discord-User-ID</label>
                <input class="form-control" @bind="newExceptionMemberId" placeholder="z.B. 123456789012345678"/>
            </div>
        </div>
        <div class="form-foot">
            <button type="button" class="btn btn-primary" @onclick="AddMemberException">Ausschließen</button>
        </div>
    </Panel>

    <Panel Title="Erweitert" Lead="Weitere Teilnahmebedingungen: Mitgliedsalter, Server-Boost, Level." Flush="@(advancedConditions.Count > 0)">
        @if (advancedConditions.Count == 0)
        {
            <StateBlock Inline="true" Title="Keine weiteren Bedingungen" Description="Lege unten bei Bedarf eine an."/>
        }
        else
        {
            <ul class="rows">
                @foreach (var condition in advancedConditions)
                {
                    <li>
                        <div class="rows__main"><p class="rows__title">@AdvancedConditionLabel(condition)</p></div>
                        <div class="rows__side">
                            <button type="button" class="btn btn-danger btn-sm" @onclick="() => RemoveCondition(condition)">Entfernen</button>
                        </div>
                    </li>
                }
            </ul>
        }
    </Panel>

    <Panel Title="Bedingung hinzufügen">
        <div class="field-grid">
            <div class="field">
                <label class="field__label">Typ</label>
                <select class="form-select" @bind="newAdvancedType">
                    <option value="@EligibilityConditionType.MembershipAge">Mitgliedsalter (Tage im Server)</option>
                    <option value="@EligibilityConditionType.Boost">Server-Boost</option>
                    <option value="@EligibilityConditionType.Level">Level</option>
                </select>
            </div>
            @if (newAdvancedType != EligibilityConditionType.Boost)
            {
                <div class="field">
                    <label class="field__label">Vergleich</label>
                    <select class="form-select" @bind="newAdvancedComparator">
                        <option value="@EligibilityComparator.Gte">Mindestens (&gt;=)</option>
                        <option value="@EligibilityComparator.Lte">Höchstens (&lt;=)</option>
                    </select>
                </div>
                <div class="field">
                    <label class="field__label">Wert</label>
                    <input type="number" min="0" class="form-control" @bind="newAdvancedValue"/>
                </div>
            }
            <div class="field">
                <div class="form-check form-switch m-0">
                    <input class="form-check-input" type="checkbox" role="switch" id="ar-advanced-negate" @bind="newAdvancedNegate"/>
                    <label class="form-check-label" for="ar-advanced-negate">Verneinen (Bedingung ausschließen statt fordern)</label>
                </div>
            </div>
        </div>
        <div class="form-foot">
            <button type="button" class="btn btn-primary" @onclick="AddAdvancedCondition">Bedingung hinzufügen</button>
        </div>
    </Panel>

    <Panel Title="Format der Rangzeile" Lead="Bestimmt, wie {rank1}, {rank2}, ... und {winners} in der Ankündigungs-Nachricht aussehen." Flush="@(winnerLineBlocks.Count > 0)">
        @if (winnerLineBlocks.Count == 0)
        {
            <StateBlock Inline="true" Title="Keine Blöcke" Description="Ohne Blöcke sind {rank1} etc. leer. Füge unten mindestens einen an."/>
        }
        else
        {
            <ul class="rows">
                @for (var i = 0; i < winnerLineBlocks.Count; i++)
                {
                    var index = i;
                    var block = winnerLineBlocks[index];
                    <li>
                        <div class="rows__main"><p class="rows__title">@WinnerLineBlockLabel(block)</p></div>
                        <div class="rows__side">
                            <button type="button" class="btn btn-secondary btn-sm" disabled="@(index == 0)" @onclick="() => MoveWinnerLineBlock(index, -1)">↑</button>
                            <button type="button" class="btn btn-secondary btn-sm" disabled="@(index == winnerLineBlocks.Count - 1)" @onclick="() => MoveWinnerLineBlock(index, 1)">↓</button>
                            <button type="button" class="btn btn-danger btn-sm" @onclick="() => RemoveWinnerLineBlock(index)">Entfernen</button>
                        </div>
                    </li>
                }
            </ul>
        }
    </Panel>

    <Panel Title="Block hinzufügen">
        <div class="field-grid">
            <div class="field">
                <select class="form-select" @bind="newWinnerLineBlock">
                    @foreach (var block in ActivityRoleService.WinnerLineBlockKeys.Where(b => !winnerLineBlocks.Contains(b.Key)))
                    {
                        <option value="@block.Key">@block.Label</option>
                    }
                </select>
            </div>
        </div>
        <div class="form-foot">
            <button type="button" class="btn btn-primary" @onclick="AddWinnerLineBlock">Hinzufügen</button>
        </div>
    </Panel>

    <Panel Title="Medaillen &amp; Zählwert" Lead="Wie die Bausteine 'Medaille' und 'Zählwert' aus der Rangzeile konkret aussehen.">
        <div class="field-grid">
            <div class="field">
                <label class="field__label" for="ar-medal-1">Medaille Rang 1</label>
                <input id="ar-medal-1" class="form-control" @bind="medalRank1" @bind:after="OnFieldChanged"/>
            </div>
            <div class="field">
                <label class="field__label" for="ar-medal-2">Medaille Rang 2</label>
                <input id="ar-medal-2" class="form-control" @bind="medalRank2" @bind:after="OnFieldChanged"/>
            </div>
            <div class="field">
                <label class="field__label" for="ar-medal-3">Medaille Rang 3</label>
                <input id="ar-medal-3" class="form-control" @bind="medalRank3" @bind:after="OnFieldChanged"/>
            </div>
            <div class="field">
                <label class="field__label" for="ar-medal-other">Medaille ab Rang 4</label>
                <input id="ar-medal-other" class="form-control" @bind="medalOtherTemplate" @bind:after="OnFieldChanged"/>
                <span class="field__hint">Platzhalter: {rank}. Leer lassen für keine Kennzeichnung ab Rang 4.</span>
            </div>
            <div class="field">
                <label class="field__label" for="ar-count-divisor">Zählwert teilen durch</label>
                <input id="ar-count-divisor" type="number" min="1" class="form-control" @bind="countDivisor" @bind:after="OnFieldChanged"/>
                <span class="field__hint">Z.B. 60 bei Voice-Minuten, um Stunden anzuzeigen. 1 = unverändert.</span>
            </div>
            <div class="field">
                <label class="field__label" for="ar-count-suffix">Einheit / Suffix</label>
                <input id="ar-count-suffix" class="form-control" @bind="countSuffix" @bind:after="OnFieldChanged" placeholder="z.B. h, min, Nachrichten"/>
            </div>
            <div class="field">
                <div class="form-check form-switch m-0">
                    <input class="form-check-input" type="checkbox" role="switch" id="ar-count-monospace" @bind="countMonospace" @bind:after="OnFieldChanged"/>
                    <label class="form-check-label" for="ar-count-monospace">Zählwert in Monospace-Schrift</label>
                </div>
            </div>
        </div>
        <p class="field__hint mt-3">Vorschau mit Beispieldaten: <code>@WinnerLinePreview()</code></p>
    </Panel>

    <Panel Title="Vorschau" Lead="Zeigt die aktuell berechnete Rangliste bzw. Schwellenwert-Treffer, ohne den nächsten Auswertungszyklus abzuwarten.">
        <div class="form-foot mb-3">
            <button type="button" class="btn btn-secondary" disabled="@previewLoading" @onclick="RunPreview">Jetzt berechnen</button>
        </div>
        @if (previewLoading)
        {
            <StateBlock Inline="true" Kind="StateBlock.StateKind.Loading" Title="Vorschau wird berechnet" Description="Aktivitätsdaten werden ausgewertet."/>
        }
        else if (previewResults == null)
        {
            <StateBlock Inline="true" Title="Noch keine Vorschau" Description="Klicke auf 'Jetzt berechnen', um die aktuelle Auswertung zu sehen."/>
        }
        else if (previewResults.Count == 0)
        {
            <StateBlock Inline="true" Title="Keine Treffer" Description="Aktuell erfüllt niemand die konfigurierten Bedingungen."/>
        }
        else
        {
            <ul class="rows">
                @foreach (var result in previewResults.OrderBy(r => r.Rank == 0 ? int.MaxValue : r.Rank))
                {
                    <li>
                        <div class="rows__main">
                            <p class="rows__title">@(result.Rank > 0 ? $"Rang {result.Rank}" : "Über Schwellenwert") &middot; @MemberLabel(result.UserId)</p>
                            <p class="rows__text">@RoleName(result.RoleId) &middot; @FormatPreviewCount(result.Count) im Auswertungsfenster</p>
                        </div>
                    </li>
                }
            </ul>
            <p class="field__hint mt-2">Momentaufnahme. Rollen werden erst beim nächsten regulären Lauf tatsächlich vergeben/entzogen.</p>
        }
    </Panel>

    <Panel Title="Regel löschen">
        @if (!confirmingDelete)
        {
            <button type="button" class="btn btn-danger" @onclick="() => confirmingDelete = true">Regel löschen</button>
        }
        else
        {
            <ConfirmInline Title="Regel wirklich löschen?" ConfirmText="Ja, löschen" Busy="deleting"
                           OnConfirm="DeleteRule" OnCancel="() => confirmingDelete = false">
                <p>Alle Rangstufen, Bedingungen und vom Bot vergebenen Rollen dieser Regel werden entfernt. Bereits vergebene Rollen werden dabei nicht automatisch entzogen.</p>
            </ConfirmInline>
        }
    </Panel>
}

@code {
    [Parameter] public string RuleId { get; set; } = "";

    private bool loaded;
    private ActivityRoleRule? rule;

    private string name = "";
    private bool enabled = true;
    private ActivityRoleMetric metric;
    private ActivityRoleMode mode;
    private ActivityRoleWindowType windowType;
    private int windowDays = 7;
    private long minActivity;
    private ulong thresholdRoleId;
    private EligibilityComparator thresholdComparator;
    private long thresholdValue;
    private bool autoRevoke = true;
    private bool excludeLeftMembers = true;
    private ulong announceChannelId;
    private int announceIntervalDays;
    private string announceMessage = "";

    private List<long> scopeIds = [];
    private List<long> excludeScopeIds = [];
    private ulong newScopeId;
    private ulong newExcludeScopeId;

    private List<ActivityRoleTier> tiers = [];
    private int newTierFrom = 1;
    private int newTierTo = 1;
    private ulong newTierRoleId;

    private List<EligibilityCondition> conditions = [];
    private ulong newWhitelistRoleId;
    private ulong newBlacklistRoleId;
    private string newExceptionMemberId = "";
    private EligibilityConditionType newAdvancedType = EligibilityConditionType.MembershipAge;
    private EligibilityComparator newAdvancedComparator = EligibilityComparator.Gte;
    private long newAdvancedValue;
    private bool newAdvancedNegate;

    private List<string> winnerLineBlocks = [];
    private string newWinnerLineBlock = "";

    private string medalRank1 = "🥇";
    private string medalRank2 = "🥈";
    private string medalRank3 = "🥉";
    private string medalOtherTemplate = "`#{rank}`";
    private long countDivisor = 1;
    private string countSuffix = "";
    private bool countMonospace = true;

    private List<DiscordChannel> textChannels = [];
    private List<DiscordChannel> scopeCandidates = [];
    private List<DiscordRole> assignableRoles = [];

    private List<(ulong Id, string Label)> RoleItems => assignableRoles.Select(r => (r.Id, r.Name)).ToList();
    private List<(ulong Id, string Label)> TextChannelItems => textChannels.Select(c => (c.Id, $"#{c.Name}")).ToList();
    private List<(ulong Id, string Label)> ScopeItems => scopeCandidates.Select(c => (c.Id, ChannelOrCategoryLabel(c))).ToList();

    private bool previewLoading;
    private List<ActivityRoleService.RankedGrant>? previewResults;

    private bool sendingAnnouncement;

    private bool confirmingDelete;
    private bool deleting;

    private List<EligibilityCondition> whitelistRoles =>
        conditions.Where(c => c.Type == EligibilityConditionType.Role && !c.Negate).ToList();

    private List<EligibilityCondition> blacklistRoles =>
        conditions.Where(c => c.Type == EligibilityConditionType.Role && c.Negate).ToList();

    private List<EligibilityCondition> memberExceptions =>
        conditions.Where(c => c.Type == EligibilityConditionType.Member).ToList();

    private List<EligibilityCondition> advancedConditions =>
        conditions.Where(c => c.Type is EligibilityConditionType.MembershipAge or EligibilityConditionType.Boost or EligibilityConditionType.Level).ToList();

    protected override async Task OnInitializedAsync()
    {
        await Load();
        if (rule != null)
        {
            RebuildSnapshot();
            Tracker.Register(SaveSettings, DiscardSettings);
        }

        loaded = true;
    }

    public void Dispose()
    {
        Tracker.Unregister();
    }

    private void OnFieldChanged()
    {
        Tracker.MarkDirty();
    }

    private async Task Load()
    {
        rule = await ActivityRoleService.GetRuleAsync(RuleId);
        if (rule == null) return;

        name = rule.Name;
        enabled = rule.Enabled;
        metric = rule.Metric;
        mode = rule.Mode;
        windowType = rule.WindowType;
        windowDays = rule.WindowDays;
        minActivity = rule.MinActivity;
        thresholdRoleId = rule.ThresholdRoleId;
        thresholdComparator = rule.ThresholdComparator;
        thresholdValue = rule.ThresholdValue;
        autoRevoke = rule.AutoRevoke;
        excludeLeftMembers = rule.ExcludeLeftMembers;
        announceChannelId = rule.AnnounceChannelId;
        announceIntervalDays = rule.AnnounceIntervalDays;
        announceMessage = rule.AnnounceMessage;
        scopeIds = rule.ScopeIds.ToList();
        excludeScopeIds = rule.ExcludeScopeIds.ToList();
        tiers = rule.Tiers.ToList();
        winnerLineBlocks = rule.WinnerLineBlocks.ToList();
        newWinnerLineBlock = ActivityRoleService.WinnerLineBlockKeys.Select(b => b.Key).FirstOrDefault(k => !winnerLineBlocks.Contains(k)) ?? "";
        medalRank1 = rule.MedalRank1;
        medalRank2 = rule.MedalRank2;
        medalRank3 = rule.MedalRank3;
        medalOtherTemplate = rule.MedalOtherTemplate;
        countDivisor = rule.CountDivisor;
        countSuffix = rule.CountSuffix;
        countMonospace = rule.CountMonospace;

        conditions = await EligibilityService.GetConditionsAsync(ActivityRoleService.OwnerType, RuleId);

        var guild = CurrentApplication.TargetGuild;
        textChannels = guild.Channels.Values.Where(c => c.Type == ChannelType.Text).OrderBy(c => c.Position).ToList();
        scopeCandidates = guild.Channels.Values
            .Where(c => c.Type is ChannelType.Text or ChannelType.Voice or ChannelType.Stage or ChannelType.Category)
            .OrderBy(c => c.Position).ToList();
        assignableRoles = guild.Roles.Values.Where(r => !r.IsManaged && r.Id != guild.Id)
            .OrderByDescending(r => r.Position).ToList();
    }

    private long originalMinActivity, originalThresholdValue, originalWindowDays;
    private string originalName = "";
    private bool originalEnabled, originalAutoRevoke, originalExcludeLeftMembers;
    private ActivityRoleMetric originalMetric;
    private ActivityRoleMode originalMode;
    private ActivityRoleWindowType originalWindowType;
    private ulong originalThresholdRoleId, originalAnnounceChannelId;
    private EligibilityComparator originalThresholdComparator;
    private int originalAnnounceIntervalDays;
    private string originalAnnounceMessage = "";
    private string originalMedalRank1 = "", originalMedalRank2 = "", originalMedalRank3 = "", originalMedalOtherTemplate = "";
    private long originalCountDivisor;
    private string originalCountSuffix = "";
    private bool originalCountMonospace;

    private void RebuildSnapshot()
    {
        originalName = name;
        originalEnabled = enabled;
        originalMetric = metric;
        originalMode = mode;
        originalWindowType = windowType;
        originalWindowDays = windowDays;
        originalMinActivity = minActivity;
        originalThresholdRoleId = thresholdRoleId;
        originalThresholdComparator = thresholdComparator;
        originalThresholdValue = thresholdValue;
        originalAutoRevoke = autoRevoke;
        originalExcludeLeftMembers = excludeLeftMembers;
        originalAnnounceChannelId = announceChannelId;
        originalAnnounceIntervalDays = announceIntervalDays;
        originalAnnounceMessage = announceMessage;
        originalMedalRank1 = medalRank1;
        originalMedalRank2 = medalRank2;
        originalMedalRank3 = medalRank3;
        originalMedalOtherTemplate = medalOtherTemplate;
        originalCountDivisor = countDivisor;
        originalCountSuffix = countSuffix;
        originalCountMonospace = countMonospace;
    }

    private void DiscardSettings()
    {
        name = originalName;
        enabled = originalEnabled;
        metric = originalMetric;
        mode = originalMode;
        windowType = originalWindowType;
        windowDays = (int)originalWindowDays;
        minActivity = originalMinActivity;
        thresholdRoleId = originalThresholdRoleId;
        thresholdComparator = originalThresholdComparator;
        thresholdValue = originalThresholdValue;
        autoRevoke = originalAutoRevoke;
        excludeLeftMembers = originalExcludeLeftMembers;
        announceChannelId = originalAnnounceChannelId;
        announceIntervalDays = originalAnnounceIntervalDays;
        announceMessage = originalAnnounceMessage;
        medalRank1 = originalMedalRank1;
        medalRank2 = originalMedalRank2;
        medalRank3 = originalMedalRank3;
        medalOtherTemplate = originalMedalOtherTemplate;
        countDivisor = originalCountDivisor;
        countSuffix = originalCountSuffix;
        countMonospace = originalCountMonospace;
    }

    private async Task SaveSettings()
    {
        if (rule == null) return;

        rule.Name = name.Trim();
        rule.Enabled = enabled;
        rule.Metric = metric;
        rule.Mode = mode;
        rule.WindowType = windowType;
        rule.WindowDays = Math.Max(windowDays, 1);
        rule.MinActivity = Math.Max(minActivity, 0);
        rule.ThresholdRoleId = thresholdRoleId;
        rule.ThresholdComparator = thresholdComparator;
        rule.ThresholdValue = Math.Max(thresholdValue, 0);
        rule.AutoRevoke = autoRevoke;
        rule.ExcludeLeftMembers = excludeLeftMembers;
        rule.AnnounceChannelId = announceChannelId;
        rule.AnnounceIntervalDays = Math.Max(announceIntervalDays, 0);
        rule.AnnounceMessage = announceMessage;
        rule.MedalRank1 = medalRank1;
        rule.MedalRank2 = medalRank2;
        rule.MedalRank3 = medalRank3;
        rule.MedalOtherTemplate = medalOtherTemplate;
        rule.CountDivisor = countDivisor <= 0 ? 1 : countDivisor;
        rule.CountSuffix = countSuffix;
        rule.CountMonospace = countMonospace;

        await ActivityRoleService.UpdateRuleAsync(rule);
        ToastService.Notify("Einstellungen gespeichert.", "ok");
        await Load();
        RebuildSnapshot();
    }

    private string RoleName(ulong roleId)
    {
        var role = CurrentApplication.TargetGuild.GetRole(roleId);
        return role is null ? $"Rolle gelöscht ({roleId})" : role.Name;
    }

    private string ChannelOrCategoryName(long id)
    {
        var channel = CurrentApplication.TargetGuild.GetChannel((ulong)id);
        if (channel is null) return $"Channel gelöscht ({id})";
        return ChannelOrCategoryLabel(channel);
    }

    private static string ChannelOrCategoryLabel(DiscordChannel channel)
    {
        return channel.Type == ChannelType.Category ? $"Kategorie: {channel.Name}" : $"#{channel.Name}";
    }

    private string MemberLabel(ulong userId)
    {
        return CurrentApplication.TargetGuild.Members.TryGetValue(userId, out var member)
            ? $"{member.DisplayName} ({userId})"
            : $"Unbekannt ({userId})";
    }

    /// <summary>Uses the rule's own count formatting (Divisor/Suffix) so the preview matches the announcement.</summary>
    private string FormatPreviewCount(long count)
    {
        var divisor = countDivisor <= 0 ? 1 : countDivisor;
        return $"{count / divisor}{countSuffix}";
    }

    private string AdvancedConditionLabel(EligibilityCondition condition)
    {
        var negatePrefix = condition.Negate ? "NICHT " : "";
        return condition.Type switch
        {
            EligibilityConditionType.Boost => $"{negatePrefix}Server-Boost",
            EligibilityConditionType.MembershipAge => $"{negatePrefix}Mitgliedsalter {ComparatorLabel(condition.Comparator)} {condition.Value} Tage",
            EligibilityConditionType.Level => $"{negatePrefix}Level {ComparatorLabel(condition.Comparator)} {condition.Value}",
            _ => condition.Type.ToString()
        };
    }

    private static string ComparatorLabel(EligibilityComparator comparator)
    {
        return comparator == EligibilityComparator.Lte ? "<=" : ">=";
    }

    private async Task RunPreview()
    {
        previewLoading = true;
        previewResults = null;
        StateHasChanged();

        previewResults = await ActivityRoleService.PreviewRuleAsync(RuleId);
        previewLoading = false;
    }

    private async Task SendAnnouncementNow()
    {
        if (sendingAnnouncement) return;
        sendingAnnouncement = true;

        if (Tracker.IsDirty) await Tracker.SaveAsync();

        var sent = await ActivityRoleService.TriggerAnnouncementAsync(RuleId);
        sendingAnnouncement = false;

        ToastService.Notify(
            sent ? "Ankündigung gesendet." : "Nichts gesendet - kein Ankündigungs-Channel gesetzt oder aktuell niemand in der Auswertung.",
            sent ? "ok" : "bad");
        await Load();
    }

    #region Scope

    private async Task AddScope()
    {
        if (newScopeId == 0 || rule == null)
        {
            ToastService.Notify("Bitte einen Channel oder eine Kategorie wählen.", "bad");
            return;
        }

        if (scopeIds.Contains((long)newScopeId))
        {
            ToastService.Notify("Ist bereits in der Liste.", "bad");
            return;
        }

        scopeIds.Add((long)newScopeId);
        rule.ScopeIds = scopeIds.ToArray();
        await ActivityRoleService.UpdateRuleAsync(rule);
        newScopeId = 0;
        ToastService.Notify("Hinzugefügt.", "ok");
    }

    private async Task RemoveScope(long id)
    {
        if (rule == null) return;
        scopeIds.Remove(id);
        rule.ScopeIds = scopeIds.ToArray();
        await ActivityRoleService.UpdateRuleAsync(rule);
        ToastService.Notify("Entfernt.", "ok");
    }

    private async Task AddExcludeScope()
    {
        if (newExcludeScopeId == 0 || rule == null)
        {
            ToastService.Notify("Bitte einen Channel oder eine Kategorie wählen.", "bad");
            return;
        }

        if (excludeScopeIds.Contains((long)newExcludeScopeId))
        {
            ToastService.Notify("Ist bereits in der Liste.", "bad");
            return;
        }

        excludeScopeIds.Add((long)newExcludeScopeId);
        rule.ExcludeScopeIds = excludeScopeIds.ToArray();
        await ActivityRoleService.UpdateRuleAsync(rule);
        newExcludeScopeId = 0;
        ToastService.Notify("Ausgeschlossen.", "ok");
    }

    private async Task RemoveExcludeScope(long id)
    {
        if (rule == null) return;
        excludeScopeIds.Remove(id);
        rule.ExcludeScopeIds = excludeScopeIds.ToArray();
        await ActivityRoleService.UpdateRuleAsync(rule);
        ToastService.Notify("Entfernt.", "ok");
    }

    #endregion

    #region Tiers

    private async Task AddTier()
    {
        if (newTierRoleId == 0)
        {
            ToastService.Notify("Bitte eine Rolle wählen.", "bad");
            return;
        }

        if (newTierFrom < 1 || newTierTo < newTierFrom)
        {
            ToastService.Notify("Ungültiger Rangbereich.", "bad");
            return;
        }

        await ActivityRoleService.AddTierAsync(new ActivityRoleTier
        {
            TierId = ToolSet.GenerateCaseID(),
            RuleId = RuleId,
            RankFrom = newTierFrom,
            RankTo = newTierTo,
            RoleId = newTierRoleId
        });

        newTierFrom = 1;
        newTierTo = 1;
        newTierRoleId = 0;
        ToastService.Notify("Rangstufe hinzugefügt.", "ok");
        await Load();
    }

    private async Task RemoveTier(ActivityRoleTier tier)
    {
        await ActivityRoleService.RemoveTierAsync(tier.TierId);
        ToastService.Notify("Rangstufe entfernt.", "ok");
        await Load();
    }

    #endregion

    #region Conditions

    private async Task AddWhitelistRole()
    {
        if (newWhitelistRoleId == 0)
        {
            ToastService.Notify("Bitte eine Rolle wählen.", "bad");
            return;
        }

        if (whitelistRoles.Any(c => (ulong)c.Value == newWhitelistRoleId))
        {
            ToastService.Notify("Ist bereits in der Whitelist.", "bad");
            return;
        }

        await EligibilityService.AddConditionAsync(new EligibilityCondition
        {
            ConditionId = ToolSet.GenerateCaseID(),
            OwnerType = ActivityRoleService.OwnerType,
            OwnerId = RuleId,
            GroupId = 0,
            Type = EligibilityConditionType.Role,
            Value = (long)newWhitelistRoleId,
            CreatedAt = DateTimeOffset.UtcNow.ToUnixTimeSeconds()
        });

        newWhitelistRoleId = 0;
        ToastService.Notify("Zur Whitelist hinzugefügt.", "ok");
        await Load();
    }

    private async Task AddBlacklistRole()
    {
        if (newBlacklistRoleId == 0)
        {
            ToastService.Notify("Bitte eine Rolle wählen.", "bad");
            return;
        }

        if (blacklistRoles.Any(c => (ulong)c.Value == newBlacklistRoleId))
        {
            ToastService.Notify("Ist bereits ausgeschlossen.", "bad");
            return;
        }

        await EligibilityService.AddConditionAsync(new EligibilityCondition
        {
            ConditionId = ToolSet.GenerateCaseID(),
            OwnerType = ActivityRoleService.OwnerType,
            OwnerId = RuleId,
            GroupId = NextGroupId(),
            Type = EligibilityConditionType.Role,
            Negate = true,
            Value = (long)newBlacklistRoleId,
            CreatedAt = DateTimeOffset.UtcNow.ToUnixTimeSeconds()
        });

        newBlacklistRoleId = 0;
        ToastService.Notify("Ausgeschlossen.", "ok");
        await Load();
    }

    private async Task AddMemberException()
    {
        if (!ulong.TryParse(newExceptionMemberId.Trim(), out var userId) || userId == 0)
        {
            ToastService.Notify("Bitte eine gültige Discord-User-ID eingeben.", "bad");
            return;
        }

        if (memberExceptions.Any(c => (ulong)c.Value == userId))
        {
            ToastService.Notify("Ist bereits ausgeschlossen.", "bad");
            return;
        }

        await EligibilityService.AddConditionAsync(new EligibilityCondition
        {
            ConditionId = ToolSet.GenerateCaseID(),
            OwnerType = ActivityRoleService.OwnerType,
            OwnerId = RuleId,
            GroupId = NextGroupId(),
            Type = EligibilityConditionType.Member,
            Negate = true,
            Value = (long)userId,
            CreatedAt = DateTimeOffset.UtcNow.ToUnixTimeSeconds()
        });

        newExceptionMemberId = "";
        ToastService.Notify("Mitglied ausgeschlossen.", "ok");
        await Load();
    }

    private async Task AddAdvancedCondition()
    {
        await EligibilityService.AddConditionAsync(new EligibilityCondition
        {
            ConditionId = ToolSet.GenerateCaseID(),
            OwnerType = ActivityRoleService.OwnerType,
            OwnerId = RuleId,
            GroupId = NextGroupId(),
            Type = newAdvancedType,
            Comparator = newAdvancedComparator,
            Value = newAdvancedValue,
            Negate = newAdvancedNegate,
            CreatedAt = DateTimeOffset.UtcNow.ToUnixTimeSeconds()
        });

        newAdvancedValue = 0;
        newAdvancedNegate = false;
        ToastService.Notify("Bedingung hinzugefügt.", "ok");
        await Load();
    }

    private async Task RemoveCondition(EligibilityCondition condition)
    {
        await EligibilityService.RemoveConditionAsync(condition.ConditionId);
        ToastService.Notify("Entfernt.", "ok");
        await Load();
    }

    private int NextGroupId()
    {
        var used = conditions.Where(c => c.GroupId != 0).Select(c => c.GroupId).ToList();
        return used.Count == 0 ? 1 : used.Max() + 1;
    }

    #endregion

    #region Winner line builder

    private static string WinnerLineBlockLabel(string key)
    {
        return ActivityRoleService.WinnerLineBlockKeys.FirstOrDefault(b => b.Key == key).Label ?? key;
    }

    private async Task AddWinnerLineBlock()
    {
        if (rule == null || string.IsNullOrEmpty(newWinnerLineBlock) || winnerLineBlocks.Contains(newWinnerLineBlock))
            return;

        winnerLineBlocks.Add(newWinnerLineBlock);
        rule.WinnerLineBlocks = winnerLineBlocks;
        await ActivityRoleService.UpdateRuleAsync(rule);
        ToastService.Notify("Block hinzugefügt.", "ok");
        await Load();
    }

    private async Task RemoveWinnerLineBlock(int index)
    {
        if (rule == null) return;

        winnerLineBlocks.RemoveAt(index);
        rule.WinnerLineBlocks = winnerLineBlocks;
        await ActivityRoleService.UpdateRuleAsync(rule);
        ToastService.Notify("Entfernt.", "ok");
        await Load();
    }

    private async Task MoveWinnerLineBlock(int index, int direction)
    {
        if (rule == null) return;

        var target = index + direction;
        if (target < 0 || target >= winnerLineBlocks.Count) return;

        (winnerLineBlocks[index], winnerLineBlocks[target]) = (winnerLineBlocks[target], winnerLineBlocks[index]);
        rule.WinnerLineBlocks = winnerLineBlocks;
        await ActivityRoleService.UpdateRuleAsync(rule);
        await Load();
    }

    private string WinnerLinePreview()
    {
        const ulong sampleUserId = 329205713605754881;
        var sampleRoleId = tiers.FirstOrDefault()?.RoleId ?? assignableRoles.FirstOrDefault()?.Id ?? 0;
        var sample = new ActivityRoleService.RankedGrant(sampleUserId, sampleRoleId, 1,
            metric == ActivityRoleMetric.VoiceMinutes ? 13560 : 3259);

        var previewRule = new ActivityRoleRule
        {
            WinnerLineBlocks = winnerLineBlocks,
            MedalRank1 = medalRank1,
            MedalRank2 = medalRank2,
            MedalRank3 = medalRank3,
            MedalOtherTemplate = medalOtherTemplate,
            CountDivisor = countDivisor,
            CountSuffix = countSuffix,
            CountMonospace = countMonospace
        };

        return ActivityRoleService.FormatWinnerLine(sample, previewRule);
    }

    #endregion

    private async Task DeleteRule()
    {
        if (deleting) return;
        deleting = true;
        await ActivityRoleService.DeleteRuleAsync(RuleId);
        deleting = false;
        ToastService.Notify("Regel gelöscht.", "ok");
        Nav.NavigateTo("/konfiguration/activityroles");
    }
}
