@page "/konfiguration/applysystem/questions/{PositionId}"
@using AGC_Management.Controller
@using AGC_Management.Entities.ApplicationSystem
@using AGC_Management.Enums.ApplicationSystem
@using AGC_Management.Services
@inject UserService UserService
@attribute [Authorize(Roles = "BotOwner, Administrator, HeadModerator, Moderator, Supporter, HeadEventmanager, Team")]

<h1>Fragenkatalog: @(position?.PositionName ?? PositionId)</h1>
<a class="btn btn-secondary-glass mb-3" href="/konfiguration/applysystem/positions">Zurück zu den Positionen</a>

@if (!loaded)
{
    <div class="spinner-border" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
}
else if (!mayManage)
{
    <div class="alert alert-danger-glass mt-3" role="alert">
        Du hast keine Berechtigung, den Fragenkatalog dieser Position zu bearbeiten.
    </div>
}
else if (position == null)
{
    <div class="alert alert-danger-glass mt-3" role="alert">Diese Position existiert nicht.</div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert alert-info-glass mt-2" role="alert">@statusMessage</div>
    }

    <div class="glass-card mt-3 p-3">
        <h3>Versionen</h3>
        <p class="mb-2">
            Veröffentlicht:
            @if (published != null)
            {
                <strong>Version @published.Version</strong>
            }
            else
            {
                <span class="badge-danger-glass">keine</span>
            }
        </p>
        <p class="mb-3">
            Entwurf:
            @if (draft != null)
            {
                <strong>Version @draft.Version</strong>
            }
            else
            {
                <span class="badge-danger-glass">keiner</span>
            }
        </p>
        <div class="d-flex flex-wrap gap-2">
            @if (draft == null)
            {
                <button class="btn btn-primary-glass" @onclick="CreateDraft">Entwurf anlegen</button>
            }
            else
            {
                <button class="btn btn-success-glass" @onclick="PublishDraft">Entwurf veröffentlichen</button>
            }
        </div>
        <p class="text-muted mt-2 mb-0">
            Ein veröffentlichter Katalog wird nie mehr verändert. Ein neuer Entwurf startet als Kopie der
            veröffentlichten Version; laufende Phasen behalten die Version, die beim Öffnen eingefroren wurde.
        </p>
    </div>

    @if (draft != null)
    {
        <h3 class="mt-4">Entwurf bearbeiten</h3>

        @if (questions.Count == 0)
        {
            <div class="alert alert-warning-glass" role="alert">
                Der Entwurf enthält noch keine Fragen.
            </div>
        }

        @for (var index = 0; index < questions.Count; index++)
        {
            var question = questions[index];
            var currentIndex = index;

            <div class="glass-card mt-3 p-3">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <h5 class="mb-0">Frage @(index + 1)</h5>
                    <div class="d-flex flex-wrap gap-2">
                        <button class="btn btn-secondary-glass btn-sm" disabled="@(currentIndex == 0)"
                                @onclick="() => MoveQuestion(currentIndex, -1)">Hoch</button>
                        <button class="btn btn-secondary-glass btn-sm" disabled="@(currentIndex == questions.Count - 1)"
                                @onclick="() => MoveQuestion(currentIndex, 1)">Runter</button>
                        <button class="btn btn-danger-glass btn-sm" @onclick="() => DeleteQuestion(question)">Löschen</button>
                    </div>
                </div>

                <div class="row g-2">
                    <div class="col-12 col-md-8">
                        <label class="form-label">Fragetext</label>
                        <input class="form-control glassy-input" @bind="question.Text"/>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label">Typ</label>
                        <select class="form-select glassy-input" @bind="question.Type">
                            @foreach (var type in Enum.GetValues<TeamApplicationQuestionType>())
                            {
                                <option value="@type">@TypeLabel(type)</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Hilfetext (optional)</label>
                        <input class="form-control glassy-input" @bind="question.Description"/>
                    </div>
                </div>

                <div class="form-check mt-3">
                    <input class="form-check-input" type="checkbox" id="req-@question.QuestionId" @bind="question.Required"/>
                    <label class="form-check-label" for="req-@question.QuestionId">Pflichtfeld</label>
                </div>

                @if (question.SupportsLength)
                {
                    <div class="row g-2 mt-2">
                        <div class="col-6">
                            <label class="form-label">Minimale Länge</label>
                            <input type="number" min="0" class="form-control glassy-input" @bind="question.MinLength"/>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Maximale Länge</label>
                            <input type="number" min="0" class="form-control glassy-input" @bind="question.MaxLength"/>
                        </div>
                    </div>
                }

                @if (question.SupportsRange)
                {
                    <div class="row g-2 mt-2">
                        <div class="col-6">
                            <label class="form-label">Kleinster Wert</label>
                            <input type="number" class="form-control glassy-input" @bind="question.MinValue"/>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Größter Wert</label>
                            <input type="number" class="form-control glassy-input" @bind="question.MaxValue"/>
                        </div>
                    </div>
                }

                @if (question.IsChoice)
                {
                    <div class="mt-3">
                        <label class="form-label">Optionen</label>
                        @for (var optionIndex = 0; optionIndex < question.Options.Count; optionIndex++)
                        {
                            var current = optionIndex;
                            <div class="d-flex gap-2 mb-2">
                                <input class="form-control glassy-input" @bind="question.Options[current]"/>
                                <button class="btn btn-danger-glass btn-sm"
                                        @onclick="() => question.Options.RemoveAt(current)">Entfernen</button>
                            </div>
                        }
                        <button class="btn btn-secondary-glass btn-sm" @onclick="() => question.Options.Add(string.Empty)">
                            Option hinzufügen
                        </button>
                    </div>
                }

                @if (question.SupportsSelectionLimits)
                {
                    <div class="row g-2 mt-2">
                        <div class="col-6">
                            <label class="form-label">Mindestens auswählen</label>
                            <input type="number" min="0" class="form-control glassy-input" @bind="question.MinSelections"/>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Höchstens auswählen</label>
                            <input type="number" min="0" class="form-control glassy-input" @bind="question.MaxSelections"/>
                        </div>
                    </div>
                }

                <button class="btn btn-primary-glass mt-3" @onclick="() => SaveQuestion(question)">Frage speichern</button>
            </div>
        }

        <button class="btn btn-primary-glass mt-3" @onclick="AddQuestion">Frage hinzufügen</button>
    }

    @if (published != null)
    {
        <div class="glass-card mt-4 p-3">
            <h3>Veröffentlichte Version @published.Version</h3>
            <p class="text-muted">Schreibgeschützt. Änderungen laufen über einen neuen Entwurf.</p>
            <ul class="list-group list-group-flush">
                @foreach (var question in publishedQuestions)
                {
                    <li class="list-group-item">
                        <strong>@question.Text</strong>
                        <span class="text-muted"> (@TypeLabel(question.Type)@(question.Required ? ", Pflicht" : ""))</span>
                    </li>
                }
            </ul>
        </div>
    }
}

@code {
    [Parameter] public string PositionId { get; set; } = "";

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private ClaimsPrincipal? _principal;
    private ulong userId;

    private bool loaded;
    private bool mayManage;
    private string statusMessage = "";

    private TeamApplicationPosition? position;
    private TeamApplicationQuestionSet? draft;
    private TeamApplicationQuestionSet? published;
    private List<TeamApplicationQuestion> questions = new();
    private List<TeamApplicationQuestion> publishedQuestions = new();

    protected override async Task OnInitializedAsync()
    {
        _principal = AuthState is null ? null : (await AuthState).User;
        userId = UserService.GetUserId(_principal) ?? 0;

        mayManage = await TeamApplicationPermissionService.HasAsync(userId,
            TeamApplicationPermission.ManageQuestions, PositionId);

        if (mayManage) await LoadAll();
        loaded = true;
    }

    private async Task LoadAll()
    {
        position = await TeamApplicationService.GetPositionAsync(PositionId);
        if (position == null) return;

        draft = await TeamApplicationService.GetDraftAsync(PositionId);
        published = await TeamApplicationService.GetPublishedAsync(PositionId);

        questions = draft == null
            ? new List<TeamApplicationQuestion>()
            : await TeamApplicationService.GetQuestionsAsync(PositionId, draft.Version);
        publishedQuestions = published == null
            ? new List<TeamApplicationQuestion>()
            : await TeamApplicationService.GetQuestionsAsync(PositionId, published.Version);
    }

    private static string TypeLabel(TeamApplicationQuestionType type) => type switch
    {
        TeamApplicationQuestionType.ShortText => "Freitext kurz",
        TeamApplicationQuestionType.LongText => "Freitext lang",
        TeamApplicationQuestionType.SingleChoice => "Single Choice",
        TeamApplicationQuestionType.MultipleChoice => "Multiple Choice",
        TeamApplicationQuestionType.Number => "Zahl / Skala",
        _ => type.ToString()
    };

    private async Task<bool> EnsurePermission()
    {
        if (await TeamApplicationPermissionService.HasAsync(userId, TeamApplicationPermission.ManageQuestions,
                PositionId)) return true;

        statusMessage = "Keine Berechtigung.";
        return false;
    }

    private async Task CreateDraft()
    {
        if (!await EnsurePermission()) return;

        await TeamApplicationService.CreateDraftAsync(PositionId, userId);
        await LoadAll();
        statusMessage = "Entwurf angelegt.";
    }

    private async Task PublishDraft()
    {
        if (!await EnsurePermission()) return;

        if (questions.Count == 0)
        {
            statusMessage = "Ein leerer Katalog kann nicht veröffentlicht werden.";
            return;
        }

        var invalid = questions.FirstOrDefault(q => string.IsNullOrWhiteSpace(q.Text) ||
                                                    (q.IsChoice && q.Options.Count(o => !string.IsNullOrWhiteSpace(o)) < 2));
        if (invalid != null)
        {
            statusMessage = "Jede Frage braucht einen Text, Auswahlfragen brauchen mindestens zwei Optionen.";
            return;
        }

        await TeamApplicationService.PublishDraftAsync(PositionId);
        await LoadAll();
        statusMessage = "Entwurf veröffentlicht.";
    }

    private async Task AddQuestion()
    {
        if (draft == null || !await EnsurePermission()) return;

        var question = new TeamApplicationQuestion
        {
            PositionId = PositionId,
            Version = draft.Version,
            SortOrder = questions.Count == 0 ? 0 : questions.Max(q => q.SortOrder) + 1,
            Text = "Neue Frage"
        };

        await TeamApplicationService.UpsertQuestionAsync(question);
        questions.Add(question);
        statusMessage = "Frage hinzugefügt.";
    }

    private async Task SaveQuestion(TeamApplicationQuestion question)
    {
        if (!await EnsurePermission()) return;

        question.Options = question.Options.Where(o => !string.IsNullOrWhiteSpace(o)).ToList();

        await TeamApplicationService.UpsertQuestionAsync(question);
        statusMessage = "Frage gespeichert.";
    }

    private async Task DeleteQuestion(TeamApplicationQuestion question)
    {
        if (!await EnsurePermission()) return;

        await TeamApplicationService.DeleteQuestionAsync(question.QuestionId);
        questions.Remove(question);
        await PersistOrder();
        statusMessage = "Frage gelöscht.";
    }

    private async Task MoveQuestion(int index, int offset)
    {
        if (!await EnsurePermission()) return;

        var target = index + offset;
        if (target < 0 || target >= questions.Count) return;

        (questions[index], questions[target]) = (questions[target], questions[index]);
        await PersistOrder();
    }

    private async Task PersistOrder()
    {
        for (var i = 0; i < questions.Count; i++)
        {
            questions[i].SortOrder = i;
            await TeamApplicationService.UpsertQuestionAsync(questions[i]);
        }
    }
}
