@page "/konfiguration/applysystem/questions/{PositionId}"
@using AGC_Management.Controller
@using AGC_Management.Entities.ApplicationSystem
@using AGC_Management.Enums.ApplicationSystem
@using AGC_Management.Services
@implements IDisposable
@inject UserService UserService
@inject ToastService ToastService
@inject UnsavedChangesTracker Tracker
@attribute [Authorize(Roles = "BotOwner, Administrator, HeadModerator, Moderator, Supporter, HeadEventmanager, Team")]

<PageHeader Title="Fragenkatalog"
            Lead="@(position?.PositionName)"
            BackHref="/konfiguration/applysystem/positions" BackText="Positionen"/>

@if (!loaded)
{
    <StateBlock Kind="StateBlock.StateKind.Loading"
                Title="Fragenkatalog wird geladen"
                Description="Entwurf, veröffentlichte Version und deine Rechte werden abgefragt."/>
}
else if (!mayManage)
{
    <StateBlock Kind="StateBlock.StateKind.Error"
                Title="Keine Berechtigung"
                Description="Den Fragenkatalog dieser Position darfst du nicht bearbeiten. Rechte vergibt ein Administrator in der Rechte-Matrix."
                ActionText="Zu den Positionen" ActionHref="/konfiguration/applysystem/positions"/>
}
else if (position == null)
{
    <StateBlock Kind="StateBlock.StateKind.Error"
                Title="Position nicht gefunden"
                Description="Diese Position existiert nicht, oder sie wurde gelöscht."
                ActionText="Zu den Positionen" ActionHref="/konfiguration/applysystem/positions"/>
}
else
{
    <Panel Title="Versionen"
           Lead="Eine veröffentlichte Version wird nie mehr verändert. Laufende Phasen behalten die Version, die beim Öffnen eingefroren wurde.">
        <dl class="facts">
            <dt>Veröffentlicht</dt>
            <dd>@(published != null ? $"Version {published.Version}" : "keine")</dd>
            <dt>Entwurf</dt>
            <dd>@(draft != null ? $"Version {draft.Version}" : "keiner")</dd>
        </dl>
        <div class="form-foot">
            @if (draft == null)
            {
                <button type="button" class="btn btn-primary" @onclick="CreateDraft">Entwurf anlegen</button>
                @if (published != null)
                {
                    <span class="meta">Der Entwurf startet als Kopie der veröffentlichten Version.</span>
                }
            }
            else
            {
                <button type="button" class="btn btn-primary" @onclick="PublishDraft">Entwurf veröffentlichen</button>
            }
        </div>
    </Panel>

    @if (draft != null)
    {
        <div class="section-title-row">
            <h2 class="section-title">Entwurf, Version @draft.Version</h2>
            @if (questions.Count > 0)
            {
                <a class="btn btn-ghost btn-sm" href="/konfiguration/applysystem/questions/@PositionId/preview/@draft.Version">
                    Vorschau
                </a>
            }
        </div>

        @if (questions.Count == 0)
        {
            <StateBlock Title="Der Entwurf hat noch keine Fragen"
                        Description="Veröffentlichen geht erst mit mindestens einer Frage."
                        ActionText="Frage hinzufügen"
                        OnAction="AddQuestion"/>
        }

        @for (var index = 0; index < TopLevelQuestions.Count; index++)
        {
            var topLevelQuestions = TopLevelQuestions;
            var question = topLevelQuestions[index];
            var currentIndex = index;

            <QuestionEditor Question="question"
                             Title="@($"Frage {index + 1}")"
                             CanMoveUp="@(currentIndex > 0)"
                             CanMoveDown="@(currentIndex < topLevelQuestions.Count - 1)"
                             EligibleTriggers="@EligibleTriggers(question)"
                             OnFieldChanged="OnFieldChanged"
                             OnDelete="() => DeleteQuestion(question)"
                             OnMoveUp="() => MoveQuestion(question, -1)"
                             OnMoveDown="() => MoveQuestion(question, 1)"
                             OnConditionChanged="() => OnConditionChanged(question)"
                             OnAddFollowUp="() => AddFollowUpQuestion(question)">
                <FollowUps>
                    @foreach (var followUp in FollowUpsOf(question))
                    {
                        <QuestionEditor Question="followUp"
                                         Nested="true"
                                         Title="Folgefrage"
                                         Lead="@ConditionLead(followUp)"
                                         EligibleTriggers="@EligibleTriggers(followUp)"
                                         OnFieldChanged="OnFieldChanged"
                                         OnDelete="() => DeleteQuestion(followUp)"
                                         OnConditionChanged="() => OnConditionChanged(followUp)"/>
                    }
                </FollowUps>
            </QuestionEditor>
        }

        @if (questions.Count > 0)
        {
            <button type="button" class="btn btn-secondary mt-3" @onclick="AddQuestion">Frage hinzufügen</button>
        }
    }

    @if (published != null)
    {
        <div class="section-title-row">
            <h2 class="section-title">Veröffentlicht, Version @published.Version</h2>
            <a class="btn btn-ghost btn-sm" href="/konfiguration/applysystem/questions/@PositionId/preview/@published.Version">
                Vorschau
            </a>
        </div>
        <Panel Flush="true">
            <ul class="rows">
                @foreach (var question in publishedQuestions)
                {
                    <li>
                        <div class="rows__main">
                            <p class="rows__title">@question.Text</p>
                            <p class="rows__text">@TypeLabel(question.Type)@(question.Required ? " · Pflicht" : "")</p>
                        </div>
                    </li>
                }
            </ul>
        </Panel>
    }
}

@code {
    [Parameter] public string PositionId { get; set; } = "";

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private ClaimsPrincipal? _principal;
    private ulong userId;

    private bool loaded;
    private bool mayManage;

    private TeamApplicationPosition? position;
    private TeamApplicationQuestionSet? draft;
    private TeamApplicationQuestionSet? published;
    private List<TeamApplicationQuestion> questions = new();
    private List<TeamApplicationQuestion> publishedQuestions = new();

    // Last DB-persisted state per question, keyed by id; SaveAllQuestions/Discard work against this.
    private Dictionary<string, TeamApplicationQuestion> originalQuestions = new();

    protected override async Task OnInitializedAsync()
    {
        _principal = AuthState is null ? null : (await AuthState).User;
        userId = UserService.GetUserId(_principal) ?? 0;

        mayManage = await TeamApplicationPermissionService.HasAsync(userId,
            TeamApplicationPermission.ManageQuestions, PositionId);

        if (mayManage)
        {
            await LoadAll();
            RebuildSnapshot();
            Tracker.Register(SaveAllQuestions, Discard);
        }

        loaded = true;
    }

    public void Dispose() => Tracker.Unregister();

    private async Task LoadAll()
    {
        position = await TeamApplicationService.GetPositionAsync(PositionId);
        if (position == null) return;

        draft = await TeamApplicationService.GetDraftAsync(PositionId);
        published = await TeamApplicationService.GetPublishedAsync(PositionId);

        questions = draft == null
            ? new List<TeamApplicationQuestion>()
            : await TeamApplicationService.GetQuestionsAsync(PositionId, draft.Version);
        publishedQuestions = published == null
            ? new List<TeamApplicationQuestion>()
            : await TeamApplicationService.GetQuestionsAsync(PositionId, published.Version);
    }

    private static string TypeLabel(TeamApplicationQuestionType type) => type switch
    {
        TeamApplicationQuestionType.ShortText => "Freitext kurz",
        TeamApplicationQuestionType.LongText => "Freitext lang",
        TeamApplicationQuestionType.SingleChoice => "Einfachauswahl",
        TeamApplicationQuestionType.MultipleChoice => "Mehrfachauswahl",
        TeamApplicationQuestionType.Number => "Zahl",
        TeamApplicationQuestionType.Date => "Datum",
        TeamApplicationQuestionType.Dropdown => "Dropdown-Auswahl",
        _ => type.ToString()
    };

    // A follow-up can't itself be a trigger, which keeps nesting to exactly one level.
    private static bool IsTopLevel(TeamApplicationQuestion question) =>
        string.IsNullOrEmpty(question.ConditionQuestionId);

    private List<TeamApplicationQuestion> TopLevelQuestions => questions.Where(IsTopLevel).ToList();

    private List<TeamApplicationQuestion> EligibleTriggers(TeamApplicationQuestion current) =>
        questions.Where(q => q.QuestionId != current.QuestionId && IsTopLevel(q) && q.IsChoice).ToList();

    private IEnumerable<TeamApplicationQuestion> FollowUpsOf(TeamApplicationQuestion trigger) =>
        questions.Where(q => q.ConditionQuestionId == trigger.QuestionId);

    private string? ConditionLead(TeamApplicationQuestion followUp)
    {
        if (string.IsNullOrEmpty(followUp.ConditionValue)) return null;
        var trigger = questions.FirstOrDefault(q => q.QuestionId == followUp.ConditionQuestionId);
        return trigger == null ? null : $"Erscheint, wenn „{trigger.Text}“ mit „{followUp.ConditionValue}“ beantwortet wird.";
    }

    private void OnConditionChanged(TeamApplicationQuestion question)
    {
        // Only top-level questions can be triggers, so orphan (not delete) anything that
        // depended on this one now that it's become a follow-up itself.
        if (!string.IsNullOrEmpty(question.ConditionQuestionId))
        {
            var orphaned = questions.Where(q => q.ConditionQuestionId == question.QuestionId).ToList();
            foreach (var q in orphaned)
            {
                q.ConditionQuestionId = "";
                q.ConditionValue = "";
            }
        }

        OnFieldChanged();
    }

    private static TeamApplicationQuestion CloneQuestion(TeamApplicationQuestion source) => new()
    {
        QuestionId = source.QuestionId,
        PositionId = source.PositionId,
        Version = source.Version,
        SortOrder = source.SortOrder,
        Type = source.Type,
        Text = source.Text,
        Description = source.Description,
        Required = source.Required,
        MinLength = source.MinLength,
        MaxLength = source.MaxLength,
        MinValue = source.MinValue,
        MaxValue = source.MaxValue,
        Options = new List<string>(source.Options),
        MinSelections = source.MinSelections,
        MaxSelections = source.MaxSelections,
        ConditionQuestionId = source.ConditionQuestionId,
        ConditionValue = source.ConditionValue
    };

    // Copies every editable field except identity/sort - used by Discard to revert in place
    // without breaking the @for loop's object references.
    private static void CopyEditableFields(TeamApplicationQuestion target, TeamApplicationQuestion source)
    {
        target.Type = source.Type;
        target.Text = source.Text;
        target.Description = source.Description;
        target.Required = source.Required;
        target.MinLength = source.MinLength;
        target.MaxLength = source.MaxLength;
        target.MinValue = source.MinValue;
        target.MaxValue = source.MaxValue;
        target.Options = new List<string>(source.Options);
        target.MinSelections = source.MinSelections;
        target.MaxSelections = source.MaxSelections;
        target.ConditionQuestionId = source.ConditionQuestionId;
        target.ConditionValue = source.ConditionValue;
    }

    private void RebuildSnapshot() => originalQuestions = questions.ToDictionary(q => q.QuestionId, CloneQuestion);

    private void OnFieldChanged() => Tracker.MarkDirty();

    private async Task<bool> EnsurePermission()
    {
        if (await TeamApplicationPermissionService.HasAsync(userId, TeamApplicationPermission.ManageQuestions,
                PositionId)) return true;

        ToastService.Notify("Dafür fehlt dir die Berechtigung.", "bad");
        return false;
    }

    private async Task CreateDraft()
    {
        if (!await EnsurePermission()) return;

        await TeamApplicationService.CreateDraftAsync(PositionId, userId);
        await LoadAll();
        RebuildSnapshot();
        ToastService.Notify("Entwurf angelegt.", "ok");
    }

    private async Task PublishDraft()
    {
        if (!await EnsurePermission()) return;

        if (questions.Count == 0)
        {
            ToastService.Notify("Ein leerer Katalog kann nicht veröffentlicht werden.", "bad");
            return;
        }

        var invalid = questions.FirstOrDefault(q => string.IsNullOrWhiteSpace(q.Text) ||
                                                    (q.IsChoice && q.Options.Count(o => !string.IsNullOrWhiteSpace(o)) < 2));
        if (invalid != null)
        {
            ToastService.Notify("Jede Frage braucht einen Text, Auswahlfragen brauchen mindestens zwei Optionen.", "bad");
            return;
        }

        var invalidCondition = questions.FirstOrDefault(q =>
            !string.IsNullOrEmpty(q.ConditionQuestionId) && string.IsNullOrEmpty(q.ConditionValue));
        if (invalidCondition != null)
        {
            ToastService.Notify("Bei einer bedingten Frage muss auch ein Wert gewählt sein.", "bad");
            return;
        }

        var invalidRange = questions.FirstOrDefault(q =>
            q.Type == TeamApplicationQuestionType.Number && q.NumberDisplay != NumberDisplay.Text &&
            q.MaxValue <= q.MinValue);
        if (invalidRange != null)
        {
            ToastService.Notify("Schieberegler und Dropdown brauchen einen gültigen Wertebereich (größter Wert über kleinstem Wert).", "bad");
            return;
        }

        await TeamApplicationService.PublishDraftAsync(PositionId);
        await LoadAll();
        RebuildSnapshot();
        ToastService.Notify("Entwurf veröffentlicht.", "ok");
    }

    private async Task AddQuestion()
    {
        if (draft == null || !await EnsurePermission()) return;

        var question = new TeamApplicationQuestion
        {
            PositionId = PositionId,
            Version = draft.Version,
            SortOrder = questions.Count == 0 ? 0 : questions.Max(q => q.SortOrder) + 1,
            Text = "Neue Frage"
        };

        await TeamApplicationService.UpsertQuestionAsync(question);
        questions.Add(question);
        originalQuestions[question.QuestionId] = CloneQuestion(question);
        ToastService.Notify("Frage hinzugefügt.", "ok");
    }

    private async Task AddFollowUpQuestion(TeamApplicationQuestion trigger)
    {
        if (draft == null || !await EnsurePermission()) return;

        var question = new TeamApplicationQuestion
        {
            PositionId = PositionId,
            Version = draft.Version,
            SortOrder = questions.Count == 0 ? 0 : questions.Max(q => q.SortOrder) + 1,
            Text = "Neue Folgefrage",
            ConditionQuestionId = trigger.QuestionId,
            ConditionValue = trigger.Options.FirstOrDefault(o => !string.IsNullOrWhiteSpace(o)) ?? ""
        };

        await TeamApplicationService.UpsertQuestionAsync(question);
        questions.Add(question);
        originalQuestions[question.QuestionId] = CloneQuestion(question);
        ToastService.Notify("Folgefrage hinzugefügt.", "ok");
    }

    private async Task SaveAllQuestions()
    {
        if (!await EnsurePermission()) return;

        foreach (var question in questions)
            question.Options = question.Options.Where(o => !string.IsNullOrWhiteSpace(o)).ToList();

        foreach (var question in questions)
            await TeamApplicationService.UpsertQuestionAsync(question);

        RebuildSnapshot();
        ToastService.Notify("Fragen gespeichert.", "ok");
    }

    // Runs from the UnsavedChangesBar component, so it has to drive its own re-render.
    private void Discard()
    {
        foreach (var question in questions)
        {
            if (originalQuestions.TryGetValue(question.QuestionId, out var original))
                CopyEditableFields(question, original);
        }

        StateHasChanged();
    }

    private async Task DeleteQuestion(TeamApplicationQuestion question)
    {
        if (!await EnsurePermission()) return;

        await TeamApplicationService.DeleteQuestionAsync(question.QuestionId);
        questions.Remove(question);
        originalQuestions.Remove(question.QuestionId);

        // Don't leave dangling references to a question that no longer exists.
        var orphaned = questions.Where(q => q.ConditionQuestionId == question.QuestionId).ToList();
        foreach (var q in orphaned)
        {
            q.ConditionQuestionId = "";
            q.ConditionValue = "";
        }
        if (orphaned.Count > 0) Tracker.MarkDirty();

        await PersistOrder();
        ToastService.Notify("Frage gelöscht.", "ok");
    }

    // Moves among top-level siblings only - a follow-up stays wherever it sits in the flat list,
    // since it's rendered by lookup (FollowUpsOf) rather than by position.
    private async Task MoveQuestion(TeamApplicationQuestion question, int offset)
    {
        if (!await EnsurePermission()) return;

        var topLevel = questions.Where(IsTopLevel).ToList();
        var pos = topLevel.IndexOf(question);
        var targetPos = pos + offset;
        if (targetPos < 0 || targetPos >= topLevel.Count) return;

        var a = questions.IndexOf(question);
        var b = questions.IndexOf(topLevel[targetPos]);
        (questions[a], questions[b]) = (questions[b], questions[a]);
        await PersistOrder();
    }

    // Reordering only ever touches sort_order in the DB - it must never carry along whatever a
    // still-unsaved field edit currently holds, so it upserts a clone of the last-saved content
    // (not the live, possibly-dirty, object) with just the new sort order.
    private async Task PersistOrder()
    {
        for (var i = 0; i < questions.Count; i++)
        {
            questions[i].SortOrder = i;

            var persisted = originalQuestions.TryGetValue(questions[i].QuestionId, out var original)
                ? CloneQuestion(original)
                : CloneQuestion(questions[i]);
            persisted.SortOrder = i;

            await TeamApplicationService.UpsertQuestionAsync(persisted);

            if (originalQuestions.TryGetValue(questions[i].QuestionId, out var snapshot))
                snapshot.SortOrder = i;
        }
    }
}
