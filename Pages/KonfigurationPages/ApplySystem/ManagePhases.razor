@page "/konfiguration/applysystem/phases/{PositionId}"
@using AGC_Management.ApplicationSystem
@using AGC_Management.Controller
@using AGC_Management.Entities.ApplicationSystem
@using AGC_Management.Enums.ApplicationSystem
@using AGC_Management.Services
@using AGC_Management.Utils
@inject UserService UserService
@attribute [Authorize(Roles = "BotOwner, Administrator, HeadModerator, Moderator, Supporter, HeadEventmanager, Team")]

<PageHeader Title="Bewerbungsphasen"
            Lead="@(position?.PositionName)"
            BackHref="/konfiguration/applysystem/positions" BackText="Positionen"/>

@if (!loaded)
{
    <StateBlock Kind="StateBlock.StateKind.Loading"
                Title="Phasen werden geladen"
                Description="Phasen, veröffentlichter Fragenkatalog und deine Rechte werden abgefragt."/>
}
else if (!mayManage)
{
    <StateBlock Kind="StateBlock.StateKind.Error"
                Title="Keine Berechtigung"
                Description="Die Phasen dieser Position darfst du nicht verwalten. Rechte vergibt ein Administrator in der Rechte-Matrix."
                ActionText="Zu den Positionen" ActionHref="/konfiguration/applysystem/positions"/>
}
else if (position == null)
{
    <StateBlock Kind="StateBlock.StateKind.Error"
                Title="Position nicht gefunden"
                Description="Diese Position existiert nicht, oder sie wurde gelöscht."
                ActionText="Zu den Positionen" ActionHref="/konfiguration/applysystem/positions"/>
}
else
{
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="notice notice--@statusTone mb-3" role="status">@statusMessage</div>
    }

    @if (published == null)
    {
        @* The old page stated this and offered no way out, although the route existed. *@
        <div class="notice notice--warn mb-3">
            <p class="notice__title">Noch kein Fragenkatalog veröffentlicht</p>
            <p>Eine Phase lässt sich erst öffnen, wenn für diese Position ein veröffentlichter Fragenkatalog existiert.</p>
            <a class="btn btn-secondary btn-sm mt-2" href="/konfiguration/applysystem/questions/@PositionId">Fragenkatalog öffnen</a>
        </div>
    }

    @if (phases.Count == 0)
    {
        <StateBlock Title="Noch keine Phase angelegt"
                    Description="Eine Phase ist eine Bewerbungsrunde. Lege die erste im Formular darunter an."/>
    }

    @foreach (var phase in phases)
    {
        <Panel Title="@(string.IsNullOrWhiteSpace(phase.Name) ? "Unbenannte Phase" : phase.Name)"
               Lead="@(phase.QuestionSetVersion > 0 ? $"Fragenkatalog Version {phase.QuestionSetVersion} eingefroren" : "Noch nie geöffnet")">
            <Actions>
                <StatusPill Text="@StateLabel(phase.State)" Tone="@StateTone(phase.State)"/>
            </Actions>
            <ChildContent>
                <div class="field-grid">
                    <div class="field">
                        <label class="field__label" for="p-name-@phase.PhaseId">Name</label>
                        <input id="p-name-@phase.PhaseId" class="form-control" @bind="phase.Name"
                               disabled="@(phase.State != TeamApplicationPhaseState.Draft)"/>
                    </div>
                    <div class="field">
                        <label class="field__label" for="p-open-@phase.PhaseId">Öffnet am (optional)</label>
                        <input id="p-open-@phase.PhaseId" type="datetime-local" class="form-control"
                               value="@ToLocalInput(phase.OpensAt)"
                               @onchange="e => phase.OpensAt = FromLocalInput(e.Value?.ToString())"
                               disabled="@(phase.State != TeamApplicationPhaseState.Draft)"/>
                    </div>
                    <div class="field">
                        <label class="field__label" for="p-close-@phase.PhaseId">Schließt am (optional)</label>
                        <input id="p-close-@phase.PhaseId" type="datetime-local" class="form-control"
                               value="@ToLocalInput(phase.ClosesAt)"
                               @onchange="e => phase.ClosesAt = FromLocalInput(e.Value?.ToString())"
                               disabled="@(phase.State == TeamApplicationPhaseState.Archived)"/>
                    </div>
                </div>

                @if (phase.State != TeamApplicationPhaseState.Archived)
                {
                    <div class="form-foot">
                        <button type="button" class="btn btn-secondary" @onclick="() => SaveSchedule(phase)">Termine speichern</button>

                        @if (phase.State == TeamApplicationPhaseState.Draft)
                        {
                            <button type="button" class="btn btn-secondary" disabled="@(published == null)"
                                    @onclick="() => OpenPhase(phase)">Jetzt öffnen</button>
                        }
                        @if (phase.State == TeamApplicationPhaseState.Open)
                        {
                            <button type="button" class="btn btn-secondary" @onclick="() => RequestClose(phase, false)">Schließen</button>
                        }
                        @if (phase.State == TeamApplicationPhaseState.Closed)
                        {
                            <button type="button" class="btn btn-secondary" @onclick="() => OpenPhase(phase)">Wieder öffnen</button>
                            <button type="button" class="btn btn-danger ms-auto" @onclick="() => RequestClose(phase, true)">
                                Endgültig schließen
                            </button>
                        }
                    </div>
                }

                @* The confirmation sits in the phase it belongs to - it used to appear at the
                   top of the page, far away from the button that triggered it. *@
                @if (pendingPhase?.PhaseId == phase.PhaseId)
                {
                    <ConfirmInline Title="@(pendingArchive ? "Phase endgültig schließen?" : "Phase schließen?")"
                                   ConfirmText="@(pendingArchive ? "Ja, endgültig schließen" : "Schließen")"
                                   OnConfirm="ConfirmPending"
                                   OnCancel="() => pendingPhase = null">
                        @if (pendingUndecided > 0)
                        {
                            <p>@pendingUndecided Bewerbungen sind noch unentschieden. Sie bleiben in jedem Fall entscheidbar.</p>
                        }
                        <p>
                            @(pendingArchive
                                ? "Das lässt sich nicht rückgängig machen: die Phase kann danach nicht mehr geöffnet werden."
                                : "Es gehen keine neuen Bewerbungen mehr ein. Die Phase lässt sich jederzeit wieder öffnen.")
                        </p>
                    </ConfirmInline>
                }
            </ChildContent>
        </Panel>
    }

    <h2 class="section-title">Neue Phase</h2>
    <Panel>
        <div class="field-grid">
            <div class="field">
                <label class="field__label" for="new-phase-name">Name</label>
                <input id="new-phase-name" class="form-control" @bind="newName" placeholder="Name der Runde"/>
            </div>
            <div class="field">
                <label class="field__label" for="new-phase-open">Öffnet am (optional)</label>
                <input id="new-phase-open" type="datetime-local" class="form-control"
                       value="@ToLocalInput(newOpensAt)"
                       @onchange="e => newOpensAt = FromLocalInput(e.Value?.ToString())"/>
            </div>
            <div class="field">
                <label class="field__label" for="new-phase-close">Schließt am (optional)</label>
                <input id="new-phase-close" type="datetime-local" class="form-control"
                       value="@ToLocalInput(newClosesAt)"
                       @onchange="e => newClosesAt = FromLocalInput(e.Value?.ToString())"/>
            </div>
        </div>
        <div class="form-foot">
            <button type="button" class="btn btn-primary" @onclick="CreatePhase">Phase anlegen</button>
            <span class="meta">Ohne Termine wird die Phase nur von Hand geöffnet und geschlossen.</span>
        </div>
    </Panel>
}

@code {
    [Parameter] public string PositionId { get; set; } = "";

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private ClaimsPrincipal? _principal;
    private ulong userId;

    private bool loaded;
    private bool mayManage;
    private string statusMessage = "";
    private string statusTone = "ok";

    private TeamApplicationPosition? position;
    private TeamApplicationQuestionSet? published;
    private List<TeamApplicationPhase> phases = new();

    private TeamApplicationPhase? pendingPhase;
    private bool pendingArchive;
    private int pendingUndecided;

    private string newName = "";
    private long newOpensAt;
    private long newClosesAt;

    protected override async Task OnInitializedAsync()
    {
        _principal = AuthState is null ? null : (await AuthState).User;
        userId = UserService.GetUserId(_principal) ?? 0;

        mayManage = await TeamApplicationPermissionService.HasAsync(userId, TeamApplicationPermission.ManagePhases,
            PositionId);

        if (mayManage) await LoadAll();
        loaded = true;
    }

    private async Task LoadAll()
    {
        position = await TeamApplicationService.GetPositionAsync(PositionId);
        if (position == null) return;

        published = await TeamApplicationService.GetPublishedAsync(PositionId);
        phases = await TeamApplicationService.GetPhasesAsync(PositionId);
    }

    private static string StateLabel(TeamApplicationPhaseState state) => state switch
    {
        TeamApplicationPhaseState.Draft => "Entwurf",
        TeamApplicationPhaseState.Open => "Offen",
        TeamApplicationPhaseState.Closed => "Geschlossen",
        TeamApplicationPhaseState.Archived => "Endgültig geschlossen",
        _ => state.ToString()
    };

    /// <summary>Only an open phase is a live state worth signalling; the rest are neutral.</summary>
    private static StatusPill.PillTone StateTone(TeamApplicationPhaseState state) =>
        state == TeamApplicationPhaseState.Open ? StatusPill.PillTone.Ok : StatusPill.PillTone.Neutral;

    /// <summary>The inputs work in server local time, the same frame the rest of the dashboard renders in.</summary>
    private static string ToLocalInput(long unix)
    {
        if (unix <= 0) return "";

        var utc = DateTimeOffset.FromUnixTimeSeconds(unix).UtcDateTime;
        return TimeZoneInfo.ConvertTimeFromUtc(utc, TimeZoneInfo.Local).ToString("yyyy-MM-ddTHH:mm");
    }

    private static long FromLocalInput(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return 0;
        if (!DateTime.TryParse(value, out var local)) return 0;

        var utc = TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(local, DateTimeKind.Unspecified),
            TimeZoneInfo.Local);
        return new DateTimeOffset(utc, TimeSpan.Zero).ToUnixTimeSeconds();
    }

    private void Say(string message, string tone)
    {
        statusMessage = message;
        statusTone = tone;
    }

    private async Task<bool> EnsurePermission()
    {
        if (await TeamApplicationPermissionService.HasAsync(userId, TeamApplicationPermission.ManagePhases,
                PositionId)) return true;

        Say("Dafür fehlt dir die Berechtigung.", "bad");
        return false;
    }

    private async Task CreatePhase()
    {
        if (!await EnsurePermission()) return;

        if (string.IsNullOrWhiteSpace(newName))
        {
            Say("Bitte einen Namen angeben.", "bad");
            return;
        }

        await TeamApplicationService.CreatePhaseAsync(PositionId, newName.Trim(), newOpensAt, newClosesAt, userId);
        newName = "";
        newOpensAt = 0;
        newClosesAt = 0;
        await LoadAll();
        Say("Phase angelegt.", "ok");
    }

    private async Task SaveSchedule(TeamApplicationPhase phase)
    {
        if (!await EnsurePermission()) return;

        await TeamApplicationService.UpdatePhaseScheduleAsync(phase.PhaseId, phase.Name, phase.OpensAt,
            phase.ClosesAt);
        ApplyPanelCommands.QueueRefreshPanel();
        Say("Termine gespeichert.", "ok");
    }

    private async Task OpenPhase(TeamApplicationPhase phase)
    {
        if (!await EnsurePermission()) return;

        var reopened = phase.State == TeamApplicationPhaseState.Closed;
        var hadExpiredEnd = phase.ClosesAt > 0 &&
                            phase.ClosesAt <= DateTimeOffset.UtcNow.ToUnixTimeSeconds();

        var result = await TeamApplicationService.OpenPhaseAsync(phase.PhaseId);
        if (result != TeamApplicationPhaseOpenResult.Opened)
        {
            Say(OpenResultMessage(result), "bad");
            return;
        }

        ApplyPanelCommands.QueueRefreshPanel();
        await LoadAll();

        var message = reopened ? "Phase wieder geöffnet." : "Phase geöffnet.";
        if (reopened && hadExpiredEnd)
            message += " Der abgelaufene Endtermin wurde entfernt, sonst hätte der Hintergrund-Task " +
                       "die Phase sofort wieder geschlossen.";
        Say(message, "ok");
    }

    private static string OpenResultMessage(TeamApplicationPhaseOpenResult result) => result switch
    {
        TeamApplicationPhaseOpenResult.NotFound => "Diese Phase existiert nicht mehr.",
        TeamApplicationPhaseOpenResult.AlreadyOpen => "Diese Phase ist bereits offen.",
        TeamApplicationPhaseOpenResult.Archived =>
            "Diese Phase wurde endgültig geschlossen und lässt sich nicht mehr öffnen.",
        TeamApplicationPhaseOpenResult.OtherPhaseOpen =>
            "Für diese Position ist bereits eine andere Phase offen. Schließe sie zuerst.",
        TeamApplicationPhaseOpenResult.NoPublishedCatalogue =>
            "Es ist kein Fragenkatalog veröffentlicht.",
        _ => "Die Phase konnte nicht geöffnet werden."
    };

    private async Task RequestClose(TeamApplicationPhase phase, bool archive)
    {
        if (!await EnsurePermission()) return;

        pendingUndecided = await TeamApplicationService.CountUndecidedAsync(phase.PhaseId);

        // Closing is reversible, so it only needs a prompt when something is still undecided.
        // Closing for good always asks.
        if (!archive && pendingUndecided == 0)
        {
            await ClosePhase(phase);
            return;
        }

        pendingArchive = archive;
        pendingPhase = phase;
    }

    private async Task ConfirmPending()
    {
        if (pendingPhase == null) return;

        var phase = pendingPhase;
        var archive = pendingArchive;
        pendingPhase = null;

        if (archive)
            await ArchivePhase(phase);
        else
            await ClosePhase(phase);
    }

    private async Task ClosePhase(TeamApplicationPhase phase)
    {
        if (!await EnsurePermission()) return;

        await TeamApplicationService.ClosePhaseAsync(phase.PhaseId);
        ApplyPanelCommands.QueueRefreshPanel();
        await LoadAll();
        Say("Phase geschlossen. Vorhandene Bewerbungen bleiben entscheidbar, die Phase lässt sich wieder öffnen.", "ok");
    }

    private async Task ArchivePhase(TeamApplicationPhase phase)
    {
        if (!await EnsurePermission()) return;

        await TeamApplicationService.ArchivePhaseAsync(phase.PhaseId);
        ApplyPanelCommands.QueueRefreshPanel();
        await LoadAll();
        Say("Phase endgültig geschlossen. Vorhandene Bewerbungen bleiben entscheidbar.", "ok");
    }
}
