@page "/konfiguration/applysystem/templates"
@using AGC_Management.Controller
@using AGC_Management.Entities.ApplicationSystem
@using AGC_Management.Enums.ApplicationSystem
@using AGC_Management.Services
@using AGC_Management.Utils
@inject UserService UserService
@attribute [Authorize(Roles = "BotOwner, Administrator, HeadModerator, Moderator, Supporter, HeadEventmanager, Team")]

<h1>Textbausteine und Bot-Texte</h1>

@if (!loaded)
{
    <div class="spinner-border" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
}
else if (!mayManage)
{
    <div class="alert alert-danger-glass mt-3" role="alert">
        Du hast keine Berechtigung, die Textbausteine zu verwalten.
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert alert-info-glass mt-2" role="alert">@statusMessage</div>
    }

    <div class="alert alert-info-glass mt-2" role="alert">
        <h4 class="alert-heading">Verfügbare Platzhalter</h4>
        <hr>
        <p class="mb-2">
            Eingebaut: @string.Join(" ", TeamApplicationTemplateResolver.BuiltIn)
        </p>
        <p class="mb-0">
            Eigene: @(placeholders.Count == 0 ? "noch keine" : string.Join(" ", placeholders.Keys.Select(k => "{" + k + "}")))
        </p>
    </div>

    <!-- Vorlagen fuer Entscheidungen -->
    <h3 class="mt-4">Vorlagen für Entscheidungen</h3>
    @foreach (var template in templates)
    {
        <div class="glass-card mt-3 p-3">
            <div class="row g-2">
                <div class="col-12 col-md-5">
                    <label class="form-label">Name</label>
                    <input class="form-control glassy-input" @bind="template.Name"/>
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label">Art</label>
                    <select class="form-select glassy-input" @bind="template.Kind">
                        <option value="@TeamApplicationTemplateKind.Accept">Zusage</option>
                        <option value="@TeamApplicationTemplateKind.Reject">Absage</option>
                    </select>
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label">Position</label>
                    <select class="form-select glassy-input" value="@(template.PositionId ?? "")"
                            @onchange="e => template.PositionId = EmptyToNull(e.Value?.ToString())">
                        <option value="">Alle Positionen</option>
                        @foreach (var position in positions)
                        {
                            <option value="@position.PositionId">@position.PositionName</option>
                        }
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label">Text</label>
                    <textarea class="form-control glassy-input" rows="4" @bind="template.Text"></textarea>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-3">
                <button class="btn btn-primary-glass" @onclick="() => SaveTemplate(template)">Speichern</button>
                <button class="btn btn-danger-glass" @onclick="() => DeleteTemplate(template)">Löschen</button>
            </div>
        </div>
    }
    <button class="btn btn-primary-glass mt-3" @onclick="AddTemplate">Vorlage hinzufügen</button>

    <!-- Eigene Platzhalter -->
    <div class="glass-card mt-4 p-3">
        <h3>Eigene Platzhalter</h3>
        <p class="text-muted">
            Ein Platzhalter ist ein Textbaustein, der in jeder Vorlage und in jedem Bot-Text als
            <code>{schluessel}</code> eingesetzt werden kann.
        </p>

        @foreach (var placeholder in placeholders.ToList())
        {
            var key = placeholder.Key;
            <div class="row g-2 align-items-end mb-2">
                <div class="col-12 col-md-3">
                    <code>{@key}</code>
                </div>
                <div class="col-12 col-md-7">
                    <input class="form-control glassy-input" value="@placeholders[key]"
                           @onchange="e => placeholders[key] = e.Value?.ToString() ?? string.Empty"/>
                </div>
                <div class="col-12 col-md-2 d-flex gap-2">
                    <button class="btn btn-primary-glass btn-sm" @onclick="() => SavePlaceholder(key)">Speichern</button>
                    <button class="btn btn-danger-glass btn-sm" @onclick="() => DeletePlaceholder(key)">Löschen</button>
                </div>
            </div>
        }

        <div class="row g-2 align-items-end mt-3">
            <div class="col-12 col-md-3">
                <label class="form-label">Schlüssel</label>
                <input class="form-control glassy-input" @bind="newPlaceholderKey" placeholder="z.B. regeln"/>
            </div>
            <div class="col-12 col-md-7">
                <label class="form-label">Text</label>
                <input class="form-control glassy-input" @bind="newPlaceholderText"/>
            </div>
            <div class="col-12 col-md-2">
                <button class="btn btn-primary-glass w-100" @onclick="AddPlaceholder">Anlegen</button>
            </div>
        </div>
    </div>

    <!-- Standardtexte des Bots -->
    <div class="glass-card mt-4 p-3">
        <h3>Bot-Texte</h3>
        <p class="text-muted">
            Diese Texte verschickt der Bot automatisch. Sie unterstützen dieselben Platzhalter.
        </p>

        @foreach (var setting in settingFields)
        {
            <div class="mb-3">
                <label class="form-label">@setting.Label</label>
                @if (setting.Multiline)
                {
                    <textarea class="form-control glassy-input" rows="3" value="@settings[setting.Key]"
                              @onchange="e => settings[setting.Key] = e.Value?.ToString() ?? string.Empty"></textarea>
                }
                else
                {
                    <input class="form-control glassy-input" value="@settings[setting.Key]"
                           @onchange="e => settings[setting.Key] = e.Value?.ToString() ?? string.Empty"/>
                }
            </div>
        }

        <button class="btn btn-primary-glass" @onclick="SaveSettings">Bot-Texte speichern</button>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private ClaimsPrincipal? _principal;
    private ulong userId;

    private bool loaded;
    private bool mayManage;
    private string statusMessage = "";

    private List<TeamApplicationPosition> positions = new();
    private List<TeamApplicationTemplate> templates = new();
    private Dictionary<string, string> placeholders = new();
    private Dictionary<string, string> settings = new();

    private string newPlaceholderKey = "";
    private string newPlaceholderText = "";

    private readonly (string Key, string Label, bool Multiline)[] settingFields =
    [
        ("LevelGateText", "Hinweis bei zu niedrigem Level (ohne Zahlen)", true),
        ("PanelClosedText", "Panel: Position aktuell geschlossen", false),
        ("PanelOpensAtText", "Panel: Hinweis auf den Starttermin", false),
        ("DmSubmitTitle", "DM Eingangsbestätigung: Titel", false),
        ("DmSubmitText", "DM Eingangsbestätigung: Text", true),
        ("DmAcceptTitle", "DM Zusage: Titel", false),
        ("DmAcceptText", "DM Zusage: Text", true),
        ("DmRejectTitle", "DM Absage: Titel", false),
        ("DmRejectText", "DM Absage: Text", true),
        ("DmGrantTitle", "DM Sofort-Wiederbewerbung: Titel", false),
        ("DmGrantText", "DM Sofort-Wiederbewerbung: Text", true),
        ("NotifyNewApplicationText", "Team-Channel: Text bei neuer Bewerbung", true)
    ];

    protected override async Task OnInitializedAsync()
    {
        _principal = AuthState is null ? null : (await AuthState).User;
        userId = UserService.GetUserId(_principal) ?? 0;

        mayManage = await TeamApplicationPermissionService.HasAsync(userId,
            TeamApplicationPermission.ManageQuestions);

        if (mayManage) await LoadAll();
        loaded = true;
    }

    private async Task LoadAll()
    {
        positions = await TeamApplicationService.GetPositionsAsync();
        templates = await TeamApplicationService.GetTemplatesAsync();
        placeholders = await TeamApplicationService.GetPlaceholdersAsync();

        settings = new Dictionary<string, string>();
        foreach (var (key, _, _) in settingFields) settings[key] = await TeamApplicationService.GetTextAsync(key);
    }

    private static string? EmptyToNull(string? value) => string.IsNullOrWhiteSpace(value) ? null : value;

    private async Task<bool> EnsurePermission()
    {
        if (await TeamApplicationPermissionService.HasAsync(userId, TeamApplicationPermission.ManageQuestions))
            return true;

        statusMessage = "Keine Berechtigung.";
        return false;
    }

    private async Task AddTemplate()
    {
        if (!await EnsurePermission()) return;

        var template = new TeamApplicationTemplate { Name = "Neue Vorlage" };
        await TeamApplicationService.UpsertTemplateAsync(template);
        templates.Add(template);
        statusMessage = "Vorlage hinzugefügt.";
    }

    private async Task SaveTemplate(TeamApplicationTemplate template)
    {
        if (!await EnsurePermission()) return;

        await TeamApplicationService.UpsertTemplateAsync(template);
        statusMessage = "Vorlage gespeichert.";
    }

    private async Task DeleteTemplate(TeamApplicationTemplate template)
    {
        if (!await EnsurePermission()) return;

        await TeamApplicationService.DeleteTemplateAsync(template.TemplateId);
        templates.Remove(template);
        statusMessage = "Vorlage gelöscht.";
    }

    private async Task AddPlaceholder()
    {
        if (!await EnsurePermission()) return;

        var key = TeamApplicationService.Slugify(newPlaceholderKey);
        if (string.IsNullOrEmpty(key))
        {
            statusMessage = "Bitte einen gültigen Schlüssel angeben.";
            return;
        }

        await TeamApplicationService.UpsertPlaceholderAsync(key, newPlaceholderText);
        placeholders[key] = newPlaceholderText;
        newPlaceholderKey = "";
        newPlaceholderText = "";
        statusMessage = "Platzhalter angelegt.";
    }

    private async Task SavePlaceholder(string key)
    {
        if (!await EnsurePermission()) return;

        await TeamApplicationService.UpsertPlaceholderAsync(key, placeholders[key]);
        statusMessage = "Platzhalter gespeichert.";
    }

    private async Task DeletePlaceholder(string key)
    {
        if (!await EnsurePermission()) return;

        await TeamApplicationService.DeletePlaceholderAsync(key);
        placeholders.Remove(key);
        statusMessage = "Platzhalter gelöscht.";
    }

    private async Task SaveSettings()
    {
        if (!await EnsurePermission()) return;

        foreach (var (key, value) in settings) await TeamApplicationService.SetTextAsync(key, value);
        statusMessage = "Bot-Texte gespeichert.";
    }
}
