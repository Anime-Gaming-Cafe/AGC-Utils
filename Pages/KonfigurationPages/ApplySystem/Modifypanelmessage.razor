@page "/konfiguration/applysystem/modifypanelmessage"
@using AGC_Management.Services
@using AGC_Management.Enums
@using AGC_Management.ApplicationSystem
@using DisCatSharp.Enums
@inject ToastService ToastService
@attribute [Authorize(Roles = "BotOwner, Administrator, HeadModerator")]

<PageHeader Title="Bewerbungspanel"
            Lead="Die Nachricht in Discord, über die sich Mitglieder bewerben."
            BackHref="/konfiguration" BackText="Administration"/>

<div class="detail-grid">
    <div>
        <Panel Title="Panel-Text" Lead="Unterstützt Markdown. Beim Speichern wird das bestehende Panel sofort aktualisiert.">
            <div class="field">
                <label class="field__label" for="panel-text">Text</label>
                <textarea id="panel-text" class="form-control" rows="14" @bind="panelmessage" @oninput="UpdatePreview"></textarea>
            </div>
            <div class="form-foot">
                <button type="button" class="btn btn-primary" @onclick="savePanelMessage">Text speichern</button>
            </div>
        </Panel>

        <Panel Title="Vorschau" Lead="Ungefähre Darstellung. Discord rendert Markdown in Details anders.">
            @* Replaces a Discord web-component library whose script sat in the component body and was
               therefore never executed by Blazor. The bar is the panel embed's own colour (DiscordColor.Gold),
               not the dashboard accent - see DESIGN.md, exceptions. *@
            <div class="embed-preview" style="border-left-color: #F1C40F;">
                <p class="embed-preview__title">Bewerbung</p>
                <div class="embed-preview__body">
                    @if (string.IsNullOrWhiteSpace(panelmessage))
                    {
                        <span>Es wurde noch kein Text für das Bewerbungspanel festgelegt.</span>
                    }
                    else
                    {
                        @((MarkupString)panelmessagepreview)
                    }
                </div>
                <p class="embed-preview__footer">AGC Bewerbungssystem</p>
            </div>
        </Panel>
    </div>

    <div>
        <Panel Title="Panel in Discord">
            @if (panelMessageId == 0)
            {
                <p class="meta mb-3">Es wurde noch kein Bewerbungspanel gesendet.</p>
            }
            else
            {
                <dl class="facts mb-3">
                    <dt>Channel</dt>
                    <dd>@CurrentPanelChannelName</dd>
                    <dt>Nachricht</dt>
                    <dd><a href="@PanelLink" target="_blank" rel="noopener">In Discord öffnen</a></dd>
                </dl>
            }

            <div class="field">
                <label class="field__label" for="panel-channel">Channel für ein neues Panel</label>
                <select id="panel-channel" class="form-select" @bind="selectedChannelId">
                    <option value="0">Channel wählen</option>
                    @foreach (var channel in textChannels)
                    {
                        <option value="@channel.Id">#@channel.Name</option>
                    }
                </select>
            </div>

            <div class="form-foot">
                <button type="button" class="btn btn-secondary" disabled="@sending" @onclick="SendPanel">Neues Panel senden</button>
                <button type="button" class="btn btn-ghost" disabled="@(panelMessageId == 0)" @onclick="RefreshPanel">Aktualisieren</button>
            </div>
            <p class="field__hint">
                Ein neues Panel ersetzt das alte nicht. Das alte bleibt stehen, wird aber nicht mehr aktualisiert.
                Lösche es in Discord von Hand.
            </p>
        </Panel>
    </div>
</div>

@code {
    private string panelmessage = "";
    private string panelmessagepreview = "";

    private List<DiscordChannel> textChannels = new();
    private ulong selectedChannelId;
    private ulong panelChannelId;
    private ulong panelMessageId;
    private bool sending;

    private string CurrentPanelChannelName =>
        CurrentApplication.TargetGuild.Channels.TryGetValue(panelChannelId, out var channel)
            ? "#" + channel.Name
            : panelChannelId.ToString();

    private string PanelLink =>
        $"https://discord.com/channels/{CurrentApplication.TargetGuild.Id}/{panelChannelId}/{panelMessageId}";

    protected override async Task OnInitializedAsync()
    {
        panelmessage = await CachingService.GetCacheValueAsBase64(CustomDatabaseCacheType.ApplicationSystemCache, "applypaneltext") ?? "";
        panelmessagepreview = panelmessage.ConvertMarkdownToHtml();

        textChannels = CurrentApplication.TargetGuild.Channels.Values
            .Where(c => c.Type == ChannelType.Text)
            .OrderBy(c => c.Position)
            .ToList();

        await LoadPanelLocation();
        selectedChannelId = panelChannelId;
    }

    private async Task LoadPanelLocation()
    {
        (panelChannelId, panelMessageId) = await ApplyPanelCommands.GetPanelLocationAsync();
    }

    private async Task SendPanel()
    {
        if (selectedChannelId == 0)
        {
            ToastService.Notify("Bitte zuerst einen Channel wählen.", "bad");
            return;
        }

        sending = true;
        try
        {
            await ApplyPanelCommands.SendPanelToChannelAsync(selectedChannelId);
            await LoadPanelLocation();
            ToastService.Notify("Panel wurde gesendet.", "ok");
        }
        catch (Exception e)
        {
            CurrentApplication.Logger.Error(e, "TeamApplications: Panel senden fehlgeschlagen");
            ToastService.Notify("Das Panel konnte nicht gesendet werden. Darf der Bot in diesem Channel schreiben?", "bad");
        }
        finally
        {
            sending = false;
        }
    }

    private void RefreshPanel()
    {
        ApplyPanelCommands.QueueRefreshPanel();
        ToastService.Notify("Panel wird aktualisiert.", "ok");
    }

    private void UpdatePreview(ChangeEventArgs e)
    {
        panelmessagepreview = (e.Value?.ToString() ?? "").ConvertMarkdownToHtml();
    }

    private async Task savePanelMessage()
    {
        await CachingService.SetCacheValueAsBase64(CustomDatabaseCacheType.ApplicationSystemCache, "applypaneltext", panelmessage);
        ApplyPanelCommands.QueueRefreshPanel();
        ToastService.Notify("Panel-Text gespeichert.", "ok");
    }
}
