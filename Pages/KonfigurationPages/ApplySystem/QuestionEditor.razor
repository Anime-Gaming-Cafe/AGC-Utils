@using AGC_Management.Entities.ApplicationSystem
@* Decides how one question's fields (QuestionFieldsEditor) get framed. A top-level question gets
   its own numbered Panel with Move/Delete. A follow-up (Nested) gets no box of its own at all -
   it belongs to its trigger, so it renders as a lightly indented continuation of the SAME card,
   just below a thin divider, not as a separate boxed panel. *@

@if (Nested)
{
    <div class="followup">
        <div class="followup__head">
            <p class="followup__lead">Folgefrage@(Lead is null ? "" : $" – {Lead}")</p>
            <button type="button" class="btn btn-ghost btn-sm" @onclick="OnDelete">Entfernen</button>
        </div>
        <QuestionFieldsEditor Question="Question" EligibleTriggers="EligibleTriggers"
                               OnFieldChanged="OnFieldChanged" OnConditionChanged="OnConditionChanged"/>
    </div>
}
else
{
    <Panel Title="@Title">
        <Actions>
            <button type="button" class="btn btn-ghost btn-sm" disabled="@(!CanMoveUp)" @onclick="OnMoveUp">Nach oben</button>
            <button type="button" class="btn btn-ghost btn-sm" disabled="@(!CanMoveDown)" @onclick="OnMoveDown">Nach unten</button>
            <button type="button" class="btn btn-danger btn-sm" @onclick="OnDelete">Löschen</button>
        </Actions>
        <ChildContent>
            <QuestionFieldsEditor Question="Question" EligibleTriggers="EligibleTriggers"
                                   OnFieldChanged="OnFieldChanged" OnConditionChanged="OnConditionChanged"/>

            @FollowUps

            @if (Question.IsChoice)
            {
                <div class="form-foot">
                    <button type="button" class="btn btn-ghost btn-sm" @onclick="OnAddFollowUp">Folgefrage hinzufügen</button>
                    <span class="meta">Erscheint nur, wenn diese Frage mit einem bestimmten Wert beantwortet wird.</span>
                </div>
            }
        </ChildContent>
    </Panel>
}

@code {
    [Parameter] [EditorRequired] public TeamApplicationQuestion Question { get; set; } = null!;
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Lead { get; set; }
    [Parameter] public bool Nested { get; set; }
    [Parameter] public bool CanMoveUp { get; set; }
    [Parameter] public bool CanMoveDown { get; set; }
    [Parameter] [EditorRequired] public List<TeamApplicationQuestion> EligibleTriggers { get; set; } = new();
    [Parameter] public EventCallback OnFieldChanged { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
    [Parameter] public EventCallback OnMoveUp { get; set; }
    [Parameter] public EventCallback OnMoveDown { get; set; }
    [Parameter] public EventCallback OnConditionChanged { get; set; }
    [Parameter] public EventCallback OnAddFollowUp { get; set; }
    [Parameter] public RenderFragment? FollowUps { get; set; }
}
