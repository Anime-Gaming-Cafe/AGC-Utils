@page "/konfiguration/applysystem/positions"
@using AGC_Management.Controller
@using AGC_Management.Entities.ApplicationSystem
@using AGC_Management.Enums.ApplicationSystem
@using AGC_Management.Services
@using AGC_Management.ApplicationSystem
@using DisCatSharp.Enums
@inject UserService UserService
@attribute [Authorize(Roles = "BotOwner, Administrator, HeadModerator, Moderator, Supporter, HeadEventmanager, Team")]

<h1>Bewerbungspositionen</h1>

@if (!loaded)
{
    <div class="spinner-border" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
}
else if (!mayManage)
{
    <div class="alert alert-danger-glass mt-3" role="alert">
        Du hast keine Berechtigung, Bewerbungspositionen zu verwalten.
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert alert-info-glass mt-2" role="alert">@statusMessage</div>
    }

    @foreach (var position in positions)
    {
        <div class="glass-card mt-4 p-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <h3 class="mb-0">@position.PositionName</h3>
                <span class="@(position.Active ? "badge-success-glass" : "badge-danger-glass")">
                    @(position.Active ? "Aktiv" : "Inaktiv")
                </span>
            </div>
            <p class="text-muted mb-3"><code>@position.PositionId</code></p>

            <div class="row g-2">
                <div class="col-12 col-md-6">
                    <label class="form-label">Anzeigename</label>
                    <input class="form-control glassy-input" @bind="position.PositionName"/>
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label">Mindestlevel</label>
                    <input type="number" min="0" class="form-control glassy-input" @bind="position.MinLevel"/>
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label">Benachrichtigungs-Channel</label>
                    <select class="form-select glassy-input" @bind="position.NotifyChannelId">
                        <option value="0">-- kein Channel --</option>
                        @foreach (var channel in textChannels)
                        {
                            <option value="@channel.Id">#@channel.Name</option>
                        }
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label">Beschreibung</label>
                    <textarea class="form-control glassy-input" rows="2" @bind="position.Description"></textarea>
                </div>
            </div>

            <div class="form-check mt-3">
                <input class="form-check-input" type="checkbox" id="active-@position.PositionId" @bind="position.Active"/>
                <label class="form-check-label" for="active-@position.PositionId">
                    Im Bewerbungspanel anzeigen
                </label>
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="alwaysopen-@position.PositionId"
                       @bind="position.AlwaysOpen"/>
                <label class="form-check-label" for="alwaysopen-@position.PositionId">
                    Bewerbungseinsendung immer erlauben
                    <span class="badge bg-secondary">Debug</span>
                </label>
            </div>

            @if (position.AlwaysOpen)
            {
                <div class="alert alert-warning-glass" role="alert">
                    Übersprungen werden: offene Phase, Mindestlevel und "eine Bewerbung pro Phase".
                    Eingereicht wird auf die neueste nicht archivierte Phase, gegen den aktuell
                    veröffentlichten Fragenkatalog. Ohne Phase und ohne veröffentlichten Katalog bleibt die
                    Position trotzdem geschlossen.
                </div>
            }

            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-primary-glass" @onclick="() => SavePosition(position)">Speichern</button>
                <a class="btn btn-secondary-glass" href="/konfiguration/applysystem/questions/@position.PositionId">Fragenkatalog</a>
                <a class="btn btn-secondary-glass" href="/konfiguration/applysystem/phases/@position.PositionId">Phasen</a>
                @if (isAdministrator && pendingDelete != position.PositionId)
                {
                    <button class="btn btn-danger-glass" @onclick="() => RequestDelete(position)">Löschen</button>
                }
            </div>

            @if (isAdministrator && pendingDelete == position.PositionId)
            {
                <div class="alert alert-danger-glass mt-3" role="alert">
                    <h4 class="alert-heading">Position endgültig löschen?</h4>
                    <hr>
                    <p>
                        Gelöscht werden die Position <strong>@position.PositionName</strong>, alle
                        Fragenkatalog-Versionen, alle Phasen, alle positionsbezogenen Textbausteine und
                        Rechte-Einträge
                        @if (pendingDeleteApplications > 0)
                        {
                            <text>
                                sowie <strong>@pendingDeleteApplications Bewerbungen</strong> mit allen Antworten
                                und internen Notizen
                            </text>
                        }
                        . Das lässt sich nicht rückgängig machen.
                    </p>
                    @if (pendingDeleteApplications > 0)
                    {
                        <p>
                            Soll die Position nur aus dem Panel verschwinden, entferne stattdessen den Haken bei
                            "Im Bewerbungspanel anzeigen" und speichere.
                        </p>
                    }
                    <div class="d-flex flex-wrap gap-2">
                        <button class="btn btn-danger-glass" disabled="@deleting"
                                @onclick="() => DeletePosition(position)">Ja, endgültig löschen</button>
                        <button class="btn btn-secondary-glass" @onclick="() => pendingDelete = null">Abbrechen</button>
                    </div>
                </div>
            }
        </div>
    }

    <div class="glass-card mt-4 p-3">
        <h3>Neue Position anlegen</h3>
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-5">
                <label class="form-label">Name</label>
                <input class="form-control glassy-input" @bind="newName" placeholder="z.B. Supporter"/>
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label">Mindestlevel</label>
                <input type="number" min="0" class="form-control glassy-input" @bind="newMinLevel"/>
            </div>
            <div class="col-12 col-md-4">
                <button class="btn btn-primary-glass w-100" @onclick="CreatePosition">Anlegen</button>
            </div>
        </div>
        <p class="text-muted mt-2 mb-0">
            Aus dem Namen wird die ID für die Bewerbungs-URL gebildet. Sie lässt sich später nicht mehr ändern.
        </p>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private ClaimsPrincipal? _principal;
    private ulong userId;

    private bool loaded;
    private bool mayManage;
    private bool isAdministrator;
    private bool deleting;
    private string statusMessage = "";

    private string? pendingDelete;
    private int pendingDeleteApplications;

    private List<TeamApplicationPosition> positions = new();
    private List<DiscordChannel> textChannels = new();

    private string newName = "";
    private int newMinLevel = 20;

    protected override async Task OnInitializedAsync()
    {
        _principal = AuthState is null ? null : (await AuthState).User;
        userId = UserService.GetUserId(_principal) ?? 0;

        mayManage = await TeamApplicationPermissionService.HasAsync(userId,
            TeamApplicationPermission.ManageQuestions);
        isAdministrator = await TeamApplicationPermissionService.IsAdministratorAsync(userId);

        if (mayManage) await LoadAll();
        loaded = true;
    }

    private async Task LoadAll()
    {
        textChannels = CurrentApplication.TargetGuild.Channels.Values
            .Where(c => c.Type == ChannelType.Text)
            .OrderBy(c => c.Position)
            .ToList();

        positions = await TeamApplicationService.GetPositionsAsync();
    }

    private async Task SavePosition(TeamApplicationPosition position)
    {
        if (!await TeamApplicationPermissionService.HasAsync(userId, TeamApplicationPermission.ManageQuestions,
                position.PositionId))
        {
            statusMessage = "Keine Berechtigung für diese Position.";
            return;
        }

        try
        {
            await TeamApplicationService.UpdatePositionAsync(position);
            ApplyPanelCommands.QueueRefreshPanel();
            statusMessage = $"Position \"{position.PositionName}\" gespeichert.";
        }
        catch (Exception e)
        {
            CurrentApplication.Logger.Error(e, "TeamApplications: Position speichern fehlgeschlagen");
            statusMessage = "Fehler beim Speichern.";
        }
    }

    private async Task RequestDelete(TeamApplicationPosition position)
    {
        if (!await TeamApplicationPermissionService.IsAdministratorAsync(userId))
        {
            statusMessage = "Positionen dürfen nur Administratoren löschen.";
            return;
        }

        pendingDeleteApplications = await TeamApplicationService.CountApplicationsForPositionAsync(
            position.PositionId);
        pendingDelete = position.PositionId;
    }

    private async Task DeletePosition(TeamApplicationPosition position)
    {
        if (deleting) return;

        // Re-checked here, not just when the button was rendered.
        if (!await TeamApplicationPermissionService.IsAdministratorAsync(userId))
        {
            statusMessage = "Positionen dürfen nur Administratoren löschen.";
            pendingDelete = null;
            return;
        }

        deleting = true;
        try
        {
            await TeamApplicationService.DeletePositionAsync(position.PositionId);
            ApplyPanelCommands.QueueRefreshPanel();

            CurrentApplication.Logger.Information(
                $"TeamApplications: Position {position.PositionId} von {userId} gelöscht " +
                $"({pendingDeleteApplications} Bewerbungen).");

            pendingDelete = null;
            await LoadAll();
            statusMessage = $"Position \"{position.PositionName}\" wurde gelöscht.";
        }
        catch (Exception e)
        {
            CurrentApplication.Logger.Error(e, "TeamApplications: Position löschen fehlgeschlagen");
            statusMessage = "Die Position konnte nicht gelöscht werden. Es wurde nichts verändert.";
        }
        finally
        {
            deleting = false;
        }
    }

    private async Task CreatePosition()
    {
        if (!await TeamApplicationPermissionService.HasAsync(userId, TeamApplicationPermission.ManageQuestions))
        {
            statusMessage = "Keine Berechtigung.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newName))
        {
            statusMessage = "Bitte einen Namen angeben.";
            return;
        }

        var slug = TeamApplicationService.Slugify(newName);
        if (string.IsNullOrEmpty(slug) || TeamApplicationService.IsReservedSlug(slug))
        {
            statusMessage = "Dieser Name ergibt keine gültige ID. Bitte einen anderen wählen.";
            return;
        }

        var created = await TeamApplicationService.CreatePositionAsync(newName, newMinLevel, 0, "");
        if (created == null)
        {
            statusMessage = "Es gibt bereits eine Position mit dieser ID.";
            return;
        }

        newName = "";
        newMinLevel = 20;
        await LoadAll();
        statusMessage = "Position angelegt. Lege nun den Fragenkatalog an.";
    }
}
