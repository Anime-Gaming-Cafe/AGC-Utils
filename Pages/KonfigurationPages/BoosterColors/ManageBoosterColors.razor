@page "/konfiguration/boostercolors"
@using AGC_Management.Services
@using AGC_Management.BoosterColors
@using DisCatSharp.Enums
@attribute [Authorize(Roles = "BotOwner, Administrator, HeadModerator")]

<PageHeader Title="Booster Farben"
            Lead="Farbrollen, die Booster sich über das Panel selbst aussuchen."
            BackHref="/konfiguration" BackText="Administration"/>

@if (!loaded)
{
    <StateBlock Kind="StateBlock.StateKind.Loading"
                Title="Booster Farben werden geladen"
                Description="Einstellungen, Farbrollen und Text-Channels werden abgefragt."/>
}
else
{
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="notice notice--@statusTone mb-3" role="status">@statusMessage</div>
    }

    @if (boundariesMissing)
    {
        <div class="notice notice--warn mb-3">
            <p class="notice__title">Boundary-Rollen fehlen</p>
            <p>
                Es gibt keine Rollen namens <code>BEGIN_BOOSTERCOLOR</code> und <code>END_BOOSTERCOLOR</code>.
                Lege beide an. Jede Rolle zwischen ihnen wird automatisch als Booster Farbe erkannt.
            </p>
        </div>
    }

    <Panel Title="Farbrollen" Lead="Rollen zwischen den Boundary-Rollen erscheinen im Auswahlmenü des Panels."
           Flush="@(colorRoles.Count > 0)">
        @if (colorRoles.Count == 0)
        {
            <StateBlock Inline="true"
                        Title="Noch keine Farbrollen"
                        Description="Lege unten die erste an, oder verschiebe bestehende Rollen zwischen die Boundary-Rollen."/>
        }
        else
        {
            <div class="table-wrap">
                <table class="table">
                    <thead>
                    <tr>
                        <th></th>
                        <th>Name</th>
                        <th>Farbe</th>
                        <th>Verlauf</th>
                        <th class="text-end">Mitglieder</th>
                        <th></th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var role in colorRoles)
                    {
                        <tr>
                            <td><span class="swatch" style="background:@PreviewBackground(role);"></span></td>
                            <td><input class="form-control form-control-sm" aria-label="Name" @bind="role.Name"/></td>
                            <td><input type="color" class="form-control form-control-color" aria-label="Farbe" @bind="role.Hex"/></td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="form-check form-switch m-0">
                                        <input class="form-check-input" type="checkbox" role="switch" aria-label="Verlauf" @bind="role.Gradient"/>
                                    </div>
                                    @if (role.Gradient)
                                    {
                                        <input type="color" class="form-control form-control-color" aria-label="Zweite Farbe" @bind="role.SecondaryHex"/>
                                    }
                                </div>
                            </td>
                            <td class="tnum text-end">@role.MemberCount</td>
                            <td>
                                <div class="row-actions justify-content-end">
                                    <button type="button" class="btn btn-secondary btn-sm" @onclick="() => SaveRole(role)">Speichern</button>
                                    <button type="button" class="btn btn-danger btn-sm" @onclick="() => pendingDeleteRole = role.Id">Löschen</button>
                                </div>
                            </td>
                        </tr>
                        @if (pendingDeleteRole == role.Id)
                        {
                            <tr>
                                <td colspan="6">
                                    <ConfirmInline Title="@($"Farbrolle „{role.Name}“ löschen?")"
                                                   ConfirmText="Ja, Rolle löschen"
                                                   OnConfirm="() => DeleteRole(role)"
                                                   OnCancel="() => pendingDeleteRole = 0">
                                        <p>
                                            Die Rolle wird in Discord gelöscht@(role.MemberCount > 0 ? $" und {role.MemberCount} Mitgliedern entzogen" : "").
                                            Das lässt sich nicht rückgängig machen.
                                        </p>
                                    </ConfirmInline>
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        }
    </Panel>

    <Panel Title="Neue Farbrolle">
        <div class="field-grid">
            <div class="field">
                <label class="field__label" for="bc-new-name">Name</label>
                <input id="bc-new-name" class="form-control" @bind="newRoleName" placeholder="Name der Farbe"/>
            </div>
            <div class="field">
                <label class="field__label" for="bc-new-color">Farbe</label>
                <input id="bc-new-color" type="color" class="form-control form-control-color" @bind="newRoleHex"/>
            </div>
            <div class="field">
                <span class="field__label">Verlauf</span>
                <div class="d-flex align-items-center gap-2">
                    <div class="form-check form-switch m-0">
                        <input class="form-check-input" type="checkbox" role="switch" id="bc-new-gradient" @bind="newRoleGradient"/>
                        <label class="form-check-label" for="bc-new-gradient">Zweite Farbe</label>
                    </div>
                    @if (newRoleGradient)
                    {
                        <input type="color" class="form-control form-control-color" aria-label="Zweite Farbe" @bind="newRoleSecondaryHex"/>
                    }
                </div>
                <span class="field__hint">Verläufe brauchen ein ausreichendes Server-Boost-Level.</span>
            </div>
        </div>
        <div class="form-foot">
            <button type="button" class="btn btn-primary" disabled="@boundariesMissing" @onclick="CreateRole">Farbrolle anlegen</button>
        </div>
    </Panel>

    <Panel Title="Panel und Einstellungen">
        <div class="field-grid">
            <div class="field">
                <label class="field__label" for="bc-channel">Panel-Channel</label>
                <select id="bc-channel" class="form-select" @bind="panelChannelId">
                    <option value="0">Channel wählen</option>
                    @foreach (var channel in textChannels)
                    {
                        <option value="@channel.Id">#@channel.Name</option>
                    }
                </select>
            </div>
            <div class="field">
                <label class="field__label" for="bc-title">Embed-Titel</label>
                <input id="bc-title" class="form-control" @bind="embedTitle"/>
            </div>
            <div class="field field--wide">
                <label class="field__label" for="bc-desc">Embed-Beschreibung</label>
                <textarea id="bc-desc" class="form-control" rows="3" @bind="embedDescription"></textarea>
            </div>
        </div>

        <div class="form-check form-switch mt-3">
            <input class="form-check-input" type="checkbox" role="switch" id="bc-enabled" @bind="enabled"/>
            <label class="form-check-label" for="bc-enabled">Booster Farben aktiviert</label>
        </div>
        <div class="form-check form-switch mt-2">
            <input class="form-check-input" type="checkbox" role="switch" id="bc-bypass" @bind="bypassEligibility"/>
            <label class="form-check-label" for="bc-bypass">Boost-Prüfung überspringen</label>
            <span class="field__hint">Zum Testen: jeder gilt als Booster, Teammitglieder ausgenommen.</span>
        </div>

        <div class="form-foot">
            <button type="button" class="btn btn-secondary" @onclick="SaveSettings">Einstellungen speichern</button>
            <button type="button" class="btn btn-secondary" @onclick="SendPanel">Panel senden</button>
            <button type="button" class="btn btn-ghost" @onclick="RefreshPanel">Panel aktualisieren</button>
        </div>
    </Panel>
}

@code {
    private bool loaded;
    private bool boundariesMissing;
    private string statusMessage = "";
    private string statusTone = "ok";
    private ulong pendingDeleteRole;

    private List<ColorRoleVm> colorRoles = new();
    private List<DiscordChannel> textChannels = new();

    private ulong panelChannelId;
    private string embedTitle = "";
    private string embedDescription = "";
    private bool enabled;
    private bool bypassEligibility;

    private string newRoleName = "";
    private string newRoleHex = "#9f00ff";
    private bool newRoleGradient;
    private string newRoleSecondaryHex = "#00b3ff";

    protected override async Task OnInitializedAsync()
    {
        await LoadAll();
        loaded = true;
    }

    private async Task LoadAll()
    {
        var guild = CurrentApplication.TargetGuild;

        boundariesMissing = BoosterColorService.GetBoundaries(guild) == null;

        textChannels = guild.Channels.Values
            .Where(c => c.Type == ChannelType.Text)
            .OrderBy(c => c.Position)
            .ToList();

        panelChannelId = await BoosterColorService.GetPanelChannelIdAsync();
        embedTitle = await BoosterColorService.GetEmbedTitleAsync();
        embedDescription = await BoosterColorService.GetEmbedDescriptionAsync();
        enabled = await BoosterColorService.GetEnabledAsync();
        bypassEligibility = await BoosterColorService.GetBypassEligibilityAsync();

        LoadColorRoles(guild);
    }

    private void LoadColorRoles(DiscordGuild guild)
    {
        colorRoles = BoosterColorService.GetColorRoles(guild)
            .Select(r =>
            {
                var secondary = r.Colors?.SecondaryColor;
                return new ColorRoleVm
                {
                    Id = r.Id,
                    Name = r.Name,
                    Hex = HexOf(r.Color),
                    Gradient = secondary.HasValue,
                    SecondaryHex = secondary.HasValue ? HexOf(secondary.Value) : "#00b3ff",
                    MemberCount = guild.Members.Values.Count(m => m.Roles.Any(mr => mr.Id == r.Id))
                };
            })
            .ToList();
    }

    private async Task SaveSettings()
    {
        await BoosterColorService.SetEmbedTitleAsync(embedTitle);
        await BoosterColorService.SetEmbedDescriptionAsync(embedDescription);
        await BoosterColorService.SetEnabledAsync(enabled);
        await BoosterColorService.SetBypassEligibilityAsync(bypassEligibility);
        BoosterColorPanelCommands.QueueRefreshPanel();
        Say("Einstellungen gespeichert.", "ok");
    }

    private async Task SendPanel()
    {
        if (panelChannelId == 0)
        {
            Say("Bitte zuerst einen Panel-Channel wählen.", "bad");
            return;
        }

        try
        {
            await BoosterColorPanelCommands.SendPanelToChannelAsync(panelChannelId);
            Say("Panel wurde gesendet.", "ok");
        }
        catch (Exception e)
        {
            Say($"Fehler beim Senden des Panels: {e.Message}", "bad");
        }
    }

    private async Task RefreshPanel()
    {
        await BoosterColorPanelCommands.RefreshPanel();
        Say("Panel wird aktualisiert.", "ok");
    }

    private async Task CreateRole()
    {
        if (string.IsNullOrWhiteSpace(newRoleName))
        {
            Say("Bitte einen Namen angeben.", "bad");
            return;
        }

        var guild = CurrentApplication.TargetGuild;

        // Step 1: create the role.
        DiscordRole role;
        try
        {
            var color = new DiscordColor(newRoleHex.TrimStart('#'));
            role = await guild.CreateRoleAsync(newRoleName.Trim(), color: color, mentionable: false,
                reason: "Booster color role created via WebUI");
        }
        catch (Exception e)
        {
            CurrentApplication.Logger.Error(e, "BoosterColors: failed to create role");
            Say($"Fehler beim Anlegen der Rolle: {DescribeError(e)}", "bad");
            return;
        }

        // Step 1b: optionally apply a gradient (two color blend). Requires the guild to support enhanced role colors.
        var colorWarning = "";
        if (newRoleGradient)
        {
            try
            {
                await ApplyColorsAsync(role, newRoleHex, true, newRoleSecondaryHex);
            }
            catch (Exception e)
            {
                CurrentApplication.Logger.Error(e, "BoosterColors: failed to apply gradient");
                colorWarning =
                    $" Gradient konnte nicht gesetzt werden ({DescribeError(e)}). Gradients brauchen ein ausreichendes Server-Boost-Level.";
            }
        }

        // Step 2: position it between the boundaries (separate so a hierarchy issue does not look like a create failure).
        var positionWarning = "";
        var boundaries = BoosterColorService.GetBoundaries(guild);
        if (boundaries != null)
        {
            try
            {
                var low = Math.Min(boundaries.Value.begin.Position, boundaries.Value.end.Position);
                var botTop = guild.CurrentMember.Roles.Any()
                    ? guild.CurrentMember.Roles.Max(r => r.Position)
                    : 0;
                var targetPosition = low + 1;

                // The bot can never move a role to or above its own highest role.
                if (botTop > 0 && targetPosition >= botTop)
                    positionWarning =
                        " Achtung: Die Bot-Rolle steht nicht über den Boundary-Rollen, daher konnte die Rolle nicht korrekt einsortiert werden. Verschiebe die Bot-Rolle über BEGIN_BOOSTERCOLOR.";
                else
                    await role.ModifyPositionAsync(targetPosition, "Place booster color between boundaries");
            }
            catch (Exception e)
            {
                CurrentApplication.Logger.Error(e, "BoosterColors: failed to position role");
                positionWarning = $" Positionierung fehlgeschlagen: {DescribeError(e)}";
            }
        }
        else
        {
            positionWarning = " Boundary-Rollen fehlen, die Rolle wurde nicht einsortiert.";
        }

        await BoosterColorService.SyncEmojiAsync(role);
        BoosterColorPanelCommands.QueueRefreshPanel();

        newRoleName = "";
        newRoleHex = "#9f00ff";
        newRoleGradient = false;
        newRoleSecondaryHex = "#00b3ff";
        Say($"Farbrolle „{role.Name}“ wurde angelegt.{positionWarning}{colorWarning}",
            positionWarning.Length > 0 || colorWarning.Length > 0 ? "warn" : "ok");
        LoadColorRoles(guild);
    }

    /// <summary>
    ///     Applies a solid or gradient color to a role. Gradient sets a secondary color (blend), solid clears it.
    /// </summary>
    private static async Task ApplyColorsAsync(DiscordRole role, string primaryHex, bool gradient, string secondaryHex)
    {
        var primary = new DiscordColor(primaryHex.TrimStart('#'));
        if (gradient)
        {
            var secondary = new DiscordColor(secondaryHex.TrimStart('#'));
            await role.ModifyAsync(m =>
            {
                m.Colors = new DiscordRoleColors
                {
                    PrimaryColor = primary,
                    SecondaryColor = secondary
                };
            });
        }
        else
        {
            await role.ModifyAsync(m =>
            {
                m.Colors = new DiscordRoleColors
                {
                    PrimaryColor = primary,
                    SecondaryColor = null
                };
            });
        }
    }

    private static string PreviewBackground(ColorRoleVm role)
    {
        return role.Gradient
            ? $"linear-gradient(90deg, {role.Hex}, {role.SecondaryHex})"
            : role.Hex;
    }

    private static string DescribeError(Exception e)
    {
        switch (e)
        {
            case DisCatSharp.Exceptions.BadRequestException bre:
                return $"BadRequest (Code {bre.Code}): {bre.JsonMessage} {bre.Errors}".Trim();
            case DisCatSharp.Exceptions.UnauthorizedException ue:
                return
                    $"Keine Berechtigung: {ue.JsonMessage}. Der Bot braucht 'Rollen verwalten' und muss in der Rollen-Hierarchie über den Boundary-Rollen stehen.";
            default:
                return e.Message;
        }
    }

    private async Task SaveRole(ColorRoleVm vm)
    {
        var guild = CurrentApplication.TargetGuild;
        try
        {
            var role = guild.GetRole(vm.Id);
            if (role == null)
            {
                Say("Rolle nicht gefunden.", "bad");
                return;
            }

            await role.ModifyAsync(name: vm.Name, reason: "Booster color role edited via WebUI");
            await ApplyColorsAsync(role, vm.Hex, vm.Gradient, vm.SecondaryHex);
            await BoosterColorService.SyncEmojiAsync(guild.GetRole(vm.Id));
            BoosterColorPanelCommands.QueueRefreshPanel();
            Say($"Farbrolle „{vm.Name}“ wurde gespeichert.", "ok");
            LoadColorRoles(guild);
        }
        catch (Exception e)
        {
            CurrentApplication.Logger.Error(e, "BoosterColors: failed to save role");
            Say($"Fehler beim Speichern: {DescribeError(e)}", "bad");
        }
    }

    private async Task DeleteRole(ColorRoleVm vm)
    {
        pendingDeleteRole = 0;
        var guild = CurrentApplication.TargetGuild;
        try
        {
            var role = guild.GetRole(vm.Id);
            if (role != null)
                await role.DeleteAsync("Booster color role deleted via WebUI");
            await BoosterColorService.DeleteEmojiAsync(vm.Id);
            BoosterColorPanelCommands.QueueRefreshPanel();
            Say($"Farbrolle „{vm.Name}“ wurde gelöscht.", "ok");
            LoadColorRoles(guild);
        }
        catch (Exception e)
        {
            CurrentApplication.Logger.Error(e, "BoosterColors: failed to delete role");
            Say($"Fehler beim Löschen: {DescribeError(e)}", "bad");
        }
    }

    private void Say(string message, string tone)
    {
        statusMessage = message;
        statusTone = tone;
    }

    private static string HexOf(DiscordColor c)
    {
        return $"#{c.R:X2}{c.G:X2}{c.B:X2}";
    }

    private sealed class ColorRoleVm
    {
        public ulong Id { get; set; }
        public string Name { get; set; } = "";
        public string Hex { get; set; } = "#000000";
        public bool Gradient { get; set; }
        public string SecondaryHex { get; set; } = "#00b3ff";
        public int MemberCount { get; set; }
    }
}
