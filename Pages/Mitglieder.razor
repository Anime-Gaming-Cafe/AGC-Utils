@page "/mitglieder"
@using AGC_Management.Utils
@implements IDisposable
@attribute [Authorize(Policy = DashboardPolicies.SupportUp)]

<PageHeader Title="Mitglieder"
            Lead="@(members is null ? null : $"{matchingMembers?.Length ?? 0} von {members.Length} Mitgliedern")">
    <Actions>
        <AuthorizeView Policy="@DashboardPolicies.AdminOnly">
            <button type="button" class="btn btn-secondary" disabled="@isLoading" @onclick="MitgliederNeuEinlesen"
                    title="Lädt alle Mitglieder direkt von Discord. Das belastet das Rate-Limit.">
                <AppIcon Name="refresh"/> Von Discord neu einlesen
            </button>
        </AuthorizeView>
    </Actions>
</PageHeader>

<Panel>
    <div class="filter-bar">
        <div class="field">
            <label class="field__label" for="m-search">Suche</label>
            <input id="m-search" class="form-control" placeholder="Name oder User-ID"
                   value="@searchTerm" @oninput="OnSearchTermChanged"/>
        </div>
        <div class="field">
            <label class="field__label" for="m-size">Pro Seite</label>
            <select id="m-size" class="form-select" value="@pageSize" @onchange="OnPageSizeChanged">
                @foreach (var size in new[] { 10, 25, 50, 100, 500, 1000 })
                {
                    <option value="@size">@size</option>
                }
            </select>
        </div>
        <div class="field">
            <span class="field__label">Nur anzeigen</span>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="m-bots"
                       @bind="showOnlyBots" @bind:after="ApplyFiltersAndPaginationAsync"/>
                <label class="form-check-label" for="m-bots">Bots</label>
            </div>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="m-staff"
                       @bind="showOnlyStaff" @bind:after="ApplyFiltersAndPaginationAsync"/>
                <label class="form-check-label" for="m-staff">Team</label>
            </div>
        </div>
    </div>
</Panel>

<div class="mt-3">
    @if (isLoading)
    {
        @* Only the real load shows this. Filtering and paging used to black out the whole screen. *@
        <StateBlock Kind="StateBlock.StateKind.Loading"
                    Title="Mitglieder werden geladen"
                    Description="Die Mitgliederliste des Servers wird eingelesen."/>
    }
    else if (members is null || members.Length == 0)
    {
        <StateBlock Title="Keine Mitglieder im Cache"
                    Description="Der Bot hat die Mitgliederliste noch nicht eingelesen. Das passiert automatisch kurz nach dem Start."/>
    }
    else if (matchingMembers is null || matchingMembers.Length == 0)
    {
        <StateBlock Title="Kein Mitglied passt zum Filter"
                    Description="Es gibt Mitglieder, aber keines erfüllt alle gewählten Bedingungen."
                    ActionText="Filter zurücksetzen"
                    OnAction="ResetFilters"/>
    }
    else
    {
        <Panel Flush="true">
            <div class="table-wrap">
                <table class="table">
                    <thead>
                    <tr>
                        <th>Name</th>
                        <th>User-ID</th>
                        <th>Account erstellt</th>
                        <th aria-sort="@(sortAscending ? "ascending" : "descending")">
                            <button type="button" class="btn btn-ghost btn-sm" @onclick="ToggleSortOrder">
                                Beigetreten @(sortAscending ? "↑" : "↓")
                            </button>
                        </th>
                        <th></th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var member in filteredMembers ?? Array.Empty<DiscordMember>())
                    {
                        var isTeam = member.isTeamMember();
                        <tr>
                            <td>
                                <div>@ToolSet.GetFormattedName(member)</div>
                                @if (member.IsBot || isTeam || member.PremiumSince.HasValue || member.IsCommunicationDisabled || member.HasUnusualDmActivity)
                                {
                                    <div class="d-flex flex-wrap gap-1 mt-1">
                                        @if (member.IsBot)
                                        {
                                            <StatusPill Text="Bot"/>
                                        }
                                        @if (isTeam)
                                        {
                                            <StatusPill Text="Team"/>
                                        }
                                        @if (member.PremiumSince.HasValue)
                                        {
                                            <StatusPill Text="Booster"/>
                                        }
                                        @if (member.IsCommunicationDisabled)
                                        {
                                            <StatusPill Text="Timeout" Tone="StatusPill.PillTone.Bad"/>
                                        }
                                        @if (member.HasUnusualDmActivity)
                                        {
                                            <StatusPill Text="Auffällige DMs" Tone="StatusPill.PillTone.Warn"/>
                                        }
                                    </div>
                                }
                            </td>
                            <td class="mono">@member.Id</td>
                            <td class="tnum">@member.CreationTimestamp.ToLocalTime().ToString("dd.MM.yyyy")</td>
                            <td class="tnum">@member.JoinedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                            <td class="text-end">
                                <a class="btn btn-ghost btn-sm" href="/managemember?userid=@member.Id">Details</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </Panel>

        <Pager Current="currentPage" CurrentChanged="GoToPage" TotalPages="totalPages" TotalItems="matchingMembers.Length"/>
    }
</div>

@code {
    private DiscordMember[]? members;
    private DiscordMember[]? matchingMembers;
    private DiscordMember[]? filteredMembers;
    private string searchTerm = string.Empty;
    private bool showOnlyBots;
    private bool showOnlyStaff;
    private bool sortAscending = true;
    private bool isLoading = true;
    private readonly CancellationTokenSource cancellationTokenSource = new();
    private Timer? debounceTimer;

    private int currentPage = 1;
    private int pageSize = 50;
    private int totalPages = 1;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        try
        {
            members = await Task.Run(() =>
                CurrentApplication.TargetGuild.Members.Values.OrderByDescending(m => m.JoinedAt).ToArray(),
                cancellationTokenSource.Token);
            ApplyFilters();
        }
        catch (Exception ex)
        {
            CurrentApplication.Logger.Error(ex, "Mitgliederliste konnte nicht geladen werden");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task MitgliederNeuEinlesen()
    {
        isLoading = true;
        try
        {
            var guild = await CurrentApplication.DiscordClient.GetGuildAsync(
                ulong.Parse(BotConfig.GetConfig()["ServerConfig"]["ServerId"]));
            members = (await guild.GetAllMembersAsync()).ToArray();
            ApplyFilters();
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            CurrentApplication.Logger.Error(ex, "Mitglieder konnten nicht neu eingelesen werden");
        }
        finally
        {
            isLoading = false;
        }
    }

    /// <summary>In-memory and instant, so it deliberately does not touch the loading state.</summary>
    private void ApplyFilters()
    {
        IEnumerable<DiscordMember> query = members ?? Array.Empty<DiscordMember>();

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            if (ulong.TryParse(searchTerm, out var id))
                query = query.Where(m => m.Id == id);
            else
                query = query.Where(m =>
                    (m.Nickname != null && m.Nickname.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                    (m.DisplayName != null && m.DisplayName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                    m.Username.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
        }

        if (showOnlyStaff) query = query.Where(m => m.isTeamMember());
        if (showOnlyBots) query = query.Where(m => m.IsBot);

        query = sortAscending ? query.OrderBy(m => m.JoinedAt) : query.OrderByDescending(m => m.JoinedAt);

        matchingMembers = query.ToArray();
        ApplyPagination();
    }

    private Task ApplyFiltersAndPaginationAsync()
    {
        currentPage = 1;
        ApplyFilters();
        return Task.CompletedTask;
    }

    private void ApplyPagination()
    {
        var total = matchingMembers?.Length ?? 0;
        totalPages = Math.Max(1, (int)Math.Ceiling(total / (double)pageSize));
        if (currentPage > totalPages) currentPage = totalPages;

        filteredMembers = (matchingMembers ?? Array.Empty<DiscordMember>())
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToArray();
    }

    private void GoToPage(int page)
    {
        currentPage = page;
        ApplyPagination();
    }

    private void ToggleSortOrder()
    {
        sortAscending = !sortAscending;
        ApplyFilters();
    }

    private void ResetFilters()
    {
        searchTerm = string.Empty;
        showOnlyBots = false;
        showOnlyStaff = false;
        currentPage = 1;
        ApplyFilters();
    }

    private void OnSearchTermChanged(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;

        if (debounceTimer == null)
            debounceTimer = new Timer(_ => InvokeAsync(() =>
            {
                currentPage = 1;
                ApplyFilters();
                StateHasChanged();
            }), null, 250, Timeout.Infinite);
        else
            debounceTimer.Change(250, Timeout.Infinite);
    }

    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var newSize)) return;

        pageSize = newSize;
        currentPage = 1;
        ApplyPagination();
    }

    public void Dispose()
    {
        cancellationTokenSource.Cancel();
        cancellationTokenSource.Dispose();
        debounceTimer?.Dispose();
    }
}
