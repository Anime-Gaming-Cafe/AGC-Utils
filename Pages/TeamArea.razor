@page "/teamarea"
@using AGC_Management.Controller
@using AGC_Management.Enums.ApplicationSystem
@using AGC_Management.Services
@inject UserService UserService
@attribute [Authorize(Policy = DashboardPolicies.AnyStaff)]

<PageHeader Title="Teambereich"
            Lead="Offene Tickets im Blick behalten, Bewerbungen sichten und entscheiden."/>

<Panel Title="Tickets">
    <ul class="nav-links">
        <li><a href="/teamarea/tickets">Offene Tickets</a></li>
    </ul>
</Panel>

<Panel Title="Bewerbungen">
    <ul class="nav-links">
        <li><a href="/teamarea/applysystem/applications">Bewerbungen sichten</a></li>
        @* Gated on the real matrix permission: a role list would hide it from people who
           were granted it, or show it to people who then hit a permission wall. *@
        @if (mayConfigure)
        {
            <li><a href="/konfiguration/applysystem/positions">Bewerbungssystem konfigurieren</a></li>
        }
    </ul>
</Panel>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool mayConfigure;

    protected override async Task OnInitializedAsync()
    {
        var principal = AuthState is null ? null : (await AuthState).User;
        var userId = UserService.GetUserId(principal) ?? 0;

        mayConfigure = await TeamApplicationPermissionService.HasAsync(userId,
            TeamApplicationPermission.ManageQuestions);
    }
}
