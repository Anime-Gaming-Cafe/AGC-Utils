@page "/Leaderboard"
@using AGC_Management.Entities.Web
@using AGC_Management.Utils
@attribute [Authorize(Policy = DashboardPolicies.AnyMember)]

<PageHeader Title="Leaderboard"
            Lead="@(LevelUtils.LeaderboardDataLoaded ? $"Stand: {LevelUtils.CacheDate}" : null)"/>

@if (!LevelUtils.LeaderboardDataLoaded)
{
    @* This used to render as a red error box, although nothing had gone wrong. *@
    <StateBlock Kind="StateBlock.StateKind.Loading"
                Title="Leaderboard wird aufgebaut"
                Description="Der Bot berechnet die Rangliste gerade neu. Nach einem Neustart dauert das meist nur einen Moment."
                ActionText="Erneut prüfen"
                OnAction="Reload"/>
}
else if (totalItems == 0)
{
    <StateBlock Title="Noch niemand auf dem Leaderboard"
                Description="Sobald Mitglieder mit Nachrichten oder Voice-Zeit XP sammeln, erscheinen sie hier."/>
}
else
{
    @if (Self is { } self)
    {
        <Panel Title="Dein Platz" Flush="true">
            <ul class="rows">
                <li class="is-self">
                    <span class="rank @(self.Rank <= 3 ? "rank--top" : null)">
                        @if (MedalSrc(self.Rank) is { } selfMedal)
                        {
                            <img class="rank__medal" src="@selfMedal" alt="@($"Platz {self.Rank}")"/>
                        }
                        else
                        {
                            @self.Rank
                        }
                    </span>
                    <img class="avatar avatar--md" src="@self.Avatar" alt=""/>
                    <div class="rows__main">
                        <p class="rows__title">@self.Username</p>
                    </div>
                    <div class="rows__side tnum">
                        <span>Level @self.Level</span>
                        <span class="meta">@self.Experience XP</span>
                    </div>
                </li>
            </ul>
        </Panel>
    }

    <Panel Flush="true" Class="mt-3">
        <ol class="rows">
            @foreach (var item in currentPageData)
            {
                <li class="@(item.UserId == SelfId ? "is-self" : null)">
                    @* Rank 1 to 3 used remote medal images from an external host; these are self-hosted now. *@
                    <span class="rank @(item.Rank <= 3 ? "rank--top" : null)">
                        @if (MedalSrc(item.Rank) is { } medal)
                        {
                            <img class="rank__medal" src="@medal" alt="@($"Platz {item.Rank}")"/>
                        }
                        else
                        {
                            @item.Rank
                        }
                    </span>
                    <img class="avatar avatar--md" loading="lazy" src="@item.Avatar" alt=""/>
                    <div class="rows__main">
                        <p class="rows__title">@item.Username</p>
                    </div>
                    <div class="rows__side tnum">
                        <span>Level @item.Level</span>
                        <span class="meta">@item.Experience XP</span>
                    </div>
                </li>
            }
        </ol>
    </Panel>

    <Pager Current="currentPage" CurrentChanged="GoToPage" TotalPages="TotalPages" TotalItems="totalItems"/>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private ClaimsPrincipal? _principal;

    private List<WebLeaderboardData> currentPageData = new();
    private const int ItemsPerPage = 25;
    private int currentPage = 1;
    private int totalItems;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)totalItems / ItemsPerPage));

    private ulong? SelfId => ToolSet.GetUserIdFromPrincipal(_principal);

    private WebLeaderboardData? Self => LevelUtils.cachedLeaderboardData.FirstOrDefault(i => i.UserId == SelfId);

    private static string? MedalSrc(int rank) => rank switch
    {
        1 => "img/medaille-gold.png",
        2 => "img/medaille-silber.png",
        3 => "img/medaille-bronze.png",
        _ => null
    };

    protected override async Task OnInitializedAsync()
    {
        _principal = AuthState is null ? null : (await AuthState).User;
        LoadPage(currentPage);
    }

    private void LoadPage(int page)
    {
        var data = LevelUtils.cachedLeaderboardData;
        totalItems = data.Count;

        var start = Math.Clamp((page - 1) * ItemsPerPage, 0, totalItems);
        var count = Math.Min(ItemsPerPage, totalItems - start);
        currentPageData = data.GetRange(start, count);
    }

    private void GoToPage(int page)
    {
        currentPage = page;
        LoadPage(page);
    }

    private void Reload() => LoadPage(currentPage);
}
