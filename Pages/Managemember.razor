@page "/managemember"
@using AGC_Management.Utils
@using Microsoft.AspNetCore.WebUtilities
@attribute [Authorize(Roles = "BotOwner, Administrator, HeadModerator, Moderator, Supporter")]
@inject NavigationManager Nav

<PageHeader Title="@(member != null ? ToolSet.GetFormattedName(member) : "Mitglied")"
            BackHref="/mitglieder" BackText="Mitglieder"/>

@if (member == null)
{
    @* The old page silently redirected to the start page here, so a wrong ID looked like a broken link. *@
    <StateBlock Kind="StateBlock.StateKind.Error"
                Title="Mitglied nicht gefunden"
                Description="Unter dieser ID ist kein Mitglied des Servers bekannt. Vielleicht hat es den Server verlassen."
                ActionText="Zur Mitgliederliste"
                ActionHref="/mitglieder"/>
}
else
{
    <Panel Title="Nutzerinformationen">
        <dl class="facts">
            <dt>Nutzername</dt>
            <dd>@member.Username</dd>
            <dt>Nickname</dt>
            <dd>@(string.IsNullOrWhiteSpace(member.Nickname) ? "keiner" : member.Nickname)</dd>
            <dt>User-ID</dt>
            <dd class="mono">@member.Id</dd>
            <dt>Beigetreten</dt>
            <dd class="tnum">@member.JoinedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd>
            <dt>Account erstellt</dt>
            <dd class="tnum">@member.CreationTimestamp.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd>
        </dl>
    </Panel>
}

@code {
    private DiscordMember? member;

    protected override void OnInitialized()
    {
        var uri = new Uri(Nav.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("userid", out var raw) &&
            ulong.TryParse(raw, out var id))
            CurrentApplication.TargetGuild.Members.TryGetValue(id, out member);
    }
}
