@page "/benutzereinstellungen/"
@using AGC_Management.Controller
@using AGC_Management.Utils
@inject UserService UserService
@attribute [Authorize(Roles = "BotOwner, Administrator, HeadModerator, Moderator, Supporter, HeadEventmanager, Team, User")]

<PageHeader Title="Einstellungen"/>

@if (!loaded)
{
    <StateBlock Kind="StateBlock.StateKind.Loading"
                Title="Einstellungen werden geladen"
                Description="Deine Levelsystem-Einstellungen werden abgefragt."/>
}
else
{
    <Panel Title="Levelsystem">
        @* This was a button with a status badge inside it. It is a setting, so it is a switch. *@
        <div class="form-check form-switch field">
            <input class="form-check-input" type="checkbox" role="switch" id="levelupPing"
                   checked="@pingActive" disabled="@saving" @onchange="TogglePing"/>
            <label class="form-check-label" for="levelupPing">Bei einem Levelaufstieg anpingen</label>
            <span class="field__hint">
                @(pingActive
                    ? "Der Bot erwähnt dich in der Levelup-Nachricht."
                    : "Die Levelup-Nachricht erscheint ohne Erwähnung.")
            </span>
        </div>

        <ul class="nav-links">
            <li><a href="/benutzereinstellungen/levelsystem/adjustrankcard">Rangkarte anpassen</a></li>
        </ul>
    </Panel>
}

@code
{
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private ClaimsPrincipal? _principal;

    private bool loaded;
    private bool saving;
    private bool pingActive;

    private ulong GetUserId() => UserService.GetUserId(_principal) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        _principal = AuthState is null ? null : (await AuthState).User;

        pingActive = await LevelUtils.IsLevelUpPingEnabled(GetUserId());
        loaded = true;
    }

    private async Task TogglePing()
    {
        saving = true;
        try
        {
            pingActive = await LevelUtils.ToggleLevelUpPing(GetUserId());
        }
        finally
        {
            saving = false;
        }
    }
}
