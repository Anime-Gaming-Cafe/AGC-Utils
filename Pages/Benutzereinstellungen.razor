@page "/benutzereinstellungen/"
@using AGC_Management.Controller
@using AGC_Management.Services
@using AGC_Management.Utils
@using DisCatSharp.Enums
@inject UserService UserService
@attribute [Authorize(Policy = DashboardPolicies.AnyMember)]

<PageHeader Title="Einstellungen"/>

@if (!loaded)
{
    <StateBlock Kind="StateBlock.StateKind.Loading"
                Title="Einstellungen werden geladen"
                Description="Deine Levelsystem-Einstellungen werden abgefragt."/>
}
else
{
    <Panel Title="Levelsystem">
        @* This was a button with a status badge inside it. It is a setting, so it is a switch. *@
        <div class="form-check form-switch field">
            <input class="form-check-input" type="checkbox" role="switch" id="levelupPing"
                   checked="@pingActive" disabled="@saving" @onchange="TogglePing"/>
            <label class="form-check-label" for="levelupPing">Bei einem Levelaufstieg anpingen</label>
            <span class="field__hint">
                @(pingActive
                    ? "Der Bot erwähnt dich in der Levelup-Nachricht."
                    : "Die Levelup-Nachricht erscheint ohne Erwähnung.")
            </span>
        </div>

        <div class="field">
            <p class="field__label">Rangkarte</p>
            <span class="field__hint">Farbe, Deckkraft, Schrift und Hintergrund deiner Karte beim Rang-Befehl.</span>
            <a class="btn btn-secondary btn-sm mt-2" href="/benutzereinstellungen/levelsystem/adjustrankcard">Rangkarte anpassen</a>
        </div>
    </Panel>

    @if (autoDetectAvailable)
    {
        <Panel Title="Selfroles">
            <div class="form-check form-switch field">
                <input class="form-check-input" type="checkbox" role="switch" id="selfroleAutoDetect"
                       checked="@autoDetectActive" disabled="@saving" @onchange="ToggleAutoDetect"/>
                <label class="form-check-label" for="selfroleAutoDetect">Rollen nach gespielten Spielen vergeben</label>
                <span class="field__hint">
                    @(autoDetectActive
                        ? "Spielst du etwas, für das es eine Rolle gibt, bekommst du sie einmalig. Entfernte Rollen kommen nicht zurück."
                        : "Es werden dir keine Rollen mehr automatisch gegeben. Bereits vergebene behältst du.")
                </span>
            </div>
        </Panel>
    }
}

@code
{
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private ClaimsPrincipal? _principal;

    private bool loaded;
    private bool saving;
    private bool pingActive;
    private bool autoDetectAvailable;
    private bool autoDetectActive;

    private ulong GetUserId() => UserService.GetUserId(_principal) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        _principal = AuthState is null ? null : (await AuthState).User;

        pingActive = await LevelUtils.IsLevelUpPingEnabled(GetUserId());

        autoDetectAvailable = CurrentApplication.DiscordClient.Intents.HasIntent(DiscordIntents.GuildPresences) &&
                              await SelfroleService.AutoDetectEnabledAsync();
        if (autoDetectAvailable) autoDetectActive = !await SelfroleService.IsOptedOutAsync(GetUserId());

        loaded = true;
    }

    private async Task TogglePing()
    {
        saving = true;
        try
        {
            pingActive = await LevelUtils.ToggleLevelUpPing(GetUserId());
        }
        finally
        {
            saving = false;
        }
    }

    private async Task ToggleAutoDetect()
    {
        saving = true;
        try
        {
            autoDetectActive = !autoDetectActive;
            await SelfroleService.SetOptOutAsync(GetUserId(), !autoDetectActive);
        }
        finally
        {
            saving = false;
        }
    }
}
