@page "/benutzereinstellungen/levelsystem/adjustrankcard"
@using AGC_Management.Controller
@using System.Text.Json
@using AGC_Management.Utils
@using SkiaSharp
@inject UserService UserService
@attribute [Authorize(Roles = "BotOwner, Administrator, HeadModerator, Moderator, Supporter, HeadEventmanager, Team, User")]

<PageHeader Title="Rangkarte"
            Lead="Farbe, Deckkraft, Schrift und Hintergrund deiner Rangkarte."
            BackHref="/benutzereinstellungen" BackText="Einstellungen"/>

@if (!loaded)
{
    <StateBlock Kind="StateBlock.StateKind.Loading"
                Title="Rangkarte wird geladen"
                Description="Deine gespeicherten Einstellungen werden abgefragt."/>
}
else
{
    <div class="editor-grid">
        <div>
            <Panel Title="Einstellungen">
                <div class="field">
                    <label class="field__label" for="rc-color">Balkenfarbe</label>
                    <input type="color" class="form-control form-control-color" id="rc-color" value="@color" @onchange="ColorChanged"/>
                </div>

                <div class="field">
                    <label class="field__label" for="rc-alpha">Deckkraft der Box</label>
                    <input type="range" class="form-range" id="rc-alpha" min="0" max="255" value="@boxalpha" @onchange="BoxAlphaChanged"/>
                    <span class="field__hint tnum">@boxalpha von 255</span>
                </div>

                <div class="field">
                    <label class="field__label" for="rc-font">Schriftart</label>
                    @* The old select carried "bind=" without the @, so it never bound. *@
                    <select class="form-select" id="rc-font" @onchange="FontChanged">
                        @foreach (var fontFamily in fontFamilies)
                        {
                            <option value="@fontFamily" selected="@(font == fontFamily)">@fontFamily</option>
                        }
                    </select>
                </div>

                <div class="field">
                    <label class="field__label" for="rc-image">Hintergrundbild</label>
                    <InputFile id="rc-image" class="form-control" accept="image/png,image/jpeg,image/webp" OnChange="UploadFile"/>
                    <span class="field__hint">Empfohlen 930 × 280 Pixel, höchstens 5 MB. PNG, JPG oder WebP.</span>
                    @if (!string.IsNullOrWhiteSpace(uploadStatus))
                    {
                        <span class="field__hint" role="status">@uploadStatus</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        @* Rendered as text now. It used to go through MarkupString, and it can carry
                           exception messages and reasons returned by the image check API. *@
                        <span class="field__error" role="alert">@errorMessage</span>
                    }
                </div>

                <div class="form-foot">
                    <button type="button" class="btn btn-primary" @onclick="SaveSettings">Speichern und anwenden</button>
                    @if (hasCustomRankCardSettings && !pendingReset)
                    {
                        <button type="button" class="btn btn-danger" @onclick="() => pendingReset = true">Zurücksetzen</button>
                    }
                </div>

                @if (pendingReset)
                {
                    <ConfirmInline Title="Rangkarte zurücksetzen?"
                                   ConfirmText="Ja, zurücksetzen"
                                   OnConfirm="ResetCard"
                                   OnCancel="() => pendingReset = false">
                        <p>Farbe, Schrift, Deckkraft und dein hochgeladenes Hintergrundbild werden gelöscht.</p>
                    </ConfirmInline>
                }
            </Panel>
        </div>

        <div>
            <Panel Title="Vorschau" Lead="Die Karte mit den Einstellungen links, noch nicht gespeichert.">
                @if (previewFailed)
                {
                    <StateBlock Kind="StateBlock.StateKind.Error" Inline="true"
                                Title="Vorschau konnte nicht erzeugt werden"
                                Description="Mit diesen Einstellungen ließ sich keine Karte rendern. Gespeichert ist noch nichts."
                                ActionText="Erneut versuchen"
                                OnAction="CopySettingsToPreview"/>
                }
                else if (!string.IsNullOrWhiteSpace(previewImageData))
                {
                    <img src="@previewImageData" alt="Vorschau der Rangkarte" class="preview-img"/>
                }
                else
                {
                    <StateBlock Kind="StateBlock.StateKind.Loading" Inline="true"
                                Title="Vorschau wird erzeugt"
                                Description="Avatar, Server-Icon und Hintergrund werden geladen und zur Karte gerendert."/>
                }
            </Panel>

            <Panel Title="Aktuelle Karte" Lead="So erscheint deine Rangkarte gerade in Discord.">
                @if (cardFailed)
                {
                    <StateBlock Kind="StateBlock.StateKind.Error" Inline="true"
                                Title="Karte konnte nicht erzeugt werden"
                                Description="Ein Bild für die Karte ließ sich nicht abrufen. Deine Einstellungen sind davon nicht betroffen."
                                ActionText="Erneut versuchen"
                                OnAction="RenderCurrentCard"/>
                }
                else if (!string.IsNullOrWhiteSpace(base64String))
                {
                    <img src="@base64String" alt="Aktuelle Rangkarte" class="preview-img"/>
                }
                else
                {
                    <StateBlock Kind="StateBlock.StateKind.Loading" Inline="true"
                                Title="Karte wird erzeugt"
                                Description="Avatar, Server-Icon und Hintergrund werden geladen und zur Karte gerendert."/>
                }
            </Panel>
        </div>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private ClaimsPrincipal? _principal;

    private bool loaded;
    private bool pendingReset;
    private readonly string[] fontFamilies = SKFontManager.Default.GetFontFamilies();

    private string imageToInstall = "";
    private string base64String = "";
    private bool hasCustomRankCardSettings;
    private string color = "#9f00ff";
    private string font = "Verdana";
    private int boxalpha = 150;
    private bool hasImageChanged;
    private bool hasColorChanged;
    private bool hasFontChanged;
    private bool hasBoxAlphaChanged;
    private string uploadStatus = "";
    private string errorMessage = "";

    private bool cardsRequested;
    private bool cardFailed;
    private bool previewFailed;

    // data for preview
    private string previewImageData = "";
    private string previewImageToInstall = "";
    private int previewBoxAlpha = 150;
    private string previewColor = "#9f00ff";
    private string previewFont = "Verdana";


    private async Task UploadFile(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null)
        {
            uploadStatus = "Keine Datei ausgewählt.";
            return;
        }

        uploadStatus = "Datei wird hochgeladen.";

        if (file.Size > 5242880)
        {
            errorMessage = "Die Datei ist zu groß. Bitte wähle eine Datei, die kleiner als 5MB ist.";
            uploadStatus = "";
            return;
        }

        if (file.ContentType != "image/png" && file.ContentType != "image/jpg" && file.ContentType != "image/jpeg" && file.ContentType != "image/webp")
        {
            errorMessage = "Die Datei hat ein ungültiges Format!";
            uploadStatus = "";
            return;
        }

        var old_data = imageToInstall;
        try
        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(5242880).CopyToAsync(ms);
            imageToInstall = Convert.ToBase64String(ms.ToArray());
            hasImageChanged = true;
            uploadStatus = "Bild erfolgreich hochgeladen.";
            errorMessage = "";
            await CopySettingsToPreview();
        }
        catch (Exception ex)
        {
            imageToInstall = old_data;
            errorMessage = $"Fehler beim Hochladen der Datei: {ex.Message}";
            uploadStatus = "";
        }
    }


    void FontChanged(ChangeEventArgs e)
    {
        font = e.Value.ToString();
        hasFontChanged = true;
        _ = CopySettingsToPreview();
    }

    void BoxAlphaChanged(ChangeEventArgs e)
    {
        boxalpha = int.Parse(e.Value.ToString());
        hasBoxAlphaChanged = true;
        _ = CopySettingsToPreview();
    }

    void ColorChanged(ChangeEventArgs e)
    {
        color = e.Value.ToString();
        hasColorChanged = true;
        _ = CopySettingsToPreview();
    }

    private async Task ResetCard()
    {
        pendingReset = false;
        var userId = ulong.Parse(UserService.GetUserId(_principal).ToString());
        var con = CurrentApplication.ServiceProvider.GetRequiredService<NpgsqlDataSource>();
        await using var cmd = con.CreateCommand();
        cmd.CommandText = @"DELETE FROM userrankcardsettings WHERE userid = @userid";
        cmd.Parameters.AddWithValue("userid", (long)userId);
        await cmd.ExecuteNonQueryAsync();
        await ReloadAsync();
    }

    private async Task SaveSettings()
    {
        var userId = ulong.Parse(UserService.GetUserId(_principal).ToString());
        if (!string.IsNullOrWhiteSpace(imageToInstall) && hasImageChanged)
        {
            bool isActivated = false;
            try
            {
                isActivated = bool.Parse(BotConfig.GetConfig()["LinkLens"]["Active"]);
            }
            catch (Exception)
            {
                // ignored
            }

            if (hasImageChanged)
            {
                try
                {
                    if (isActivated)
                    {
                        uploadStatus = "Bild wird geprüft.";
                        using var client = new HttpClient();
                        var apikey = BotConfig.GetConfig()["LinkLens"]["API-KEY"];
                        client.DefaultRequestHeaders.Add("api-key", apikey);
                        client.DefaultRequestHeaders.Add("User-Agent",
                            "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/100.0.1000.0 Safari/537.36");
                        var content = new StringContent($"{{\"imageBase64\":\"{imageToInstall}\"}}", null, "application/json");
                        var response = await client.PostAsync("https://api.linklens.xyz/analyze-levelcard", content);
                        var responseString = await response.Content.ReadAsStringAsync();
                        var result = JsonSerializer.Deserialize<RootObject>(responseString);
                        if (result?.analysis.summary.reject_reason.Count > 0)
                        {
                            var rejectReasons = "";
                            foreach (var reason in result.analysis.summary.reject_reason)
                            {
                                rejectReasons += reason.text;
                                if (reason != result.analysis.summary.reject_reason.Last())
                                {
                                    rejectReasons += ", ";
                                }
                            }

                            errorMessage = $"Das Bild wurde abgelehnt, da es folgende Gründe hat: {rejectReasons}";
                            uploadStatus = "";
                            await LogRuleViolatingImageUpload(userId, rejectReasons, imageToInstall);
                            return;
                        }

                        uploadStatus = "Bild wurde moderativ geprüft und ist in Ordnung. Bild wird gespeichert...";

                        await Task.Delay(500);
                    }
                }
                catch (Exception ex)
                {
                    errorMessage = $"Fehler beim moderativen prüfen der Datei: {ex.Message}";
                    uploadStatus = "";
                    return;
                }

                await SaveCustomRankCardSetting("imagedata", imageToInstall, userId);
                uploadStatus = "Bild wurde erfolgreich gespeichert.";
                hasImageChanged = false;
            }
        }

        if (hasColorChanged)
        {
            await SaveCustomRankCardSetting("barcolor", color, userId);
        }

        if (hasFontChanged)
        {
            await SaveCustomRankCardSetting("textfont", font, userId);
        }

        if (hasBoxAlphaChanged)
        {
            await SaveCustomRankCardSetting("boxalpha", boxalpha, userId);
        }

        await ReloadAsync();
    }


    public class RejectReason
    {
        public string id { get; set; }
        public string text { get; set; }
    }

    public class Summary
    {
        public string action { get; set; }
        public double reject_prob { get; set; }
        public List<RejectReason> reject_reason { get; set; }
    }

    public class Analysis
    {
        public Summary summary { get; set; }
    }

    public class RootObject
    {
        public Analysis analysis { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        _principal = AuthState is null ? null : (await AuthState).User;

        await RetrieveCurrentSettings();
        loaded = true;
    }

    // Rendering a card downloads avatar, guild icon and background. It waits until the page is
    // interactive, so a slow image host delays the pictures instead of the whole page, and the
    // prerender pass does not pay for it a second time.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!loaded || cardsRequested) return;
        cardsRequested = true;

        await RenderCurrentCard();
        await CopySettingsToPreview();
    }

    private async Task ReloadAsync()
    {
        await RetrieveCurrentSettings();
        await RenderCurrentCard();
        await CopySettingsToPreview();
    }

    private async Task RenderCurrentCard()
    {
        cardFailed = false;
        try
        {
            base64String = await RetrieveRankCardForCurrentUser();
        }
        catch (Exception e)
        {
            CurrentApplication.Logger.Error(e, "Rangkarte für das Dashboard konnte nicht erzeugt werden");
            base64String = "";
            cardFailed = true;
        }

        StateHasChanged();
    }


    private async Task LogRuleViolatingImageUpload(ulong userid, string reason, string imageData)
    {
        var userid_ = (long)userid;
        var unixnow = DateTimeOffset.Now.ToUnixTimeSeconds();
        var con = CurrentApplication.ServiceProvider.GetRequiredService<NpgsqlDataSource>();
        await using var cmd = con.CreateCommand();
        cmd.CommandText = @"INSERT INTO userrankcardunallowedimagelog (userid, blockreason, imagedata, timestamp) VALUES (@userid, @reason, @imagedata, @timestamp)";
        cmd.Parameters.AddWithValue("userid", userid_);
        cmd.Parameters.AddWithValue("reason", reason);
        cmd.Parameters.AddWithValue("imagedata", imageData);
        cmd.Parameters.AddWithValue("timestamp", unixnow);
        await cmd.ExecuteNonQueryAsync();
    }

    private async Task RenderPreview()
    {
        previewFailed = false;
        try
        {
            var currentuserid = UserService.GetUserId(_principal);
            var user = await CurrentApplication.DiscordClient.GetUserAsync(ulong.Parse(currentuserid.ToString()));
            var rank = await LevelUtils.GetRank(user.Id);
            var level = rank[user.Id].Level;
            var totalxp = rank[user.Id].Xp;
            var xpForCurrentLevel = LevelUtils.XpForLevel(level);
            var xpForNextLevel = LevelUtils.XpForLevel(level + 1);
            var xpForThisLevel = xpForNextLevel - xpForCurrentLevel;
            var xpForThisLevelUntilNow = totalxp - xpForCurrentLevel;
            var percentage = (int)(xpForThisLevelUntilNow / (float)xpForThisLevel * 100);
            var userRank = await LevelUtils.GetUserRankAsync(user.Id);
            var imagedata = await ImageUtils.GenerateRankCardForWebPreview(user, xpForThisLevelUntilNow, level,
                userRank, percentage, totalxp, xpForThisLevel, previewBoxAlpha, previewFont, previewImageToInstall,
                previewColor);
            previewImageData = "data:image/png;base64," + Convert.ToBase64String(imagedata.ToArray());
        }
        catch (Exception e)
        {
            previewFailed = true;
            if (hasImageChanged)
            {
                errorMessage = "Mit diesem Bild ließ sich keine Vorschau erzeugen. Die Datei ist vermutlich kein gültiges Bild.";
                uploadStatus = "";
            }
            else
            {
                CurrentApplication.Logger.Error(e, "Vorschau der Rangkarte konnte nicht erzeugt werden");
            }
        }

        StateHasChanged();
    }

    private async Task CopySettingsToPreview()
    {
        previewBoxAlpha = boxalpha;
        previewColor = color;
        previewFont = font;
        previewImageToInstall = imageToInstall;
        await RenderPreview();
    }

    private async Task SaveCustomRankCardSetting(string settingName, string value, ulong userId)
    {
        var con = CurrentApplication.ServiceProvider.GetRequiredService<NpgsqlDataSource>();
        await using var cmd = con.CreateCommand();
        cmd.CommandText = $@"
    INSERT INTO userrankcardsettings (userid, {settingName})
    VALUES (@userid, @value)
    ON CONFLICT (userid)
    DO UPDATE SET {settingName} = @value";
        cmd.Parameters.AddWithValue("value", value);
        cmd.Parameters.AddWithValue("userid", (long)userId);
        await cmd.ExecuteNonQueryAsync();
    }

    private async Task SaveCustomRankCardSetting(string settingName, int value, ulong userId)
    {
        var con = CurrentApplication.ServiceProvider.GetRequiredService<NpgsqlDataSource>();
        await using var cmd = con.CreateCommand();
        cmd.CommandText = $@"
    INSERT INTO userrankcardsettings (userid, {settingName})
    VALUES (@userid, @value)
    ON CONFLICT (userid)
    DO UPDATE SET {settingName} = @value";
        cmd.Parameters.AddWithValue("value", value);
        cmd.Parameters.AddWithValue("userid", (long)userId);
        await cmd.ExecuteNonQueryAsync();
    }

    private async Task<string> RetrieveRankCardForCurrentUser()
    {
        var currentuserid = UserService.GetUserId(_principal);
        var user = await CurrentApplication.DiscordClient.GetUserAsync(ulong.Parse(currentuserid.ToString()));
        var rank = await LevelUtils.GetRank(user.Id);
        var level = rank[user.Id].Level;
        var totalxp = rank[user.Id].Xp;
        var xpForCurrentLevel = LevelUtils.XpForLevel(level);
        var xpForNextLevel = LevelUtils.XpForLevel(level + 1);
        var xpForThisLevel = xpForNextLevel - xpForCurrentLevel;
        var xpForThisLevelUntilNow = totalxp - xpForCurrentLevel;
        var percentage = (int)(xpForThisLevelUntilNow / (float)xpForThisLevel * 100);
        var userRank = await LevelUtils.GetUserRankAsync(user.Id);
        var imagedata = await ImageUtils.GenerateRankCard(user, xpForThisLevelUntilNow, level, userRank, percentage,
            totalxp,
            xpForThisLevel);
        var imgstream = imagedata.AsStream();
        byte[] bytes = new byte[imgstream.Length];
        imgstream.Read(bytes, 0, (int)imgstream.Length);
        return "data:image/png;base64," + Convert.ToBase64String(bytes);
    }

    private async Task RetrieveCurrentSettings()
    {
        var userId = ulong.Parse(UserService.GetUserId(_principal).ToString());

        // ImageUtils.GetCustomRankCardSettings also downloads the fallback background, which the editor
        // does not need, so the three values are read directly.
        var con = CurrentApplication.ServiceProvider.GetRequiredService<NpgsqlDataSource>();
        await using var cmd = con.CreateCommand(
            "SELECT barcolor, textfont, boxalpha FROM userrankcardsettings WHERE userid = @userid");
        cmd.Parameters.AddWithValue("userid", (long)userId);
        await using var reader = await cmd.ExecuteReaderAsync();

        hasCustomRankCardSettings = await reader.ReadAsync();
        if (hasCustomRankCardSettings)
        {
            color = reader.IsDBNull(0) ? "#000000" : reader.GetString(0);
            font = reader.IsDBNull(1) ? "Verdana" : reader.GetString(1);
            boxalpha = reader.IsDBNull(2) ? 100 : reader.GetInt32(2);
            return;
        }

        // After a reset the editor has to show the defaults again, not the deleted values.
        color = "#9f00ff";
        font = "Verdana";
        boxalpha = 150;
        imageToInstall = "";
        hasImageChanged = false;
    }

}
