@page "/teamarea/applysystem/application/{ApplicationId}"
@using AGC_Management.Controller
@using AGC_Management.Entities.ApplicationSystem
@using AGC_Management.Enums.ApplicationSystem
@using AGC_Management.Services
@using AGC_Management.Utils
@inject UserService UserService
@attribute [Authorize(Roles = "BotOwner, Administrator, HeadModerator, Moderator, Supporter, HeadEventmanager, Team")]

<a class="btn btn-secondary-glass mt-2 mb-3" href="/teamarea/applysystem/applications">Zurück zur Übersicht</a>

@if (!loaded)
{
    <div class="spinner-border" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
}
else if (application == null)
{
    <div class="alert alert-danger-glass" role="alert">Diese Bewerbung wurde nicht gefunden.</div>
}
else if (!perms.ViewApplications)
{
    <div class="alert alert-danger-glass" role="alert">
        Du hast keine Berechtigung, Bewerbungen für diese Position einzusehen.
    </div>
}
else
{
    <h1>@ToolSet.GetFormattedName(application.UserId)</h1>

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert alert-info-glass" role="alert">@statusMessage</div>
    }

    @if (application.IsWithdrawn)
    {
        <div class="alert alert-warning-glass" role="alert">
            <strong>Zurückgezogen</strong> am
            @ToolSet.GetFormattedTimeFromUnixAndRespectTimeZone(application.WithdrawnAt)
        </div>
    }

    @if (application.DmDelivered == false)
    {
        <div class="alert alert-danger-glass" role="alert">
            <strong>Entscheidung nicht zustellbar</strong>
            @if (!string.IsNullOrWhiteSpace(application.DmError))
            {
                <span> (@application.DmError)</span>
            }
        </div>
    }

    <!-- Kopfbereich: Snapshot bei Abgabe neben dem Live-Wert -->
    <div class="glass-card mt-3 p-3">
        <h3>Bewerber</h3>
        <p class="text-muted">
            @application.PositionName &middot; @application.PhaseName &middot;
            Eingereicht am @ToolSet.GetFormattedTimeFromUnixAndRespectTimeZone(application.SubmittedAt)
            @if (application.Attempt > 1)
            {
                <span> &middot; Versuch @application.Attempt</span>
            }
        </p>

        <div class="row g-3">
            <div class="col-12 col-md-6">
                <div class="glass-effect-bg p-3">
                    <h5>Bei Abgabe</h5>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">Level: <strong>@application.LevelSnapshot</strong></li>
                        <li class="list-group-item">XP: <strong>@application.XpSnapshot</strong></li>
                        <li class="list-group-item">Beigetreten: <strong>@Time(application.JoinedAtSnapshot)</strong></li>
                        <li class="list-group-item">Account erstellt: <strong>@Time(application.AccountCreatedSnapshot)</strong></li>
                    </ul>
                </div>
            </div>
            <div class="col-12 col-md-6">
                <div class="glass-effect-bg p-3">
                    <h5>Aktuell</h5>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">Level: <strong>@liveLevel</strong></li>
                        <li class="list-group-item">XP: <strong>@liveXp</strong></li>
                        <li class="list-group-item">Beigetreten: <strong>@Time(liveJoinedAt)</strong></li>
                        <li class="list-group-item">Account erstellt: <strong>@Time(liveCreatedAt)</strong></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Aktivitaet -->
    <div class="glass-card mt-3 p-3">
        <h3>Aktivität</h3>
        @if (activity == null)
        {
            <div class="spinner-border spinner-border-sm" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        }
        else
        {
            <div class="row row-cols-2 row-cols-md-3 g-2">
                <div class="col"><div class="glass-effect-bg p-2"><small>Nachrichten 7 Tage</small><div><strong>@activity.Messages7</strong></div></div></div>
                <div class="col"><div class="glass-effect-bg p-2"><small>Nachrichten 30 Tage</small><div><strong>@activity.Messages30</strong></div></div></div>
                <div class="col"><div class="glass-effect-bg p-2"><small>Nachrichten 90 Tage</small><div><strong>@activity.Messages90</strong></div></div></div>
                <div class="col"><div class="glass-effect-bg p-2"><small>Voice-Minuten 7 Tage</small><div><strong>@activity.VoiceMinutes7</strong></div></div></div>
                <div class="col"><div class="glass-effect-bg p-2"><small>Voice-Minuten 30 Tage</small><div><strong>@activity.VoiceMinutes30</strong></div></div></div>
                <div class="col"><div class="glass-effect-bg p-2"><small>Voice-Minuten 90 Tage</small><div><strong>@activity.VoiceMinutes90</strong></div></div></div>
            </div>
        }
    </div>

    <!-- Antworten -->
    <div class="glass-card mt-3 p-3">
        <h3>Antworten</h3>
        <ul class="list-group list-group-flush">
            @foreach (var answer in answers)
            {
                <li class="list-group-item">
                    <strong>@answer.QuestionTextSnapshot</strong>
                    <p class="mb-0 mt-1" style="white-space: pre-wrap; word-break: break-word;">@Render(answer)</p>
                </li>
            }
        </ul>
    </div>

    @if (perms.ViewModerationHistory)
    {
        <div class="glass-card mt-3 p-3">
            <h3>Moderationshistorie</h3>
            @if (moderation == null)
            {
                <div class="spinner-border spinner-border-sm" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            }
            else if (moderation.Count == 0)
            {
                <p class="mb-0 text-muted">Keine Einträge.</p>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var entry in moderation)
                    {
                        <li class="list-group-item">
                            <span class="badge-danger-glass">@entry.Kind</span>
                            @if (!string.IsNullOrWhiteSpace(entry.CaseId))
                            {
                                <code class="ms-2">@entry.CaseId</code>
                            }
                            <div class="mt-1">@entry.Description</div>
                            <small class="text-muted">@Time(entry.Timestamp)</small>
                        </li>
                    }
                </ul>
            }
        </div>
    }

    @if (perms.Notes)
    {
        <div class="glass-card mt-3 p-3">
            <h3>Interne Notizen</h3>
            <p class="text-muted">Nur für das Team sichtbar, niemals für den Bewerber.</p>

            @if (notes.Count == 0)
            {
                <p class="text-muted">Noch keine Notizen.</p>
            }
            else
            {
                <ul class="list-group list-group-flush mb-3">
                    @foreach (var note in notes)
                    {
                        <li class="list-group-item">
                            <div style="white-space: pre-wrap;">@note.Text</div>
                            <small class="text-muted">
                                @ToolSet.GetFormattedName(note.AuthorId) &middot; @Time(note.CreatedAt)
                            </small>
                        </li>
                    }
                </ul>
            }

            <textarea class="form-control glassy-input" rows="3" placeholder="Notiz hinzufügen"
                      @bind="newNote"></textarea>
            <button class="btn btn-primary-glass mt-2" @onclick="AddNote">Notiz speichern</button>
        </div>
    }

    @if (perms.MarkInternal && application.IsOpen)
    {
        <div class="glass-card mt-3 p-3">
            <h3>Interne Markierung</h3>
            <p class="text-muted">Löst keine Benachrichtigung an den Bewerber aus.</p>
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-secondary-glass" @onclick="() => Mark(TeamApplicationStatus.Gelesen)">
                    Gelesen
                </button>
                <button class="btn btn-warning-glass" @onclick="() => Mark(TeamApplicationStatus.Vorgemerkt)">
                    Vorgemerkt
                </button>
                <button class="btn btn-info-glass" @onclick="() => Mark(TeamApplicationStatus.WartetAufRueckfrage)">
                    Wartet auf Rückfrage
                </button>
            </div>
        </div>
    }

    @if (perms.Decide && application.IsOpen)
    {
        <div class="glass-card mt-3 p-3">
            <h3>Entscheiden</h3>

            @if (!decideOpen)
            {
                <button class="btn btn-primary-glass" @onclick="() => decideOpen = true">Entscheidung treffen</button>
            }
            else
            {
                <div class="mb-3">
                    <label class="form-label">Vorlage</label>
                    <select class="form-select glassy-input" @onchange="ApplyTemplate">
                        <option value="">-- keine Vorlage --</option>
                        @foreach (var template in templates)
                        {
                            <option value="@template.TemplateId">
                                @(template.Kind == TeamApplicationTemplateKind.Accept ? "Zusage" : "Absage"): @template.Name
                            </option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Text an den Bewerber</label>
                    <textarea class="form-control glassy-input" rows="6" @bind="decisionText"></textarea>
                    <small class="text-muted">Bei einer Absage ist eine Begründung Pflicht.</small>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <button class="btn btn-success-glass" disabled="@deciding"
                            @onclick="() => Decide(TeamApplicationStatus.Angenommen)">Annehmen</button>
                    <button class="btn btn-danger-glass" disabled="@deciding"
                            @onclick="() => Decide(TeamApplicationStatus.Abgelehnt)">Ablehnen</button>
                    <button class="btn btn-secondary-glass" @onclick="() => decideOpen = false">Abbrechen</button>
                </div>
            }
        </div>
    }

    @if (perms.GrantReapply)
    {
        <div class="glass-card mt-3 p-3">
            <h3>Sofort-Wiederbewerbung</h3>
            @if (activeGrant != null)
            {
                <div class="alert alert-info-glass" role="alert">
                    Für diesen Nutzer ist in dieser Phase bereits eine erneute Bewerbung freigeschaltet.
                </div>
            }
            else
            {
                <p class="text-muted">
                    Erlaubt dem Bewerber, sich innerhalb der laufenden Phase noch einmal zu bewerben. Verfällt
                    beim Einlösen oder mit der Phase.
                </p>
                <textarea class="form-control glassy-input" rows="2" placeholder="Begründung (optional, geht per DM raus)"
                          @bind="grantReason"></textarea>
                <button class="btn btn-primary-glass mt-2" @onclick="GrantReapply">Erneute Bewerbung erlauben</button>
            }
        </div>
    }

    @if (application.IsDecided)
    {
        <div class="glass-card mt-3 mb-5 p-3">
            <h3>Entscheidung</h3>
            <p class="mb-1">
                <strong>@(application.Status == TeamApplicationStatus.Angenommen ? "Angenommen" : "Abgelehnt")</strong>
                von @ToolSet.GetFormattedName(application.DecidedBy) am @Time(application.DecidedAt)
            </p>
            @if (!string.IsNullOrWhiteSpace(application.DecisionText))
            {
                <p class="mb-0" style="white-space: pre-wrap;">@application.DecisionText</p>
            }
        </div>
    }
}

@code {
    [Parameter] public string ApplicationId { get; set; } = "";

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private ClaimsPrincipal? _principal;
    private ulong userId;

    private bool loaded;
    private string statusMessage = "";

    private TeamApplication? application;
    private TeamApplicationPermissionSet perms = new();
    private List<TeamApplicationAnswer> answers = new();
    private List<TeamApplicationNote> notes = new();
    private List<TeamApplicationTemplate> templates = new();
    private TeamApplicationReapplyGrant? activeGrant;
    private TeamApplicationActivity? activity;
    private List<ModerationEntry>? moderation;

    private int liveLevel;
    private int liveXp;
    private long liveJoinedAt;
    private long liveCreatedAt;

    private string newNote = "";
    private string decisionText = "";
    private string grantReason = "";
    private bool decideOpen;
    private bool deciding;

    protected override async Task OnInitializedAsync()
    {
        _principal = AuthState is null ? null : (await AuthState).User;
        userId = UserService.GetUserId(_principal) ?? 0;

        application = await TeamApplicationService.GetApplicationAsync(ApplicationId);
        if (application == null)
        {
            loaded = true;
            return;
        }

        perms = await TeamApplicationPermissionService.GetForAsync(userId, application.PositionId,
            application.PhaseId);
        if (perms.ViewApplications) await LoadCore();

        loaded = true;
    }

    /// <summary>
    ///     The six activity aggregates and the moderation history are pulled after the first render so the
    ///     page itself never waits on them.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || application == null || !perms.ViewApplications) return;

        activity = await TeamApplicationService.GetActivityAsync(application.UserId);
        if (perms.ViewModerationHistory) moderation = await LoadModerationAsync(application.UserId);

        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadCore()
    {
        if (application == null) return;

        answers = await TeamApplicationService.GetAnswersAsync(ApplicationId);
        if (perms.Notes) notes = await TeamApplicationService.GetNotesAsync(ApplicationId);
        if (perms.Decide) templates = await TeamApplicationService.GetTemplatesAsync(application.PositionId);
        if (perms.GrantReapply)
            activeGrant = await TeamApplicationService.GetUnusedGrantAsync(application.UserId,
                application.PositionId, application.PhaseId);

        liveLevel = await LevelUtils.GetLevel(application.UserId);
        liveXp = await LevelUtils.GetXp(application.UserId);

        if (CurrentApplication.TargetGuild.Members.TryGetValue(application.UserId, out var member))
        {
            liveJoinedAt = member.JoinedAt.ToUnixTimeSeconds();
            liveCreatedAt = member.CreationTimestamp.ToUnixTimeSeconds();
        }

        await TeamApplicationService.MarkSeenAsync(ApplicationId, userId);
    }

    private static string Time(long unix) =>
        unix <= 0 ? "Unbekannt" : ToolSet.GetFormattedTimeFromUnixAndRespectTimeZone(unix);

    private static string Render(TeamApplicationAnswer answer) =>
        answer.QuestionType == TeamApplicationQuestionType.MultipleChoice
            ? string.Join(", ", answer.AnswerOptions)
            : answer.Answer;

    private async Task<List<ModerationEntry>> LoadModerationAsync(ulong targetId)
    {
        var entries = new List<ModerationEntry>();

        foreach (var (table, label) in new[] { ("warns", "Verwarnung"), ("flags", "Flag") })
        {
            var rows = await DatabaseService.SelectDataFromTable(table, ["*"],
                new Dictionary<string, object> { { "userid", (long)targetId } });

            entries.AddRange(rows.Select(row => new ModerationEntry
            {
                Kind = label,
                CaseId = row.TryGetValue("caseid", out var caseId) ? caseId?.ToString() ?? "" : "",
                Description = row.TryGetValue("description", out var description)
                    ? description?.ToString() ?? ""
                    : "",
                Timestamp = row.TryGetValue("datum", out var datum) && long.TryParse(datum?.ToString(), out var d)
                    ? d
                    : 0
            }));
        }

        var bans = await DatabaseService.SelectDataFromTable("banlogs", ["*"],
            new Dictionary<string, object> { { "userid", (long)targetId } });
        entries.AddRange(bans.Select(row => new ModerationEntry
        {
            Kind = "Ban",
            CaseId = "",
            Description = row.TryGetValue("reason", out var reason) ? reason?.ToString() ?? "" : "",
            Timestamp = row.TryGetValue("timestamp", out var ts) && long.TryParse(ts?.ToString(), out var t) ? t : 0
        }));

        return entries.OrderByDescending(e => e.Timestamp).ToList();
    }

    private async Task<bool> Ensure(TeamApplicationPermission permission)
    {
        if (application != null && await TeamApplicationPermissionService.HasAsync(userId, permission,
                application.PositionId, application.PhaseId)) return true;

        statusMessage = "Keine Berechtigung.";
        return false;
    }

    private async Task Mark(TeamApplicationStatus status)
    {
        if (application == null || !await Ensure(TeamApplicationPermission.MarkInternal)) return;

        await TeamApplicationService.SetStatusAsync(ApplicationId, status);
        application.Status = status;
        statusMessage = "Markierung gesetzt. Der Bewerber wurde nicht benachrichtigt.";
    }

    private async Task AddNote()
    {
        if (!await Ensure(TeamApplicationPermission.Notes)) return;

        if (string.IsNullOrWhiteSpace(newNote))
        {
            statusMessage = "Die Notiz ist leer.";
            return;
        }

        await TeamApplicationService.AddNoteAsync(ApplicationId, userId, newNote.Trim());
        newNote = "";
        notes = await TeamApplicationService.GetNotesAsync(ApplicationId);
        statusMessage = "Notiz gespeichert.";
    }

    private void ApplyTemplate(ChangeEventArgs e)
    {
        var id = e.Value?.ToString();
        var template = templates.FirstOrDefault(t => t.TemplateId == id);
        if (template != null) decisionText = template.Text;
    }

    private async Task Decide(TeamApplicationStatus status)
    {
        if (application == null || deciding || !await Ensure(TeamApplicationPermission.Decide)) return;

        if (status == TeamApplicationStatus.Abgelehnt && string.IsNullOrWhiteSpace(decisionText))
        {
            statusMessage = "Bei einer Absage ist eine Begründung Pflicht.";
            return;
        }

        deciding = true;
        try
        {
            var text = decisionText.Trim();
            await TeamApplicationService.DecideAsync(ApplicationId, status, userId, text);

            application.Status = status;
            application.DecisionText = text;
            application.DecidedBy = userId;
            application.DecidedAt = DateTimeOffset.UtcNow.ToUnixTimeSeconds();

            await TeamApplicationNotificationService.SendDecisionAsync(application, text, userId);

            application = await TeamApplicationService.GetApplicationAsync(ApplicationId);
            decideOpen = false;
            statusMessage = application?.DmDelivered == false
                ? "Entscheidung gespeichert, die DM konnte aber nicht zugestellt werden."
                : "Entscheidung gespeichert und dem Bewerber zugestellt.";
        }
        catch (Exception e)
        {
            CurrentApplication.Logger.Error(e, "TeamApplications: Entscheidung fehlgeschlagen");
            statusMessage = "Die Entscheidung konnte nicht gespeichert werden.";
        }
        finally
        {
            deciding = false;
        }
    }

    private async Task GrantReapply()
    {
        if (application == null || !await Ensure(TeamApplicationPermission.GrantReapply)) return;

        var grant = await TeamApplicationService.GrantReapplyAsync(application.UserId, application.PositionId,
            application.PhaseId, userId, grantReason.Trim());
        activeGrant = grant;
        grantReason = "";

        await TeamApplicationNotificationService.SendGrantAsync(grant, application.PositionName);
        statusMessage = "Erneute Bewerbung freigeschaltet und dem Nutzer per DM mitgeteilt.";
    }

    private sealed class ModerationEntry
    {
        public string Kind { get; init; } = "";
        public string CaseId { get; init; } = "";
        public string Description { get; init; } = "";
        public long Timestamp { get; init; }
    }
}
