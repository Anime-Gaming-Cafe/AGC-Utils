@page "/teamarea/applysystem/legacy/eventapplications"
@using AGC_Management.Entities
@using AGC_Management.Utils
@attribute [Authorize(Roles = "BotOwner, Administrator, HeadModerator, HeadEventmanager")]

<PageHeader Title="Alte Eventteam-Bewerbungen"
            Lead="Altsystem, nur lesend. Status und „Gesehen von“ lassen sich hier nicht mehr ändern."
            BackHref="/teamarea" BackText="Teambereich"/>

@if (loading)
{
    <StateBlock Kind="StateBlock.StateKind.Loading"
                Title="Alte Bewerbungen werden geladen"
                Description="Die Bewerbungen aus dem alten System werden abgefragt."/>
}
else if (applications.Count == 0)
{
    <StateBlock Title="Keine alten Bewerbungen"
                Description="Im alten System liegen keine Bewerbungen. Neue Bewerbungen laufen über das aktuelle System."
                ActionText="Aktuelle Bewerbungen"
                ActionHref="/teamarea/applysystem/applications"/>
}
else
{
    <Panel>
        <div class="field">
            <label class="field__label" for="legacy-search">Suche</label>
            <input id="legacy-search" class="form-control" placeholder="Name oder Nutzer-ID"
                   value="@searchQuery" @oninput="OnSearch"/>
        </div>
    </Panel>

    <div class="mt-3">
        @if (filtered.Count == 0)
        {
            <StateBlock Title="Keine alte Bewerbung passt zur Suche"
                        Description="Weder Name noch Nutzer-ID einer alten Bewerbung enthalten diesen Suchbegriff."
                        ActionText="Suche leeren"
                        OnAction="ClearSearch"/>
        }
        else
        {
            <ul class="record-list">
                @foreach (var application in PageItems)
                {
                    <li class="record @EdgeClass(application.Status)">
                        <a href="/teamarea/applysystem/legacy/eventapplication/@application.BewerbungsId">
                            <p class="record__title">@Name(application.UserId)</p>
                            <div class="record__meta">
                                <span>@application.PositionName</span>
                                <time>@ToolSet.GetFormattedTimeFromUnixAndRespectTimeZone(application.Timestamp)</time>
                                <span class="mono">@application.UserId</span>
                            </div>
                            <div class="record__foot">
                                <StatusPill Text="@StatusLabel(application.Status)" Tone="@StatusTone(application.Status)"/>
                                @if (application.SeenBy.Count > 0)
                                {
                                    <span class="avatar-row">
                                        <span class="meta me-1">Gesehen von</span>
                                        @foreach (var seen in application.SeenBy)
                                        {
                                            <img class="avatar" src="@AvatarUrl(seen)" alt="@Name(seen)" title="@Name(seen)"/>
                                        }
                                    </span>
                                }
                            </div>
                        </a>
                    </li>
                }
            </ul>

            <Pager Current="currentPage" CurrentChanged="p => currentPage = p"
                   TotalPages="TotalPages" TotalItems="filtered.Count"/>
        }
    </div>
}

@code {
    private readonly List<Application> applications = new();
    private List<Application> filtered = new();
    private readonly Dictionary<long, string> names = new();
    private string searchQuery = "";
    private bool loading = true;
    private const int PageSize = 25;
    private int currentPage = 1;

    private IEnumerable<Application> PageItems => filtered.Skip((currentPage - 1) * PageSize).Take(PageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(filtered.Count / (double)PageSize));

    protected override async Task OnInitializedAsync()
    {
        await GetApplications();
        filtered = applications;
        loading = false;
    }

    private string Name(long id)
    {
        if (names.TryGetValue(id, out var name)) return name;

        name = ToolSet.GetFormattedName((ulong)id);
        names[id] = name;
        return name;
    }

    /// <summary>The old search narrowed the list in place, so a second search could only ever find less.</summary>
    private void OnSearch(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
        var term = searchQuery.Trim();

        filtered = term.Length == 0
            ? applications
            : applications.Where(a => a.UserId.ToString().Contains(term) ||
                                      Name(a.UserId).Contains(term, StringComparison.OrdinalIgnoreCase)).ToList();
        currentPage = 1;
    }

    private void ClearSearch()
    {
        searchQuery = "";
        filtered = applications;
        currentPage = 1;
    }

    private static string StatusLabel(int status) => status switch
    {
        1 => "Gelesen",
        2 => "Vorgemerkt",
        3 => "Angenommen",
        4 => "Abgelehnt",
        _ => "Ungelesen"
    };

    private static StatusPill.PillTone StatusTone(int status) => status switch
    {
        3 => StatusPill.PillTone.Ok,
        4 => StatusPill.PillTone.Bad,
        _ => StatusPill.PillTone.Neutral
    };

    private static string EdgeClass(int status) => status switch
    {
        1 => "record--read",
        2 => "record--shortlisted",
        3 => "record--accepted",
        4 => "record--rejected",
        _ => "record--new"
    };

    private static string AvatarUrl(long id)
    {
        var user = CurrentApplication.DiscordClient.UserCache.Values.FirstOrDefault(u => u.Id == (ulong)id);
        return user?.AvatarUrl ?? ToolSet.GetFallbackUser((ulong)id).Avatar;
    }

    private async Task GetApplications()
    {
        var db = CurrentApplication.ServiceProvider.GetRequiredService<NpgsqlDataSource>();
        await using var command = db.CreateCommand(
            "SELECT bewerbungsid, userid, positionname, status, timestamp, bewerbungstext, seenby FROM bewerbungen WHERE positionname = 'Eventmanager' ORDER BY timestamp DESC");
        await using var reader = await command.ExecuteReaderAsync();
        while (await reader.ReadAsync())
        {
            List<long> seenBy;
            try
            {
                seenBy = reader.GetFieldValue<long[]>(6).ToList();
            }
            catch (InvalidCastException)
            {
                seenBy = new List<long>();
            }

            applications.Add(new Application
            {
                BewerbungsId = reader.GetString(0),
                UserId = reader.GetInt64(1),
                PositionName = reader.GetString(2),
                Status = reader.GetInt32(3),
                Timestamp = reader.GetInt64(4),
                Bewerbungstext = reader.GetString(5),
                SeenBy = seenBy
            });
        }
    }
}
