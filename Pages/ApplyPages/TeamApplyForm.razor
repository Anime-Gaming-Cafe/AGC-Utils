@page "/apply/{PositionId}"
@using AGC_Management.Controller
@using AGC_Management.Entities.ApplicationSystem
@using AGC_Management.Enums.ApplicationSystem
@using AGC_Management.Services
@using AGC_Management.Utils
@inject UserService UserService
@inject ToastService ToastService
@attribute [Authorize(Policy = DashboardPolicies.AnyMember)]

<PageHeader Title="@($"Bewerbung: {position?.PositionName ?? PositionId}")"
            BackHref="/apply" BackText="Offene Positionen"/>

@if (!loaded)
{
    <StateBlock Kind="StateBlock.StateKind.Loading"
                Title="Formular wird geladen"
                Description="Position, Bewerbungsphase und Fragen werden abgefragt."/>
}
else if (stage == Stage.NotFound)
{
    <StateBlock Kind="StateBlock.StateKind.Error"
                Title="Position nicht gefunden"
                Description="Diese Position gibt es nicht oder sie ist nicht mehr ausgeschrieben."
                ActionText="Offene Positionen ansehen" ActionHref="/apply"/>
}
else if (stage == Stage.Closed)
{
    <StateBlock Title="@closedText"
                Description="@(nextOpensAt > 0
                    ? $"{opensAtText} {ToolSet.GetFormattedTimeFromUnixAndRespectTimeZone(nextOpensAt)}."
                    : "Sobald eine neue Bewerbungsphase startet, kannst du dich hier bewerben.")"
                ActionText="Offene Positionen ansehen" ActionHref="/apply"/>
}
else if (stage == Stage.LevelGate)
{
    @* Never names a level - neither the required one nor the applicant's own. *@
    <StateBlock Title="Bewerbung noch nicht möglich"
                Description="@levelGateText"
                ActionText="Zurück zur Übersicht" ActionHref="/apply"/>
}
else if (stage == Stage.AlreadyApplied)
{
    <StateBlock Title="Du hast dich bereits beworben"
                Description="In dieser Bewerbungsphase liegt schon eine Bewerbung von dir für diese Position vor."
                ActionText="Meine Bewerbungen" ActionHref="/apply/status"/>
}
else if (stage == Stage.NoQuestions)
{
    <StateBlock Kind="StateBlock.StateKind.Error"
                Title="Formular nicht verfügbar"
                Description="Für diese Position ist aktuell kein Fragenkatalog hinterlegt. Bitte melde dich beim Team."
                ActionText="Offene Positionen ansehen" ActionHref="/apply"/>
}
else if (stage == Stage.Submitted)
{
    <StateBlock Title="Bewerbung abgeschickt"
                Description="Wir haben dir eine Bestätigung per DM geschickt. Den Stand siehst du jederzeit unter Meine Bewerbungen."
                ActionText="Meine Bewerbungen" ActionHref="/apply/status"/>
}
else
{
    @if (opening is { Bypassed: true })
    {
        <div class="notice notice--warn">
            <p class="notice__title">Testmodus aktiv</p>
            <p>
                Für diese Position ist "Bewerbungseinsendung immer erlauben" gesetzt. Phase, Mindestlevel und die
                Regel "eine Bewerbung pro Phase" werden übersprungen.
            </p>
        </div>
    }

    @if (grant != null)
    {
        <div class="notice notice--ok">
            Für dich wurde eine erneute Bewerbung in dieser Phase freigeschaltet.
        </div>
    }

    <Panel Class="mt-3">
        <QuestionAnswerForm @ref="questionForm" Answers="answers"/>

        @if (confirmSubmit)
        {
            <ConfirmInline Title="Bist du sicher, dass du die Bewerbung abschicken möchtest?"
                           ConfirmText="Ja, abschicken" Busy="submitting"
                           OnConfirm="Submit" OnCancel="() => confirmSubmit = false">
                <p>Ich verstehe, dass die Bewerbung nach dem Absenden nicht mehr bearbeitet werden kann.</p>
            </ConfirmInline>
        }
        else
        {
            <div class="form-foot">
                <button type="button" class="btn btn-primary" @onclick="() => confirmSubmit = true">Bewerbung abschicken</button>
            </div>
        }
    </Panel>
}

@code {
    [Parameter] public string PositionId { get; set; } = "";

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private ClaimsPrincipal? _principal;
    private ulong userId;

    private enum Stage
    {
        NotFound,
        Closed,
        LevelGate,
        AlreadyApplied,
        NoQuestions,
        Form,
        Submitted
    }

    private bool loaded;
    private bool submitting;
    private bool confirmSubmit;
    private Stage stage = Stage.NotFound;

    private TeamApplicationPosition? position;
    private TeamApplicationPhase? phase;
    private TeamApplicationOpening? opening;
    private TeamApplicationReapplyGrant? grant;
    private List<QuestionAnswerVm> answers = new();
    private QuestionAnswerForm questionForm = default!;

    private long nextOpensAt;
    private string closedText = "Bewerbungen aktuell geschlossen";
    private string opensAtText = "Naechste Bewerbungsphase ab";
    private string levelGateText = "";

    protected override async Task OnInitializedAsync()
    {
        _principal = AuthState is null ? null : (await AuthState).User;
        userId = UserService.GetUserId(_principal) ?? 0;

        closedText = await TeamApplicationService.GetTextAsync("PanelClosedText", closedText);
        opensAtText = await TeamApplicationService.GetTextAsync("PanelOpensAtText", opensAtText);
        levelGateText = await TeamApplicationService.GetTextAsync("LevelGateText",
            "Bring dich doch gerne etwas mehr in den Server ein, bevor du dich bewirbst.");

        await Prepare();
        loaded = true;
    }

    private async Task Prepare()
    {
        position = await TeamApplicationService.GetPositionAsync(PositionId);
        if (position is not { Active: true })
        {
            stage = Stage.NotFound;
            return;
        }

        opening = await TeamApplicationService.ResolveOpeningAsync(position);
        if (!opening.CanApply || opening.Phase == null)
        {
            nextOpensAt = opening.NextOpensAt;
            stage = Stage.Closed;
            return;
        }

        phase = opening.Phase;

        if (!opening.Bypassed && await LevelUtils.GetLevel(userId) < position.MinLevel)
        {
            stage = Stage.LevelGate;
            return;
        }

        var (allowed, existingGrant, _) =
            await TeamApplicationService.CanApplyAsync(userId, PositionId, phase.PhaseId, opening.Bypassed);
        if (!allowed)
        {
            stage = Stage.AlreadyApplied;
            return;
        }

        grant = existingGrant;

        var questions = await TeamApplicationService.GetQuestionsAsync(PositionId, opening.QuestionSetVersion);
        if (questions.Count == 0)
        {
            stage = Stage.NoQuestions;
            return;
        }

        answers = questions.Select(q => new QuestionAnswerVm { Question = q }).ToList();
        stage = Stage.Form;
    }

    private async Task Submit()
    {
        if (submitting) return;
        submitting = true;

        try
        {
            // Everything is re-checked here; the state the page was rendered with may be minutes old.
            var current = await TeamApplicationService.GetPositionAsync(PositionId);
            if (current is not { Active: true })
            {
                await Prepare();
                return;
            }

            var currentOpening = await TeamApplicationService.ResolveOpeningAsync(current);
            if (!currentOpening.CanApply || currentOpening.Phase == null ||
                currentOpening.Phase.PhaseId != phase?.PhaseId)
            {
                await Prepare();
                return;
            }

            if (!currentOpening.Bypassed && await LevelUtils.GetLevel(userId) < current.MinLevel)
            {
                stage = Stage.LevelGate;
                return;
            }

            var (allowed, currentGrant, nextAttempt) = await TeamApplicationService.CanApplyAsync(userId,
                PositionId, currentOpening.Phase.PhaseId, currentOpening.Bypassed);
            if (!allowed)
            {
                stage = Stage.AlreadyApplied;
                return;
            }

            if (!questionForm.ValidateAll())
            {
                ToastService.Notify("Bitte korrigiere die markierten Antworten.", "bad");
                return;
            }

            await Persist(current, currentOpening, currentGrant, nextAttempt);
        }
        catch (Exception e)
        {
            CurrentApplication.Logger.Error(e, "TeamApplications: Bewerbung konnte nicht gespeichert werden");
            ToastService.Notify("Deine Bewerbung konnte nicht gespeichert werden. Bitte versuche es erneut.", "bad");
        }
        finally
        {
            submitting = false;
        }
    }

    private async Task Persist(TeamApplicationPosition current, TeamApplicationOpening currentOpening,
        TeamApplicationReapplyGrant? currentGrant, int nextAttempt)
    {
        var currentPhase = currentOpening.Phase!;

        var guild = CurrentApplication.TargetGuild;
        guild.Members.TryGetValue(userId, out var member);

        var accountCreated = member?.CreationTimestamp.ToUnixTimeSeconds() ?? 0;
        if (accountCreated == 0)
            try
            {
                var user = await CurrentApplication.DiscordClient.GetUserAsync(userId);
                accountCreated = user.CreationTimestamp.ToUnixTimeSeconds();
            }
            catch (Exception)
            {
                // snapshot stays empty, the detail page shows the live value next to it anyway
            }

        var application = new TeamApplication
        {
            UserId = userId,
            PositionId = current.PositionId,
            PositionName = current.PositionName,
            PhaseId = currentPhase.PhaseId,
            PhaseName = currentPhase.Name,
            QuestionSetVersion = currentOpening.QuestionSetVersion,
            Attempt = nextAttempt,
            LevelSnapshot = await LevelUtils.GetLevel(userId),
            XpSnapshot = await LevelUtils.GetXp(userId),
            JoinedAtSnapshot = member?.JoinedAt.ToUnixTimeSeconds() ?? 0,
            AccountCreatedSnapshot = accountCreated
        };

        var payload = answers.Where(a => QuestionConditionalLogic.IsVisible(a, answers)).Select(a => new TeamApplicationAnswer
        {
            QuestionId = a.Question.QuestionId,
            SortOrder = a.Question.SortOrder,
            QuestionTextSnapshot = a.Question.Text,
            QuestionType = a.Question.Type,
            Answer = a.Question.Type == TeamApplicationQuestionType.MultipleChoice ? "" : a.Text.Trim(),
            AnswerOptions = a.Question.Type == TeamApplicationQuestionType.MultipleChoice ? a.Selected : []
        }).ToList();

        await TeamApplicationService.SubmitAsync(application, payload);
        if (currentGrant != null) await TeamApplicationService.MarkGrantUsedAsync(currentGrant.GrantId);

        stage = Stage.Submitted;

        _ = Task.Run(async () =>
        {
            await TeamApplicationNotificationService.SendSubmitConfirmationAsync(application);
            await TeamApplicationNotificationService.PostNewApplicationAsync(application);
        });
    }
}
